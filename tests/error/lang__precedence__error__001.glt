// lang__precedence__error__001.glt
// expect error ER 0019

int main() {
    output(2 ** 3 ** 2)
    output(" ", -2 ** 2)
    output(" ", 1 | 2 ^ 3)
    output(" ", 1 ^ 3 & 2)
    output(" ", int(1 + 2 < 3 << 1))
    output(" ", 1 & 2 == 2)
    output(" ", 1 << 2 + 3)
    output(" ", 7 % 4 * 2)
    output(" ", 2 ** 3 * 2)
    output(" ", int(2.9) ** 2)
    return 0
}
