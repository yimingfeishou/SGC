// lang__if__error__015.glt
// expect error ER 0143

generics Bad<T> {
    emit "@cond BRANCH = 1\n"
    emit "@if (BRANCH == 1) {\n"
    emit "T selected() {\n"
    emit "    return 1\n"
    emit "}\n"
    emit "} @else {\n"
    emit "T selected() {\n"
    emit "    return 0\n"
    emit "}\n"
    emit "}\n"
}

int main() {
    Bad<int>
    return 0
}