// sl__namespace__error__001.glt
// expect error ER 0027

addition namespace sl {
    @if (is_defined("WINDOWS_PLATFORM")) {
        int winonly = 1
    } @else {
        @if (is_defined("LINUX_PLATFORM")) {
            int linonly = 1
        } @else {
            output("unsupported")
        }
    }

    bool is_digit(char c) {
        if (c < '0') { return false }
        return true
    }
}
int main() {
    output(sl::is_digit('5'), "\n")
    return 0
}
