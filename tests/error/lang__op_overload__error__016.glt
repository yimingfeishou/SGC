// lang__op_overload__error__016.glt
// expect error ER 0152

struct Holder {
    int value
}

Holder operator +(Holder left, Holder right) {
    output("operator")
    Holder result = {left.value + right.value}
    return result
}

const Holder first = {1}
const Holder second = {2}

int main() {
    const Holder result = first + second
    return result.value
}