// lang__generics__error__033.glt
// expect error ER 0001

generics Buffer<T, int N> {
    struct Buffer {
        T data[N]
    }

    int first_size() {
        return size(data)
    }
}

int main() {
    Buffer<int, 3>.Buffer b
    output(size(b.data), " ", Buffer<int, 3>.first_size())
    return 0
}
