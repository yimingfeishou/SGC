// lang__nested__error__001.glt
// expect error ER 0042

generics Blob<T, int N> {
    struct Blob {
        T value
    }
    int tag() {
        return N
    }
}

generics Sized<T, int N> {
    int probe() {
        Blob<int, N>.Blob b
        return b.tag()
    }
}

int main() {
    output(Sized<int, 4>.probe())
    return 0
}
