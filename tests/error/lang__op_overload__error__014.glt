// lang__op_overload__error__014.glt
// expect error ER 0011

struct Num {
    int value
}

Num operator % (Num a, Num b) {
    return Num(a.value % b.value)
}

Num operator ** (Num a, Num b) {
    return Num(a.value ** b.value)
}

int main() {
    Num x = {17}
    Num y = {5}
    output((x % y).value, " ", (Num(2) ** Num(5)).value)
    return 0
}
