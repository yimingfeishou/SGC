// lang__generics__error__048.glt
// expect error ER 0011

generics Box<T> {
    struct Inner {
        int k
        constructor (int v) {
            k = v
        }
    }
    struct Outer {
        Inner inner
    }
}
int main() {
    Box<int>.Outer* o = construct Box<int>.Outer(Box<int>.Inner(7))
    return 0
}
