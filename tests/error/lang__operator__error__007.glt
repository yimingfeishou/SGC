// lang__operator__error__007.glt
// expect error ER 0011

struct Flag {
    bool value
}

Flag operator ! (Flag a) {
    return Flag(!a.value)
}

int operator ~ (Flag a) {
    if (a.value) {
        return 0
    }
    return 1
}

int main() {
    Flag f = {false}
    output((!f).value, " ", ~f)
    return 0
}
