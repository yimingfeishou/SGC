// lang__construct__error__001.glt
// expect error ER 0019

namespace ns
{
    int value = 5
}

struct Point
{
    int x
}

generics Wrap<T>
{
    int zero()
    {
        return 0
    }
}

int twice(int v)
{
    return v * 2
}

int main()
{
    int a = 1
    if (a == 1)
    {
        output("if-ok\n")
    }
    else
    {
        output("else-ok\n")
    }
    output(twice(3), " ", ns::value, "\n")
    return 0
}
