// sl__str_func__error__003.glt
// expect error ER 0101

guide "generics.glt"
access namespace sl

generics Test<T: struct> {
    emit "luint test_offset(T* p) {\n"
    emit "    return offset_generic<T, \"x\">.offset(p)\n"
    emit "}\n"
}

struct S { int x }

int main() {
    Test<S>
    S s
    output(test_offset(&s), "\n")
    return 0
}
