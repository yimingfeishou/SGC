// lang__generics__error__027.glt
// expect error ER 0071

generics Box<T> {
    struct Box {
        T value
    }
    T get(Box b) {
        return b.value
    }
}
generics Box<int> {
    struct Box {
        int value
    }
}
int main() {
    Box<int>.Box b = {1}
    output(Box<int>.get(b))
    return 0
}
