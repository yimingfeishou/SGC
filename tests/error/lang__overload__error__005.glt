// lang__overload__error__005.glt
// expect exit nonzero

struct A {
    int v
}

struct B {
    int v
}

struct Box {
    int x
}

bool is_open(A a) {
    return a.v != 0
}

bool is_open(B b) {
    return b.v != 0
}

int operator << (Box lhs, int rhs) {
    return lhs.x + rhs
}

int main() {
    A a = {1}
    B b = {0}
    if (!is_open(a)) { return 1 }
    if (!is_open(b)) { return 2 }
    return 0
}
