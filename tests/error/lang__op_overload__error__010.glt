// lang__op_overload__error__010.glt
// expect error ER 0120

struct Alpha {
    int value
}

Alpha operator + (Alpha* a, void* b) {
    Alpha r = {a->value}
    return r
}

Alpha operator + (void* a, Alpha* b) {
    Alpha r = {b->value}
    return r
}

int main() {
    Alpha a = {1}
    Alpha* p = &a
    Alpha* q = &a
    Alpha c = p + q
    return 0
}
