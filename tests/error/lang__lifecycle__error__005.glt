// lang__lifecycle__error__005.glt
// expect exit nonzero

// 测试方式：
//   1. 修改下方 @cond A_SCENARIO 的值（1-5）切换场景
//
// 场景清单：
//   1 = 主复现：命名空间内构造引用同命名空间函数        期望通过 / 实际 ER 0009
//   2 = 对照组：同命名空间函数，引用处移出构造          期望通过 / 实际 通过
//   3 = 对照组：构造体内不引用任何函数                  期望通过 / 实际 通过
//   4 = 对照组：构造引用全局函数                        期望通过 / 实际 ER 0009
//   5 = 对照组：换名字（write / Buf），验证非特例       期望通过 / 实际 ER 0009

@cond A_SCENARIO = 2

// ============================================================
// 场景 1：主复现
// 期望：编译通过
// 目前实际：ER 0009: function 'n$helper' is undefined
// ============================================================
@if (A_SCENARIO == 1) {
    namespace n {
        int helper() {
            return 1
        }

        struct S {
            int v

            constructor () {
                v = helper()
            }
        }
    }

    int main() {
        n::S s
        return 0
    }
}


// ============================================================
// 场景 2：对照组 1 —— 引用处移出构造函数
// 差异点：引用 helper 的位置从构造函数体移到 main 函数体
// 期望：编译通过
// 目前实际：通过
// ============================================================
@if (A_SCENARIO == 2) {
    namespace n {
        int helper() {
            return 1
        }

        struct S {
            int v
        }
    }

    int main() {
        n::S s
        int r = n::helper()
        return r
    }
}


// ============================================================
// 场景 3：对照组 2 —— 构造体内不引用任何函数
// 差异点：构造函数体内只做赋值，不调用任何函数
// 期望：编译通过
// 目前实际：通过
// ============================================================
@if (A_SCENARIO == 3) {
    namespace n {
        struct S {
            int v

            constructor () {
                v = 1
            }
        }
    }

    int main() {
        n::S s
        return 0
    }
}


// ============================================================
// 场景 4：对照组 3 —— 构造引用全局函数
// 差异点：helper 是全局函数，不在任何命名空间内
// 说明：这揭示 Bug A 不是命名空间特有，而是"顶层顺序敏感"
// 期望：编译通过
// 目前实际：ER 0009: function 'helper' is undefined
// ============================================================
@if (A_SCENARIO == 4) {
    int helper() {
        return 1
    }

    namespace n {
        struct S {
            int v

            constructor () {
                v = helper()
            }
        }
    }

    int main() {
        n::S s
        return 0
    }
}


// ============================================================
// 场景 5：对照组 4 —— 换名字，验证不是名字特例
// 差异点：函数名换成 write / 结构体换成 Buf
// 期望：编译通过
// 目前实际：ER 0009: function 'io$write' is undefined
// ============================================================
@if (A_SCENARIO == 5) {
    namespace io {
        void write() {
            return
        }

        struct Buf {
            int size

            constructor () {
                size = 0
                write()
            }
        }
    }

    int main() {
        io::Buf b
        return 0
    }
}