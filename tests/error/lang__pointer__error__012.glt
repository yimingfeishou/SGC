// lang__pointer__error__012.glt
// expect exit nonzero

// 测试方式：
//   1. 修改下方 @cond B_SCENARIO 的值（1-7）切换场景
//
// 场景清单：
//   1 = 主复现：<< 指针形参                           期望通过 / 实际 ER 0004
//   2 = 对照组：同场景改用 +=                          期望通过 / 实际 通过
//   3 = 对照组：左操作数本身是指针                     期望通过 / 实际 通过
//   4 = 对照组：形参按值传递                           期望通过 / 实际 通过
//   5 = 对照组：改用 >>                                期望通过 / 实际 ER 0004
//   6 = 对照组：改用 +（加法）                         期望通过 / 实际 ER 0004
//   7 = 对照组：改用 ==（比较）                        期望通过 / 实际 ER 0004

@cond B_SCENARIO = 2


// ============================================================
// 场景 1：主复现
// 期望：编译通过（调用点命中 operator << (Foo*, string)）
// 目前实际：ER 0004: operator '<<' requires integer types,
//           got 'struct Foo' and 'string'
// ============================================================
@if (B_SCENARIO == 1) {
    struct Foo {
        int v
    }

    int operator << (Foo* self, string text) {
        return 0
    }

    Foo out

    int main() {
        out << "hi"
        return 0
    }
}


// ============================================================
// 场景 2：对照组 1 —— 用 += 代替 <<
// 差异点：AssignmentExpression 分支已设 operand_needs_address
// 期望：编译通过
// 目前实际：通过
// ============================================================
@if (B_SCENARIO == 2) {
    struct Foo {
        int v
    }

    void operator += (Foo* self, int delta) {
        self->v = self->v + delta
    }

    int main() {
        Foo a = {0}
        a += 5
        return a.v
    }
}


// ============================================================
// 场景 3：对照组 2 —— 调用点左边本身就是指针
// 差异点：p 已经是指针，无需隐式取地址
// 期望：编译通过
// 目前实际：通过
// ============================================================
@if (B_SCENARIO == 3) {
    struct Foo {
        int v
    }

    int operator << (Foo* self, string text) {
        return 0
    }

    int main() {
        Foo* p = heap(Foo)
        p << "hi"
        free(p)
        return 0
    }
}


// ============================================================
// 场景 4：对照组 3 —— 运算符第一个形参不是指针
// 差异点：形参按值传递，不需要取地址
// 期望：编译通过
// 目前实际：通过
// ============================================================
@if (B_SCENARIO == 4) {
    struct Foo {
        int v
    }

    int operator << (Foo self, string text) {
        return 0
    }

    Foo out

    int main() {
        out << "hi"
        return 0
    }
}


// ============================================================
// 场景 5：对照组 4 —— 改用 >>
// 差异点：改为 >> 运算符
// 期望：编译通过
// 目前实际：ER 0004: operator '>>' requires integer types,
//           got 'struct Foo' and 'string'
// ============================================================
@if (B_SCENARIO == 5) {
    struct Foo {
        int v
    }

    int operator >> (Foo* self, string text) {
        return 0
    }

    Foo in_stream

    int main() {
        in_stream >> "hi"
        return 0
    }
}


// ============================================================
// 场景 6：对照组 5 —— 改用 +（加法）
// 差异点：改为 + 运算符，验证影响面不止 << / >>
// 期望：编译通过
// 目前实际：ER 0004: operator '+' requires arithmetic types,
//           got 'struct Vec' and 'struct Vec'
// ============================================================
@if (B_SCENARIO == 6) {
    struct Vec {
        int x
        int y
    }

    Vec operator + (Vec* self, Vec other) {
        Vec r = {self->x + other.x, self->y + other.y}
        return r
    }

    int main() {
        Vec a = {1, 2}
        Vec b = {3, 4}
        Vec c = a + b
        return c.x
    }
}


// ============================================================
// 场景 7：对照组 6 —— 改用 ==（比较）
// 差异点：改为 == 运算符
// 期望：编译通过
// 目前实际：ER 0004: operator '==' requires arithmetic types
//           or compatible pointers, got 'struct Foo' and 'struct Foo'
// ============================================================
@if (B_SCENARIO == 7) {
    struct Foo {
        int v
    }

    bool operator == (Foo* self, Foo other) {
        return self->v == other.v
    }

    int main() {
        Foo a = {1}
        Foo b = {1}
        bool r = a == b
        return r ? 1 : 0
    }
}