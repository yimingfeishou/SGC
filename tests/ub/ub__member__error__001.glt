// ub__member__error__001.glt
// expect exit nonzero

struct Holder {
    int* p
    int n
    string label = "L"
}

int main() {
    Holder a
    a.p = heap(int, 2)
    a.p[0] = 42
    a.n = 7
    a.label = "hello"

    Holder b = move(a)
    output(a.p == null, " ", b.n, " ", b.p[0], " [", a.label, "][", b.label, "]\n")

    Holder c = b
    output(c.p == b.p, " ", c.n, "\n")

    free(b.p)
    b.p = null
    free(c.p)
    c.p = null
    return 0
}
