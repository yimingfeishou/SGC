// lang__varargs__pass__005.glt
// expect output
// len=0 empty=true first=0 last=0 get0=0 data_null=true
// len=1 empty=false first=7 last=7 get0=7 data_null=false
// len=3 empty=false first=1 last=3 get0=1 data_null=false
// 4 5 

void inspect(int... values) {
    output("len=", values.length, " empty=", values.empty, " first=", values.first, " last=", values.last, " get0=", values.get(0), " data_null=", values.data == null, "\n")
}

void main_pack(int... values) {
    for (int i = 0; i < values.length; i++) {
        output(values[i], " ")
    }
    output("\n")
}

int main() {
    inspect()
    inspect(7)
    inspect(1, 2, 3)
    main_pack(4, 5)
    return 0
}
