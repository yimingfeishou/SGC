// lang__emit__pass__004.glt
// expect output
// 10

generics TypeName<T> {
    const if (T.typename == "int") {
        emit {
            int name_code() {
                return 1
            }
        }
    } const else {
        emit {
            int name_code() {
                return 0
            }
        }
    }
}
int main() {
    output(TypeName<int>.name_code())
    output(TypeName<float>.name_code())
    return 0
}
