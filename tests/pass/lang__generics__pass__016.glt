// lang__generics__pass__016.glt
// expect output
// 10

generics Box<T> {
    struct Box {
        T value
    }
    T get(Box b) {
        return b.value
    }
}
generics Box<T*> {
    struct Box {
        T* value
    }
    T* get(Box b) {
        return b.value
    }
    T deref(Box b) {
        return *b.value
    }
}
int main() {
    Box<int*>.Box b
    int x = 10
    b.value = &x
    output(Box<int*>.deref(b))
    return 0
}
