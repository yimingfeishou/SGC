// lang__lifecycle__pass__016.glt
// expect output
// moved 

generics Mover<T: string> {
    struct Buffer {
        T* data
        int size

        constructor () {
            data = null
            size = 0
        }

        destructor () {
            if (data != null) {
                for (int i = 0; i < size; i++) {
                    T discarded = move(data[i])
                }
                free(data)
                data = null
            }
            size = 0
        }
    }

    void relocate(Buffer* target, Buffer* source) {
        if (target == null || source == null) {
            return
        }
        for (int i = 0; i < source->size; i++) {
            target->data[i] = move(source->data[i])
        }
    }
}

int main() {
    Mover<string>.Buffer a = Mover<string>.Buffer()
    Mover<string>.Buffer b = Mover<string>.Buffer()
    a.data = heap(string, 4)
    a.size = 4
    b.data = heap(string, 4)
    b.size = 4
    if (a.data == null || b.data == null) {
        return 4
    }
    string payload = "x"
    for (int i = 0; i < 10; i++) {
        payload = payload + payload
    }
    a.data[0] = payload
    a.data[1] = payload
    a.data[2] = payload
    a.data[3] = payload
    Mover<string>.relocate(&b, &a)
    output("moved ", b.data[0])
    return 0
}