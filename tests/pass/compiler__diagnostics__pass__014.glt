struct Named {
    string name
    int id

    constructor (string n, int i) {
        name = n
        id = i
    }

    copy_constructor (Named* other) {
        name = other->name
        id = other->id
    }
}

int main() {
    Named a = Named("Alice", 1)
    return 0
}