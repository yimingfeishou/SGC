// lang__generics__pass__015.glt
// expect output
// 10

generics Check<T: int | float | string> {
    const if (T.is_integer == true && T.is_pointer == false) {
        emit {
            int code() {
                return 1
            }
        }
    } const else {
        emit {
            int code() {
                return 0
            }
        }
    }
}
int main() {
    output(Check<int>.code())
    output(Check<float>.code())
    return 0
}
