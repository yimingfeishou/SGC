// lang__cast__pass__029.glt
// expect output
// 1 1 true

struct R {
    int* p
    int n

    constructor (int x) {
        n = x
        p = heap(int, 1)
        *p = x
    }

    copy_constructor (R* other) {
        n = other->n
        p = heap(int, 1)
        *p = *(other->p)
    }

    destructor () {
        if (p != null) {
            free(p)
            p = null
        }
    }
}

int main() {
    R a = R(1)
    R b = cast<R>(a)
    output(a.n, " ", b.n, " ", a.p != b.p)
    return 0
}
