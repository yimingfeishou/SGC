// lang__construct__pass__012.glt
// expect output
// 4

generics Fixed<T, int N> {
    struct Buf {
        T data[N]
        constructor (T fill) {
            data[0] = fill
        }
    }
}
int main() {
    Fixed<int, 3>.Buf* b = construct Fixed<int, 3>.Buf(4)
    output(b->data[0])
    destruct b
    return 0
}
