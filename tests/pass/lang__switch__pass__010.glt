// lang__switch__pass__010.glt
// expect output
// A1
// AD
// A2
// B2
// DD
// E2
// G1
// HD

int fn(int v) {
    return v
}

int main() {
    int x = 0
    x = 1
    switch (x) {
        case (1) {
            output("A1\n")
            fallthrough
        }
        output("AD\n")
        fallthrough
        case (2) {
            output("A2\n")
        }
        output("AD2\n")
    }
    x = 2
    switch (x) {
        case (1) {
            output("B1\n")
        } case (2) {
            output("B2\n")
        } case (3) {
            output("B3\n")
        }
        output("BD\n")
    }
    x = 4
    switch (x) {
        case (1) {
            output("C1\n")
        }
    }
    x = 4
    switch (x) {
        case (1) {
            output("D1\n")
        }
        output("DD\n")
    }
    switch (2) {
        case (1) {
            output("E1\n")
        } case (2) {
            output("E2\n")
        } case (3) {
            output("E3\n")
        }
    }
    switch (5) {
        case (1) {
            output("F1\n")
        } case (2) {
            output("F2\n")
        }
    }
    switch (2) {
        case (fn(2)) {
            output("G1\n")
        } case (1) {
            output("G2\n")
        }
    }
    switch (3) {
        case (1) {
            output("H1\n")
        }
        output("HD\n")
        case (2) {
            output("H2\n")
        }
    }
    return 0
}
