// lang__generics__pass__020.glt
// expect output
// true 1 1 0

generics Probe<T> {
    bool to_int() {
        return T.is_convertible<int>
    }

    int classify() {
        const if (T.is_integer == true) {
            return 1
        } const else {
            return 0
        }
    }
}

int main() {
    output(Probe<bool>.to_int(), " ", Probe<bool>.classify(), " ", Probe<char>.classify(), " ", Probe<string>.classify())
    return 0
}
