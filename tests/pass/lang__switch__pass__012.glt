// lang__switch__pass__012.glt
// expect output
// value is 2

int main() {
    int x = 2
    switch (x) {
        case (1) {
            output("value is 1")
        } case (2) {
            output("value is 2")
        } case (3) {
            output("value is 3")
        }
        output("unknown value")
    }
    return 0
}