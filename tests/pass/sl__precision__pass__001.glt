// sl__precision__pass__001.glt
// expect output
// sqrt: 2.0 1.4142135623730949 0.5 10.0 tiny: 0.0 big: 0.0exp: 2.7182818284590446 1.648721270700128 0.36787944117144239 1.0 log: 0.99999999999999989 0.0 2.3025850929940455 3.0 2.9999999999999996pow: 1024.0 1.0 0.0 -8.0 0.0trig: 0.0 1.0 1.0000000000000002 -1.0000000000000002 0.0 1.0 sin(1000000): -0.34999350217129255 cos(1000000): 0.93675212753314496atan: 0.78539816339744828 1.1071487177940904 -0.78539816339744828 0.0 asin: 0.52359877559829904 1.5707963267948966 -1.5707963267948966 0.0 acos: 1.0471975511965974 0.0 3.1415926535897931 1.5707963267948966 atan2: 0.78539816339744828 2.3561944901923448 1.5707963267948966 0.0hyp: 1.1752011936438012 1.5430806348152435 0.76159415595576485 1.0 0.0 -1.0 fmod: 1.5 0.0 -1.5round: -2.0 -3.0 -2.0 3.0 -3.0 10000000000.0 -10000000001.0misc: 3.5 2.0 5.0 4.0

guide "math.glt"
access namespace sl

int main() {
    output("sqrt: ", sqrt(4.0), " ", sqrt(2.0), " ", sqrt(0.25), " ", sqrt(100.0))
    double tiny = 1.0
    for (int i = 0; i < 100; i = i + 1) {
        tiny = tiny / 100.0
    }
    output(" tiny: ", sqrt(tiny) * sqrt(tiny) - tiny)
    double big = 1.0
    for (int i = 0; i < 80; i = i + 1) {
        big = big * 100.0
    }
    output(" big: ", sqrt(big) * sqrt(big) - big)
    output("exp: ", exp(1.0), " ", exp(0.5), " ", exp(-1.0), " ", exp(0.0))
    output(" log: ", log(2.718281828459045), " ", log(1.0), " ", log(10.0), " ", log2(8.0), " ", log10(1000.0))
    output("pow: ", pow(2.0, 10.0), " ", pow(0.0, 0.0), " ", pow(0.0, -1.0), " ", pow(-2.0, 3.0), " ", pow(-2.0, 0.5))
    output("trig: ", sin(0.0), " ", cos(0.0), " ", sin(pi / 2.0), " ", cos(pi), " ", tan(pi / 2.0), " ", tan(0.7853981633974483))
    output(" sin(1000000): ", sin(1000000.0), " cos(1000000): ", cos(1000000.0))
    output("atan: ", atan(1.0), " ", atan(2.0), " ", atan(-1.0), " ", atan(0.0))
    output(" asin: ", asin(0.5), " ", asin(1.0), " ", asin(-1.0), " ", asin(2.0), " acos: ", acos(0.5), " ", acos(1.0), " ", acos(-1.0), " ", acos(0.0))
    output(" atan2: ", atan2(1.0, 1.0), " ", atan2(1.0, -1.0), " ", atan2(1.0, 0.0), " ", atan2(0.0, 0.0))
    output("hyp: ", sinh(1.0), " ", cosh(1.0), " ", tanh(1.0), " ", tanh(1000.0), " ", sinh(0.0), " ", tanh(-1000.0))
    output(" fmod: ", fmod(5.5, 2.0), " ", fmod(1.0, 0.0), " ", fmod(-5.5, 2.0))
    output("round: ", trunc(-2.5), " ", floor(-2.5), " ", ceil(-2.5), " ", round(2.5), " ", round(-2.5), " ", trunc(10000000000.5), " ", floor(-10000000000.5))
    output("misc: ", abs(-3.5), " ", min(2.0, 5.0), " ", max(2.0, 5.0), " ", clamp(9.0, 1.0, 4.0))
    return 0
}
