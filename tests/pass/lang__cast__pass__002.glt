// 134

int which(int v) {
    return 1
}
int which(double v) {
    return 2
}
int both(char a, char b) {
    return 3
}
int both(int a, int b) {
    return 4
}
int main() {
    char c = 'A'
    output(which(c))
    output(both('a', 'b'))
    output(both(1, 2))
    return 0
}
