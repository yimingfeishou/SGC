// lang__const__pass__020.glt
// expect output
// -1
// true
// 81

int order(string a, string b) const {
    return strcompare(a, b)
}

bool same(string a, string b) const {
    if (strcompare(a, b) == 0) {
        return true
    }
    return false
}

int next_power_of(int base, int limit) const {
    int value = 1
    while (true) {
        if (value > limit) {
            break
        }
        value = value * base
    }
    return value
}

const int comparison = order("abc", "abd")
const bool equal = same("same", "same")
const int power = next_power_of(3, 50)

int main() {
    output(comparison, "\n")
    output(equal, "\n")
    output(power, "\n")
    return 0
}
