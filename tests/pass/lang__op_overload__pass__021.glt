// lang__op_overload__pass__021.glt
// expect output
// 3 4

struct A {
    int v
}

struct B {
    int v
}

struct Box {
    int x
}

int is_open(A a) { return a.v }
int is_open(B b) { return b.v }
int operator << (Box lhs, int rhs) { return lhs.x + rhs }

int main() {
    A a = {3}
    B b = {4}
    Box x = {0}
    output(x << is_open(a), " ", x << is_open(b))
    return 0
}