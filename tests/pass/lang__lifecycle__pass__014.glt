// lang__lifecycle__pass__014.glt
// expect output
// 4 2 2

struct S {
    int x
    int tag

    copy_constructor (S* other) {
        x = other->x
        tag = 1
    }

    move_constructor (S* other) {
        x = other->x
        tag = 2
    }

    copy_assignment (S* other) {
        x = other->x
        tag = 3
    }

    move_assignment (S* other) {
        x = other->x
        tag = 4
    }

    destructor () {
        return
    }
}

struct W {
    S m
}

S make(int v) {
    S r
    r.x = v
    r.tag = 0
    return r
}

S forward(int v) {
    return make(v)
}

int main() {
    S a
    a.x = 1
    a.tag = 0
    a = make(5)
    output(a.tag, " ")

    S b = forward(6)
    output(b.tag, " ")

    W w = {make(7)}
    output(w.m.tag)
    return 0
}
