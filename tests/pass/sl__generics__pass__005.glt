// sl__generics__pass__005.glt
// expect output
// true false 2 30 10 | 7 | true true 1

guide "generics.glt"
access namespace sl

int main() {
    dynamic_array_generic<int>.dynamic_array nums = dynamic_array_generic<int>.dynamic_array(2)
    dynamic_array_generic<int>.push(&nums, 10)
    dynamic_array_generic<int>.push(&nums, 20)
    dynamic_array_generic<int>.push(&nums, 30)
    output(dynamic_array_generic<int>.contains(&nums, 20), " ")
    output(dynamic_array_generic<int>.contains(&nums, 99), " ")
    output(dynamic_array_generic<int>.index_of(&nums, 30), " ")
    dynamic_array_generic<int>.reverse(&nums)
    output(dynamic_array_generic<int>.get(&nums, 0), " ", dynamic_array_generic<int>.get(&nums, 2), " | ")
    dynamic_array_generic<int>.fill(&nums, 7)
    output(dynamic_array_generic<int>.get(&nums, 1), " | ")

    dynamic_array_generic<bool>.dynamic_array flags = dynamic_array_generic<bool>.dynamic_array(2)
    dynamic_array_generic<bool>.push(&flags, true)
    dynamic_array_generic<bool>.push(&flags, false)
    output(dynamic_array_generic<bool>.contains(&flags, true), " ")
    output(dynamic_array_generic<bool>.contains(&flags, false), " ")
    output(dynamic_array_generic<bool>.index_of(&flags, false))
    return 0
}
