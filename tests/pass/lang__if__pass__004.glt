// lang__if__pass__004.glt
// expect output
// 0  -1

generics Emiter<T> {
    const if (T.is_integer == true) {
        emit {
            T get() {
                return 0
            }
        }
    } const else {
        const if (T.is_string == true) {
            emit {
                T get() {
                    return ""
                }
            }
        } const else {
            emit {
                int get() {
                    return -1
                }
            }
        }
    }
}

int main() {
    output(Emiter<int>.get(), " ", Emiter<string>.get(), " ", Emiter<double>.get(), "\n")
    return 0
}
