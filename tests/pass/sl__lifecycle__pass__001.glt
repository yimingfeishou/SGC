// sl__lifecycle__pass__001.glt
// expect output
// ok 2000

guide "generics.glt"
access namespace sl

int main() {
    dynamic_array_generic<string>
    int total = 0
    for (int round = 0; round < 20; round++) {
        dynamic_array items = dynamic_array(4)
        string payload = "x"
        for (int i = 0; i < 20; i++) {
            payload = payload + payload
        }
        for (int i = 0; i < 100; i++) {
            push(&items, payload)
        }

        total = total + length(&items)
    }
    output("ok ", total)
    return 0
}