// lang__pointer__pass__020.glt
// expect output
// 2 30 40
// true true false
// 10 50
// 6
// 6

int main() {
    int arr[5] = {10, 20, 30, 40, 50}
    int* p = &arr[0]
    int* q = p + 2
    output(q - p, " ", *q, " ", arr[3], "\n")
    output(1 + p == &arr[1], " ", p < q, " ", p == null, "\n")
    int* r = arr
    output(*r, " ", *(p + 4), "\n")
    int x = 5
    int* px = &x
    *px = *px + 1
    output(x, "\n")
    void* v = px
    int* back = cast<int*>(v)
    output(*back, "\n")
    return 0
}
