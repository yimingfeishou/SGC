// lang__str_func__pass__008.glt
// expect output
// 3
// Standard
// Gallt | Standard | Compiler
// COMPILER
// 6

int main() {
    string text = "  Gallt,Standard,Compiler  "
    string trimmed = strtrim(text)
    output(strsplitcount(trimmed, ","), "\n")
    output(strsplitget(trimmed, ",", 1), "\n")
    output(strreplace(trimmed, ",", " | "), "\n")
    output(strupper(strsplitget(trimmed, ",", 2)), "\n")
    output(strfind(trimmed, "Standard"), "\n")
    return 0
}
