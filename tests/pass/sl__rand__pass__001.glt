// sl__rand__pass__001.glt
// expect output
// stdlib_math_random: ok (56 checks)

guide "math.glt"
access namespace sl

int checks = 0
int failures = 0

void check(bool condition, string label) {
    if (condition) {
        checks = checks + 1
        return
    }
    output("FAIL: ", label, "\n")
    failures = failures + 1
}

int main() {
    check(gcd(12, 18) == 6, "gcd basic")
    check(gcd(-12, 18) == 6, "gcd negative left")
    check(gcd(12, -18) == 6, "gcd negative right")
    check(gcd(-12, -18) == 6, "gcd both negative")
    check(gcd(0, 5) == 5, "gcd zero left")
    check(gcd(5, 0) == 5, "gcd zero right")
    check(gcd(0, 0) == 0, "gcd both zero")
    check(gcd(7, 13) == 1, "gcd coprime")
    check(gcd(1, 1) == 1, "gcd ones")

    check(lcm(4, 6) == 12, "lcm basic")
    check(lcm(-4, 6) == 12, "lcm negative")
    check(lcm(0, 5) == 0, "lcm zero left")
    check(lcm(5, 0) == 0, "lcm zero right")
    check(lcm(9, 9) == 9, "lcm equal")
    check(lcm(7, 13) == 91, "lcm coprime")

    srand(1234lu)
    int expected_rand = rand()
    srand(1234lu)
    int repeated_rand = rand()
    check(expected_rand == repeated_rand, "srand reproducible")

    srand(1234lu)
    bool expected_bool = rand() % 2 == 0
    srand(1234lu)
    bool actual_bool = random_bool()
    check(actual_bool == expected_bool, "random_bool matches rand parity")
    bool any_bool = random_bool()
    check(any_bool == true || any_bool == false, "random_bool returns boolean")

    srand(1234lu)
    int expected_char = 32 + rand() % 95
    srand(1234lu)
    int actual_char = cast<int>(random_char())
    check(actual_char == expected_char, "random_char matches rand range")
    check(actual_char >= 32 && actual_char <= 126, "random_char printable ascii")

    check(math_ops_generic<int>.abs(-7) == 7, "int abs negative")
    check(math_ops_generic<int>.abs(7) == 7, "int abs positive")
    check(math_ops_generic<int>.abs(0) == 0, "int abs zero")
    check(math_ops_generic<int>.min(3, 5) == 3, "int min")
    check(math_ops_generic<int>.min(-3, -5) == -5, "int min negative")
    check(math_ops_generic<int>.max(3, 5) == 5, "int max")
    check(math_ops_generic<int>.max(-3, -5) == -3, "int max negative")
    check(math_ops_generic<int>.clamp(9, 1, 4) == 4, "int clamp high")
    check(math_ops_generic<int>.clamp(0, 1, 4) == 1, "int clamp low")
    check(math_ops_generic<int>.clamp(2, 1, 4) == 2, "int clamp inside")
    check(math_ops_generic<int>.clamp(3, 4, 1) == 4, "int clamp inverted bounds")

    check(math_ops_generic<lint>.abs(-9l) == 9l, "lint abs")
    check(math_ops_generic<lint>.min(-9l, 3l) == -9l, "lint min")
    check(math_ops_generic<lint>.max(-9l, 3l) == 3l, "lint max")
    check(math_ops_generic<lint>.clamp(-9l, -4l, 4l) == -4l, "lint clamp")

    check(math_ops_generic<uint>.min(3u, 5u) == 3u, "uint min")
    check(math_ops_generic<uint>.max(3u, 5u) == 5u, "uint max")
    check(math_ops_generic<uint>.abs(7u) == 7u, "uint abs")
    check(math_ops_generic<uint>.clamp(9u, 1u, 4u) == 4u, "uint clamp")

    check(math_ops_generic<luint>.min(3lu, 5lu) == 3lu, "luint min")
    check(math_ops_generic<luint>.max(3lu, 5lu) == 5lu, "luint max")
    check(math_ops_generic<luint>.abs(7lu) == 7lu, "luint abs")

    check(math_ops_generic<float>.abs(-1.5f) == 1.5f, "float abs")
    check(math_ops_generic<float>.min(1.5f, 2.5f) == 1.5f, "float min")
    check(math_ops_generic<float>.max(1.5f, 2.5f) == 2.5f, "float max")
    check(math_ops_generic<float>.clamp(5.0f, 0.0f, 1.0f) == 1.0f, "float clamp")

    check(math_ops_generic<double>.abs(-2.5) == 2.5, "double generic abs")
    check(math_ops_generic<double>.min(-2.5, -1.5) == -2.5, "double generic min")

    check(min(2.0, 5.0) == 2.0, "existing double min preserved")
    check(max(2.0, 5.0) == 5.0, "existing double max preserved")
    check(clamp(9.0, 1.0, 4.0) == 4.0, "existing double clamp preserved")
    check(abs(-3.5) == 3.5, "existing double abs preserved")

    srand(7lu)
    int values[6] = {1, 2, 3, 4, 5, 6}
    shuffle_generic<int>
    shuffle(values, 6)
    int total = 0
    bool seen[7] = {false, false, false, false, false, false, false}
    for (int i = 0; i < 6; i++) {
        total = total + values[i]
        seen[values[i]] = true
    }
    check(total == 21, "shuffle preserves sum")
    check(seen[1] && seen[2] && seen[3] && seen[4] && seen[5] && seen[6], "shuffle preserves elements")

    int single[1] = {9}
    shuffle(single, 1)
    check(single[0] == 9, "shuffle single element")
    shuffle(null, 6)
    shuffle(single, 0)
    check(true, "shuffle null and zero size safe")

    if (failures == 0) {
        output("stdlib_math_random: ok (", checks, " checks)\n")
    }
    return failures
}
