// sl__math__pass__005.glt
// expect output
// 6 6 5 0 1 | 12 12 0 91 | true true true 60 | 7 3 5 4 | 9 -4 | 3 7 | 5 | 1.5 1.5  | 21 true

guide "math.glt"
access namespace sl

int main() {
    output(gcd(12, 18), " ", gcd(-12, 18), " ", gcd(0, 5), " ", gcd(0, 0), " ", gcd(7, 13), " | ")
    output(lcm(4, 6), " ", lcm(-4, 6), " ", lcm(0, 5), " ", lcm(7, 13), " | ")

    srand(42lu)
    output(random_bool(), " ", random_bool(), " ")
    srand(42lu)
    char c = random_char()
    int code = cast<int>(c)
    output(code >= 32 && code <= 126, " ", code, " | ")

    output(math_ops_generic<int>.abs(-7), " ", math_ops_generic<int>.min(3, 5), " ", math_ops_generic<int>.max(3, 5), " ", math_ops_generic<int>.clamp(9, 1, 4), " | ")
    output(math_ops_generic<lint>.abs(-9l), " ", math_ops_generic<lint>.clamp(-9l, -4l, 4l), " | ")
    output(math_ops_generic<uint>.min(3u, 5u), " ", math_ops_generic<uint>.abs(7u), " | ")
    output(math_ops_generic<luint>.max(3lu, 5lu), " | ")
    output(math_ops_generic<float>.abs(-1.5f), " ", math_ops_generic<float>.min(1.5f, 2.5f), " ")

    srand(7lu)
    int values[6] = {1, 2, 3, 4, 5, 6}
    shuffle_generic<int>
    shuffle(values, 6)
    int total = 0
    bool seen[7] = {false, false, false, false, false, false, false}
    for (int i = 0; i < 6; i++) {
        total = total + values[i]
        seen[values[i]] = true
    }
    output(" | ", total, " ", seen[1] && seen[2] && seen[3] && seen[4] && seen[5] && seen[6])
    return 0
}
