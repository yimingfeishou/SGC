// lang__cast__pass__010.glt
// expect output
// 9000000000
// 8000000000
// 15000000000
// 14000000000
// B
// 4
// -1294967296

lint wide = 5000000000l
luint uwide = 10000000000lu

int main() {
    lint a = wide
    a += 4000000000l
    output(a, "\n")
    a -= 1000000000l
    output(a, "\n")
    luint b = uwide
    b += 5000000000lu
    output(b, "\n")
    b -= 1000000000lu
    output(b, "\n")
    char c = 'A'
    c += 1
    output(c, "\n")
    uchar u = 250
    u += 10
    output(cast<int>(u), "\n")
    int i = 2000000000
    i += 1000000000
    output(i, "\n")
    return 0
}
