// lang__construct__pass__002.glt
// expect output
// 42

struct Buffer {
    int* data
    int size
    constructor (int sz) {
        size = sz
        data = heap(int, sz)
    }
    destructor () {
        if (data != null) {
            free(data)
            data = null
        }
    }
}
int main() {
    Buffer* p = construct Buffer(4)
    p->data[0] = 42
    output(p->data[0])
    destruct p
    return 0
}
