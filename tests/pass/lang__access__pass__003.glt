// lang__access__pass__003.glt
// expect output
// 103 204

namespace ns {
    struct A {
        int x
    }
}

addition namespace ns {
    A operator + (A a, A b) {
        A r = {a.x + b.x + 100}
        return r
    }

    A operator + (A a, int b) {
        A r = {a.x + b + 200}
        return r
    }
}

access namespace ns

int main() {
    A a = {1}
    A b = {2}
    A c = a + b
    A d = a + 3
    output(c.x, " ", d.x)
    return 0
}