// expect output
// default statement
// case 2

int main() {
    int x = 3
    switch (x) {
        case (1) {
            output("case 1\n")
            fallthrough
        }
        output("default statement\n")
        fallthrough
        case (2) {
            output("case 2\n")
        }
        output("default statement\n")
    }
    return 0
}
