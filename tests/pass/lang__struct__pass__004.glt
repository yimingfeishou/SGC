// lang__struct__pass__004.glt
// expect output
// 11 ok

int scoped_local_structs() {
    {
        struct Local {
            int value
        }
        Local item = {11}
        output(item.value, " ")
    }
    {
        struct Local {
            string value
        }
        Local item = {"ok"}
        output(item.value)
    }
    return 0
}

int main() {
    return scoped_local_structs()
}
