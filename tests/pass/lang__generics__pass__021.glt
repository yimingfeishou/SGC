// lang__generics__pass__021.glt
// expect output
// 42 7 9

guide "../support/lib/generic_box.glt"

generics Box<Custom> {
    struct Box {
        int tag
    }

    int code() {
        return 7
    }
}

int main() {
    Box<int>.Box bi = {42}
    output(Box<int>.get(bi))
    Box<Custom>.Box bc = {9}
    output(" ", Box<Custom>.code(), " ", bc.tag)
    return 0
}
