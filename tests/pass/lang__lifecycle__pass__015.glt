// lang__lifecycle__pass__015.glt
// expect output
// 0 6 7

struct S {
    int x

    constructor () {
        x = 0
    }
}

struct P {
    int a
    int b

    constructor (int ia, int ib) {
        a = ia
        b = ib
    }
}

int main() {
    S s
    P p = {6, 7}
    output(s.x, " ", p.a, " ", p.b)
    return 0
}
