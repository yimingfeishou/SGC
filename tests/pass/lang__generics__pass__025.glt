// lang__generics__pass__025.glt
// expect output
// 10hello
// 1:2.5
// 1:7

generics Tuple<T...> {
    void show(T... args) {
        const if (T.length > 0) {
            output(args[0])
        }
        const if (T.length > 1) {
            output(args[1])
        }
        output("\n")
    }
}

generics Solo<T...> {
    void one(T... args) {
        output(args.length, ":", args.first, "\n")
    }
}

int main() {
    Tuple<int, string>
    show(10, "hello")
    {
        Solo<double>
        one(2.5)
    }
    {
        Solo<int>
        one(7)
    }
    return 0
}
