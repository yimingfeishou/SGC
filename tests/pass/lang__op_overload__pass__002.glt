// lang__op_overload__pass__002.glt
// expect output
// 712

struct Left {
    int value
}

struct Right {
    int value
}

Left operator + (Left a, Left b) {
    Left r = {a.value + b.value}
    return r
}

Right operator + (Right a, Right b) {
    Right r = {a.value * b.value}
    return r
}

int main() {
    Left l1 = {3}
    Left l2 = {4}
    Right r1 = {3}
    Right r2 = {4}
    Left sum = l1 + l2
    Right product = r1 + r2
    output(sum.value, product.value)
    return 0
}
