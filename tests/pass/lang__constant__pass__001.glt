// lang__constant__pass__001.glt
// expect output
// 10

generics Choice<T: int | string> {
    const if (T.is_integer == true) {
        const if (T.is_pointer == false) {
            emit {
                int choice() {
                    return 1
                }
            }
        }
    } const else {
        emit {
            int choice() {
                return 0
            }
        }
    }
}
int main() {
    output(Choice<int>.choice())
    output(Choice<string>.choice())
    return 0
}
