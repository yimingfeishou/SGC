// lang__short_circuit__pass__001.glt
// expect output
// and-elseor-then

@cond FLAG = 0
@cond OFF = 1

int main() {
    @if (FLAG && UNSET_NAME) {
        output("and-then")
    } @else {
        output("and-else")
    }
    @if (OFF || UNSET_NAME) {
        output("or-then")
    } @else {
        output("or-else")
    }
    return 0
}
