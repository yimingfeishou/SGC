// lang__generics__pass__012.glt
// expect output
// 1one

generics Pair<T, U> {
    struct Pair {
        T first
        U second
    }
    T first_of(Pair p) {
        return p.first
    }
    U second_of(Pair p) {
        return p.second
    }
}
int main() {
    Pair<int, string>.Pair p = {1, "one"}
    int x = Pair<int, string>.first_of(p)
    string y = Pair<int, string>.second_of(p)
    output(x)
    output(y)
    return 0
}
