// lang__generics__pass__042.glt
// expect output
// 7

generics Box<T> {
    struct Inner {
        T k
        constructor (T v) {
            k = v
        }
    }
    struct Outer {
        Inner inner
        constructor (Inner i) {
            inner = i
        }
    }
}
int main() {
    Box<int>.Inner in = Box<int>.Inner(7)
    Box<int>.Outer out = {in}
    output(out.inner.k)
    return 0
}
