// lang__construct__pass__017.glt
// expect output
// 0 hi

struct Inner {
    string s
}

struct Outer {
    Inner inner

    constructor (Inner i) {
        inner = i
    }
}

int main() {
    Inner x
    x.s = "hi"
    Outer* p = construct Outer(move(x))
    output(strlen(x.s), " ")
    output(p->inner.s)
    destruct p
    return 0
}