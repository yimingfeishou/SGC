// compiler__diagnostics__pass__012.glt
// expect output
// 8 2.5

namespace app {
    struct Account {
        string name
        int id
        int els

        constructor (string n, int i) {
            name = n
            id = i
            els = 0
        }

        copy_constructor (Account* other) {
            name = other->name
            id = other->id
            els = other->els
        }
    }

    int score(Account* a) {
        return a->id + a->els
    }

    void touch(Account* a, int n) {
        if (n > 0) {
            a->id = a->id + n
        }
        a->els = a->els + 1
    }
}

generics Store<in> {
    struct Slot {
        in value
    }

    in load(Slot s) {
        return s.value
    }
}

@cond debug = 0

int main() {
    app::Account a = app::Account("bob", 4)
    app::touch(&a, 3)
    Store<float>
    Slot s = {2.5}
    float v = load(s)
    output(app::score(&a), " ", v)
    return 0
}