// lang__file__pass__003.glt
// expect output

int main() {
    file* fp = fileopen("./sgc_eof_test.txt", "w")
    if (fp == null) {
        return 3
    }
    filewrite(fp, "ab")
    fileclose(fp)

    file* rp = fileopen("./sgc_eof_test.txt", "r")
    if (rp == null) {
        return 3
    }
    if (fileeof(rp) == true) {
        fileclose(rp)
        fileremove("./sgc_eof_test.txt")
        return 4
    }
    char buffer[8]
    int n = fileread(rp, buffer, 8)
    if (n != 2) {
        fileclose(rp)
        return 5
    }
    bool done = fileeof(rp)
    fileclose(rp)
    fileremove("./sgc_eof_test.txt")
    if (done == true) {
        return 0
    }
    return 1
}
