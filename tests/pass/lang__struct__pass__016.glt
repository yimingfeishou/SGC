// lang__struct__pass__016.glt
// expect output
// 3 4 5 3

struct S {
    int x

    constructor () {
        x = 0
    }

    copy_constructor (S* other) {
        x = other->x
    }

    move_constructor (S* other) {
        x = other->x
    }

    copy_assignment (S* other) {
        x = other->x
    }

    move_assignment (S* other) {
        x = other->x
    }

    destructor () {
        return
    }
}

S make(int v) {
    S r
    r.x = v
    return r
}

int main() {
    S a
    a.x = 3
    S* p = &a

    S b
    b.x = 0
    b = *p
    output(b.x, " ")

    S arr[2]
    arr[1].x = 4
    b = arr[1]
    output(b.x, " ")

    b = make(5)
    output(b.x, " ")

    S c = copy(*p)
    output(c.x)
    return 0
}
