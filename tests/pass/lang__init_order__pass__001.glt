// lang__init_order__pass__001.glt
// expect output
// 1231023

int zero
int order

int record(int value) {
    order = order * 10 + value
    return value
}

int first = record(1)
int zero_copy = zero
int second = record(2)
int third = record(3)

int main() {
    output(order)
    output(first)
    output(zero_copy)
    output(second)
    output(third)
    return 0
}
