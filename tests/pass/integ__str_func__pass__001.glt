// integ__str_func__pass__001.glt
// expect exit 0

// find_focus.glt
// Focused runtime benchmark for the string search primitives (strfind /
// strcontains / strsplitcount) over a longer haystack, used to quantify the
// memchr-based candidate scan in the runtime.

extern luint GetTickCount64 from kernel32 ()
extern int printf from libucrt (string format, luint value)

int main() {
    string haystack = "The quick brown fox jumps over the lazy dog 0123456789 payload tail"

    // absent 3-byte needle: full scan each call
    {
        luint t0 = GetTickCount64()
        int i = 0
        int hits = 0
        while (i < 3000000) {
            if (strfind(haystack, "zzz") < 0) { hits = hits + 1 }
            i++
        }
        printf("find absent 3B         : %llu ms\n", GetTickCount64() - t0)
        printf("  hits=%llu\n", cast<luint>(hits))
    }

    // present 5-byte needle near the end
    {
        luint t0 = GetTickCount64()
        int i = 0
        int hits = 0
        while (i < 3000000) {
            if (strfind(haystack, "payload") >= 0) { hits = hits + 1 }
            i++
        }
        printf("find present 7B        : %llu ms\n", GetTickCount64() - t0)
        printf("  hits=%llu\n", cast<luint>(hits))
    }

    // single byte separator counting
    {
        luint t0 = GetTickCount64()
        int i = 0
        int total = 0
        while (i < 3000000) {
            total = total + strsplitcount(haystack, "o")
            i++
        }
        printf("splitcount 1B          : %llu ms\n", GetTickCount64() - t0)
        printf("  total=%llu\n", cast<luint>(total))
    }
    return 0
}
