// lang__scope__pass__002.glt
// expect output
// 1 2
// 9
// 100

int f(int a) {
    return 1
}

int f(string a) {
    return 2
}

int g(int a) {
    return 100
}

int main() {
    output(f(1), " ", f("x"), "\n")
    {
        int g = 9
        output(g, "\n")
    }
    output(g(1), "\n")
    return 0
}
