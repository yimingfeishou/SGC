// lang__op_overload__pass__016.glt
// expect output
// 5 6 6 4 6 1

struct Foo {
    int v
}

struct Vec {
    int x
    int y
}

int operator << (Foo* self, string text) {
    return self->v
}

int operator >> (Foo* self, string text) {
    return self->v + 1
}

Vec operator + (Vec* a, Vec* b) {
    Vec r = {a->x + b->x, a->y + b->y}
    return r
}

bool operator == (Foo* a, Foo* b) {
    return a->v == b->v
}

void operator += (Foo* self, int n) {
    self->v = self->v + n
}

int main() {
    Foo f = {5}
    output(f << "x", " ", f >> "y", " ")
    f += 1
    output(f.v, " ")
    Vec a = {1, 2}
    Vec b = {3, 4}
    Vec c = a + b
    output(c.x, " ", c.y, " ")
    Foo g = {6}
    bool same = f == g
    output(same ? 1 : 0)
    return 0
}
