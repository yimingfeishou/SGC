// lang__lifecycle__pass__012.glt
// expect output
// 5 4 6 5 1 1

struct Counter {
    int value

    constructor (int start) {
        value = start
    }
}

struct Pair {
    int a
    int b

    constructor () {
        a = 1
        b = 1
    }

    constructor (int x, int y) {
        a = x
        b = y
    }
}

int main() {
    Counter c = Counter(5)
    Pair p = Pair(4, 6)
    Counter d = copy(c)
    Pair q = Pair()
    output(c.value, " ", p.a, " ", p.b, " ", d.value, " ", q.a, " ", q.b)
    return 0
}
