// lang__const__pass__036.glt
// expect output
// 1

const bool flag(int x) {
    return x > 0
}
generics G<T: int> {
    const if (flag(1)) {
        int positive() {
            return 1
        }
    } const else {
        int positive() {
            return 0
        }
    }
}
int main() {
    output(G<int>.positive(), "\n")
    return 0
}
