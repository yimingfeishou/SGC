// lang__align__pass__001.glt
// expect output
// 4 32 8 4 8
// 16 8
// 4 4 4 16
// 4 8 4

struct PlainStruct {
    int a
    double b
}

int counter = 3
const int CONST_VALUE = 5
int table[4] = {1, 2, 3, 4}

int main() {
    int local = 7
    output(size(int), " ", size(string), " ", size(double), " ", align(int), " ", align(double))
    output("\n", size(PlainStruct), " ", align(PlainStruct))
    output("\n", size(local), " ", size(counter), " ", size(CONST_VALUE), " ", size(table))
    output("\n", size(table[0]), " ", size(&local), " ", align(local))
    return 0
}
