// lang__namespace__pass__005.glt
// expect output
// 3 4 8 13 8 13 2 5

namespace geometry {
    namespace plane {
        struct Point {
            int x
            int y
        }

        struct Segment {
            Point start
            Point end
        }

        struct Polyline {
            Point points[2]
        }
    }
}

geometry::plane::Point points[2] = {{3, 4}, {8, 13}}
geometry::plane::Segment path = {{points[0].x, points[0].y}, {points[1].x, points[1].y}}
geometry::plane::Polyline route = {{{1, 2}, {5, 21}}}
geometry::plane::Point* selected = &points[1]

int main() {
    output(path.start.x, " ", path.start.y, " ")
    output(path.end.x, " ", path.end.y, " ")
    output(selected->x, " ", selected->y, " ")
    output(route.points[0].y, " ", route.points[1].x)
    return 0
}
