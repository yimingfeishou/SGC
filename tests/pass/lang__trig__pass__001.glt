// lang__trig__pass__001.glt
// expect output
// 1 1 1 2

struct S {
    int v
    int tag

    copy_constructor (S* other) {
        v = other->v
        tag = other->tag + 1
    }

    move_constructor (S* other) {
        v = other->v
        tag = other->tag + 1
    }

    destructor () {
        return
    }
}

S make(int v) {
    S r
    r.v = v
    r.tag = 0
    return r
}

int take(S value) {
    return value.tag
}

int take_copy(S value) {
    return value.tag
}

int main() {
    S a
    a.v = 1
    a.tag = 0
    output(take(a), " ")
    output(take(move(a)), " ")
    output(take_copy(copy(a)), " ")
    output(take(make(2)))
    return 0
}