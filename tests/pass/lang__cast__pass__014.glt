// lang__cast__pass__014.glt
// expect output
// �
// 100
// 400
// -1 1 -3 3
// -1 8
// 2
// 65
// � � 4294967295 -1
// 3.5
// 3 -3
// 1666666666 705032704

int main() {
    char a = 100
    char b = 100
    output(a + b, "\n")
    uchar u = 200
    int i = -100
    output(u + i, "\n")
    output(300u + 100, "\n")
    output(-7 % 3, " ", 7 % -3, " ", -7 / 2, " ", 7u / 2, "\n")
    output(-1 >> 1, " ", 1lu << 3, "\n")
    bool t = true
    output(t + 1, "\n")
    char c = 'A'
    output(c + 0, "\n")
    output(cast<char>(200), " ", cast<uchar>(-1), " ", cast<uint>(-1), " ", cast<int>(4294967295u), "\n")
    output(cast<double>(7) / 2.0, "\n")
    output(cast<int>(3.99), " ", cast<int>(-3.99), "\n")
    lint big = 5000000000l
    output(big / 3, " ", cast<int>(big), "\n")
    return 0
}
