// sl__array__pass__001.glt
// expect output
// null_length=0 null_cap=0 null_empty=true null_data=true
// len=0 cap=2 empty=true
// after_push=2 10 20
// oob=0 negoob=0
// set_oob_len=2
// front=10 back=20
// reserve_small=true reserve_big=true cap=8 len=2
// reserve_huge=false
// insert_neg=false insert_big=false
// insert_ok=true 10 15 20
// erase_neg=false erase_big=false erase_ok=true len=2
// pop=20 len=1
// resize_neg=false
// resize_up=true len=4 last=0
// resize_down=true len=1 cap=8
// after_clear=0 cap=8
// pop_empty=0 front_empty=0 back_empty=0
// push_from_zero=1 7
// sort_null=false
// array_len=3
// swap=true 2 1 self=true
// swap_null=false

guide "generics.glt"
access namespace sl

int data[3] = {3, 1, 2}

int main() {
    dynamic_array_generic<int>
    sort_generic<int>
    swap_generic<int>

    output("null_length=", length(null), " null_cap=", get_capacity(null), " null_empty=", empty(null), " null_data=", data_ptr(null) == null, "\n")

    dynamic_array arr = dynamic_array(2)
    output("len=", length(&arr), " cap=", get_capacity(&arr), " empty=", empty(&arr), "\n")

    push(&arr, 10)
    push(&arr, 20)
    output("after_push=", length(&arr), " ", get(&arr, 0), " ", get(&arr, 1), "\n")

    output("oob=", get(&arr, 5), " negoob=", get(&arr, -1), "\n")
    set(&arr, 5, 99)
    output("set_oob_len=", length(&arr), "\n")

    output("front=", front(&arr), " back=", back(&arr), "\n")
    output("reserve_small=", reserve(&arr, 1), " reserve_big=", reserve(&arr, 8), " cap=", get_capacity(&arr), " len=", length(&arr), "\n")
    output("reserve_huge=", reserve(&arr, 1073741824), "\n")

    output("insert_neg=", insert(&arr, -1, 5), " insert_big=", insert(&arr, 9, 5), "\n")
    output("insert_ok=", insert(&arr, 1, 15), " ", get(&arr, 0), " ", get(&arr, 1), " ", get(&arr, 2), "\n")
    output("erase_neg=", erase(&arr, -1), " erase_big=", erase(&arr, 9), " erase_ok=", erase(&arr, 0), " len=", length(&arr), "\n")

    output("pop=", pop(&arr), " len=", length(&arr), "\n")
    output("resize_neg=", resize(&arr, -1), "\n")
    output("resize_up=", resize(&arr, 4), " len=", length(&arr), " last=", get(&arr, 3), "\n")
    output("resize_down=", resize(&arr, 1), " len=", length(&arr), " cap=", get_capacity(&arr), "\n")

    clear(&arr)
    output("after_clear=", length(&arr), " cap=", get_capacity(&arr), "\n")

    dynamic_array empty_arr = dynamic_array(0)
    output("pop_empty=", pop(&empty_arr), " front_empty=", front(&empty_arr), " back_empty=", back(&empty_arr), "\n")
    push(&empty_arr, 7)
    output("push_from_zero=", length(&empty_arr), " ", get(&empty_arr, 0), "\n")

    output("sort_null=", sort(null, 3, null), "\n")
    output("array_len=", array_length_generic<int, "data">.array_length(), "\n")

    int a = 1
    int b = 2
    output("swap=", swap(&a, &b), " ", a, " ", b, " self=", swap(&a, &a), "\n")
    output("swap_null=", swap(null, &b), "\n")
    return 0
}
