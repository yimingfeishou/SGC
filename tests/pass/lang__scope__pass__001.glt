// lang__scope__pass__001.glt
// expect output
// 1 200 7 3

@cond DEBUG = 1

@if (is_defined("DEBUG") && DEBUG == 1) {
    struct Point {
        int x
    }

    int flag() {
        return 1
    }

    const int K = 7

    @if (is_defined("INNER")) {
        int offset() {
            return 100
        }
    } @else {
        int offset() {
            return 200
        }
    }
} @else {
    struct Point {
        int y
    }

    int flag() {
        return 2
    }

    int offset() {
        return 300
    }

    const int K = 9
}

int main() {
    Point p = {3}
    output(flag(), " ", offset(), " ", K, " ", p.x)
    return 0
}
