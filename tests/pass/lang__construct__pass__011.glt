// lang__construct__pass__011.glt
// expect output
// 9

generics Box<T> {
    struct Inner {
        T k
        constructor (T v) {
            k = v
        }
    }
    Inner* make(T v) {
        return construct Inner(v)
    }
}
int main() {
    Box<int>.Inner* i = Box<int>.make(9)
    output(i->k)
    destruct i
    return 0
}
