// lang__const__pass__015.glt
// expect output
// 120
// 55
// 128

int factorial(int n) const {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

int sum_to(int n) const {
    int total = 0
    for (int i = 1; i <= n; i++) {
        total = total + i
    }
    return total
}

int pow2_until(int limit) const {
    int value = 1
    while (value < limit) {
        value = value * 2
    }
    return value
}

const int f5 = factorial(5)
const int s10 = sum_to(10)
const int p100 = pow2_until(100)

int main() {
    output(f5, "\n")
    output(s10, "\n")
    output(p100, "\n")
    return 0
}
