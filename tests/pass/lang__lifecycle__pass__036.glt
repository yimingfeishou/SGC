// lang__lifecycle__pass__036.glt
// expect output
// 1 1 2 

struct S {
    int x
    int tag

    copy_constructor (S* other) {
        x = other->x
        tag = 1
    }

    move_constructor (S* other) {
        x = other->x
        tag = 2
    }

    copy_assignment (S* other) {
        x = other->x
        tag = 3
    }

    move_assignment (S* other) {
        x = other->x
        tag = 4
    }

    destructor () {
        return
    }
}

void show(int t) {
    output(t, " ")
}
int main() {
    S a
    a.x = 5
    a.tag = 0
    S* p = &a

    S c = *p
    show(c.tag)

    S d = copy(*p)
    show(d.tag)

    S e = move(*p)
    show(e.tag)
    return 0
}