// lang__cast__pass__007.glt
// expect output
// 6.0
// 4.0
// abc

void sum(double... values) {
    double total = 0.0
    for (int i = 0; i < values.length; i++) {
        total += values[i]
    }
    output(total, "\n")
}

void mixed(char... chars) {
    for (int i = 0; i < chars.length; i++) {
        output(chars[i])
    }
    output("\n")
}

int main() {
    sum(1, 2, 3)
    sum(1.5, 2.5)
    mixed('a', 'b', 'c')
    return 0
}
