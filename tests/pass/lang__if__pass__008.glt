// lang__if__pass__008.glt
// expect output
// 0 [] false

generics Holder<T> {
    struct Box {
        T value

        constructor() {
            const if (T.is_string == true) {
                value = ""
            } const else {
                const if (T.is_bool == true) {
                    value = false
                } const else {
                    value = 0
                }
            }
        }
    }
}

int main() {
    Holder<int>.Box number
    Holder<string>.Box text
    Holder<bool>.Box flag
    output(number.value, " [", text.value, "] ", flag.value, "\n")
    return 0
}
