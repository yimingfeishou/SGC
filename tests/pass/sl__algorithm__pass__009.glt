// sl__algorithm__pass__009.glt
// expect output
// -1 -1 -1 false false 10 20 30

guide "algorithm.glt"
guide "generics.glt"
access namespace sl

hash_table_generic<int, int>

int compare_entry(hash_table_entry left, hash_table_entry right) {
    if (left.key < right.key) {
        return -1
    }
    if (left.key > right.key) {
        return 1
    }
    return 0
}

int main() {
    hash_table_range_generic<int, int>
    binary_search_generic<hash_table_generic<int, int>.hash_table_entry>
    transform_generic<hash_table_generic<int, int>.hash_table_entry>

    hash_table table = hash_table(4)
    set(&table, 1, 10)
    set(&table, 2, 20)
    set(&table, 3, 30)
    iterator it = begin(&table)
    iterator_interface range = make_hash_range(&it)
    hash_table_entry target
    target.key = 2
    target.value = 0

    int first = -1
    int last = -1
    output(binary_search(&range, length(&table), target, &compare_entry), " ")
    output(lower_bound(&range, length(&table), target, &compare_entry), " ")
    output(upper_bound(&range, length(&table), target, &compare_entry), " ")
    output(equal_range(&range, length(&table), target, &compare_entry, &first, &last), " ")

    reverse(&range, length(&table))
    output(rotate(&range, length(&table), 1), " ")

    int one = 0
    int two = 0
    int three = 0
    get(&table, 1, &one)
    get(&table, 2, &two)
    get(&table, 3, &three)
    output(one, " ", two, " ", three)
    return 0
}
