// lang__break_continue__pass__003.glt
// expect output
// 81

const int first_power_over(int limit) {
    int v = 1
    while (true) {
        if (v > limit) {
            break
        }
        v = v * 3
    }
    return v
}
const int v = first_power_over(50)
int main() {
    output(v, "\n")
    return 0
}
