// lang__fileerror__pass__001.glt
// expect output
// 3

int main() {
    file* fp = fileopen("./sgc_definitely_missing_file.txt", "r")
    if (fp != null) {
        fileclose(fp)
        return 2
    }
    int code = fileerror(null)
    output(code)
    if (code == 3) {
        return 0
    }
    return 1
}
