// lang__if__pass__005.glt
// expect output
// 10,hello
//

generics Tuple<T...> {
    void show(T... args) {
        const if (T.length > 0) {
            output(args[0])
        }
        const if (T.length > 1) {
            output(",", args[1])
        }
        output("\n")
    }
}

int main() {
    Tuple<int, string>
    show(10, "hello")
    {
        Tuple<>
        show()
    }
    return 0
}
