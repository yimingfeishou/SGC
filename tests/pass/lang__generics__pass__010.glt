// lang__generics__pass__010.glt
// expect output
// 32

generics FixedArray<T, int N> {
    struct FixedArray {
        T data[N]
    }
    int length() {
        return cast<int>(N)
    }
}
int main() {
    FixedArray<int, 3>.FixedArray a = {{1, 2, 3}}
    output(FixedArray<int, 3>.length())
    output(a.data[1])
    return 0
}
