// sl__generics__pass__004.glt
// expect output
// true false 2 -1 | gamma beta alpha | x x | true 5 p q | false false | true 2 | true 2 p | false false | true 2 | false -1 safe

guide "generics.glt"
access namespace sl

int main() {
    dynamic_array_generic<string>
    dynamic_array names = dynamic_array(2)
    push(&names, "alpha")
    push(&names, "beta")
    push(&names, "gamma")
    output(contains(&names, "beta"), " ", contains(&names, "delta"), " ", index_of(&names, "gamma"), " ", index_of(&names, "delta"), " | ")
    reverse(&names)
    output(get(&names, 0), " ", get(&names, 1), " ", get(&names, 2), " | ")
    fill(&names, "x")
    output(get(&names, 0), " ", get(&names, 2), " | ")

    dynamic_array extra = dynamic_array(2)
    push(&extra, "p")
    push(&extra, "q")
    output(append_array(&names, &extra), " ", length(&names), " ", get(&names, 3), " ", get(&names, 4), " | ")
    output(append_array(&names, null), " ", append_array(null, &extra), " | ")

    dynamic_array empty_one = dynamic_array(1)
    output(append_array(&empty_one, &extra), " ", length(&empty_one), " | ")

    dynamic_array target = dynamic_array(1)
    output(copy_to(&target, &extra), " ", length(&target), " ", get(&target, 0), " | ")
    output(copy_to(null, &extra), " ", copy_to(&target, null), " | ")
    output(copy_to(&target, &target), " ", length(&target), " | ")

    dynamic_array* missing = null
    output(contains(missing, "x"), " ", index_of(missing, "x"), " ")
    reverse(missing)
    fill(missing, "x")
    output("safe")
    return 0
}
