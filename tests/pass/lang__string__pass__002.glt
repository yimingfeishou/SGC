// lang__string__pass__002.glt
// expect exit 0

int main() {
    output(strlen("hello"), " ", strcompare("abc","abd"), " ", strcompare("abc","abc"), " ", strcompare("abd","abc"), "\n")
    output(strcontains("gallt","all"), " ", strcontains("gallt","z"), " ", strcontains("gallt",""), "\n")
    output(strsubstr("hello",1,3), "|", strsubstr("hello",-5,3), "|", strsubstr("hello",3,-1), "|", strsubstr("hello",2,99), "|", strsubstr("hello",99,1), "|\n")
    output(strfind("hello","ll"), " ", strfind("hello","z"), " ", strfind("hello",""), " ", strfind("hello","hello"), "\n")
    output(strreplace("a-b-c","-","+"), " ", strreplace("abc","","X"), " ", strreplace("aaa","aa","b"), "\n")
    output(strupper("Gallt 26"), " ", strlower("Gallt 26"), "\n")
    output("[", strtrim("  text \n"), "]\n")
    output(strcharat("cat",0), " ", strcharat("cat",9), "\n")
    string text = "cat"
    output(strsetchar(text,0,'b'), " ", text, " ", strsetchar(text,9,'z'), "\n")
    output(strsplitcount("a,b,c",","), " ", strsplitcount("abc",""), " ", strsplitcount("",","), "\n")
    output("[", strsplitget("a,b,c",",",1), "]", " [", strsplitget("a,b,c",",",9), "]", " [", strsplitget("a,b,c",",",-1), "]\n")
    string a = "value"
    string b = strcopy(a)
    b = strconcat(b, "!")
    output(a, " ", b, "\n")
    string source = "payload"
    string target = strmove(source)
    output("[", target, "][", source, "]\n")
    return 0
}
