int main() {
    for (int round = 0; round < 20000; round++) {
        string payload = "x"
        for (int i = 0; i < 10; i++) {
            payload = payload + payload
        }
        string* keeper = heap(string, 100)
        for (int i = 0; i < 100; i++) {
            keeper[i] = payload
        }
    }
    output("leaky done")
    return 0
}