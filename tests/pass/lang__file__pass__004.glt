// lang__file__pass__004.glt
// expect output
// Hello Gallt11

int main() {
    file* fp = fileopen("./sgc_file_test.txt", "w")
    if (fp == null) {
        output("open failed")
        return 1
    }
    int n = filewrite(fp, "Hello Gallt")
    fileclose(fp)
    file* rp = fileopen("./sgc_file_test.txt", "r")
    string line = filereadline(rp)
    fileclose(rp)
    output(line, n)
    fileremove("./sgc_file_test.txt")
    return 0
}
