// lang__overload__pass__007.glt
// expect output
// 1 1 2
// 1
// 4

int f(int a) { return 1 }
int f(double a) { return 2 }

int g(uint a) { return 1 }
int g(lint a) { return 2 }

int h(uchar a) { return 3 }
int h(int a) { return 4 }

int main() {
    char c = 'A'
    uint u = 1
    double d = 1.0
    int i = 1
    output(f(c), " ", f(u), " ", f(d), "\n")
    output(g(i), "\n")
    output(h(c), "\n")
    return 0
}
