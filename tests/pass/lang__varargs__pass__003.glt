// lang__varargs__pass__003.glt
// expect output
// 6
// 5
// 10
// 9

int sum_all(int... rest) {
    int total = 0
    for (int i = 0; i < rest.length; i++) {
        total += rest[i]
    }
    return total
}

int plain(int a, int b) {
    return a - b
}

int with_head(int first, int... rest) {
    return first + rest.length
}

int main() {
    int pick(int...)* = &sum_all
    output(pick(1, 2, 3), "\n")
    int fixed(int, int)* = &plain
    output(fixed(9, 4), "\n")
    int leading(int, int...)* = &with_head
    output(leading(10), "\n")
    int empty(int...)* = pick
    output(empty(4, 5), "\n")
    return 0
}
