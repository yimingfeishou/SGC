// lang__function__pass__013.glt
// expect output
// prefix:2 postfix:102

struct Counter {
    int value
}

void operator ++ (Counter* c) {
    c->value = c->value + 1
}

void operator ++ (Counter* c, int dummy) {
    c->value = c->value + 100
}

int main() {
    Counter c = {1}
    ++c
    output("prefix:", c.value)
    c++
    output(" postfix:", c.value)
    return 0
}
