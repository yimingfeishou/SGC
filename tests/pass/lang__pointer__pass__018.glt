// lang__pointer__pass__018.glt
// expect output
// 127

generics Box<T> {
    struct Box {
        int marker
    }
    int tag() {
        return 0
    }
}

generics Box<T*> {
    struct Box {
        int marker
    }
    int tag() {
        return 1
    }
}

generics Box<T[]> {
    struct Box {
        int marker
    }
    int tag() {
        return 2
    }
}

int main() {
    int x = 7
    Box<int*>.Box p
    Box<int[4]>.Box arr
    output(Box<int*>.tag())
    output(Box<int[4]>.tag())
    output(x)
    return 0
}
