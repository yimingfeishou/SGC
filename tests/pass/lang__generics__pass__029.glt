// lang__generics__pass__029.glt
// expect output
// 10

generics Table<int... Ns> {
    int build() {
        int data[4] = {Ns...}
        int total = 0
        for (int i = 0; i < 4; i++) {
            total += data[i]
        }
        return total
    }
}

int main() {
    output(Table<1, 2, 3, 4>.build(), "\n")
    return 0
}
