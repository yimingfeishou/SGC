// lang__struct__pass__014.glt
// expect output
// global local 00 12

struct Point {
    int x
    int y
}

const string GLOBAL_TEXT = "global"

int main() {
    const string local_text = "local"
    Point p = {1, 2}
    const Point origin = {0, 0}
    output(GLOBAL_TEXT, " ", local_text, " ", origin.x, origin.y, " ", p.x, p.y)
    return 0
}
