// lang__type__pass__003.glt
// expect exit 0

int main() {
    output(size(1), " ", size(1l), " ", size(1u), " ", size(1lu), "\n")
    output(size(1.0), " ", size(1.0f), "\n")
    int i = 3.7
    output(i, "\n")
    double d = 3
    output(d, "\n")
    uint x = 1
    int y = -2
    output(x + y, "\n")
    output(-1 < 1u, "\n")
    output("\101", " ", "\x41", " ", '\101', " ", '\x41', "\n")
    output("\x7", "|\n")
    string s = "abc"
    output(s + "def", "\n")
    output(1 + 2 * 3, "\n")
    return 0
}
