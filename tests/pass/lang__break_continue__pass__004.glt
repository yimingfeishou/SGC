// lang__break_continue__pass__004.glt
// expect output
// 0134|0134|024|1

int main() {
    for (int i = 0; i < 5; i++) {
        if (i == 2) {
            continue
        }
        output(i)
    }
    output("|")
    int i = 0
    while (i < 5) {
        if (i == 2) {
            i++
            continue
        }
        output(i)
        i++
    }
    output("|")
    for (int j = 0; j < 5; j++) {
        switch (j) {
            case (1) {
                continue
            }
            case (3) {
                continue
            }
        }
        output(j)
    }
    output("|")
    int k = 0
    while (k < 6) {
        k++
        switch (k) {
            case (2) {
                break
            }
        }
        output(k)
    }
    output("\n")
    return 0
}
