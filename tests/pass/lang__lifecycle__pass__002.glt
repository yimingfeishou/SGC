// lang__lifecycle__pass__002.glt
// expect output
// 120Hello AliceHello Peter

int factorial(int n) {
    if (n <= 1) {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}
string greeting(string name = "Alice") {
    return "Hello " + name
}
int main() {
    int result = factorial(5)
    output(result)
    output(greeting())
    output(greeting("Peter"))
    return 0
}
