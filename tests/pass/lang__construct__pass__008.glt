// lang__construct__pass__008.glt
// expect output
// 5

namespace ns {
    generics Box<T> {
        struct Box {
            T value
            constructor (T v) {
                value = v
            }
        }
    }
}
int main() {
    ns::Box<int>.Box* b = construct ns::Box<int>.Box(5)
    output(b->value)
    destruct b
    return 0
}
