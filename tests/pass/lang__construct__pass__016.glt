// lang__construct__pass__016.glt
// expect output
// 7

struct Inner {
    int k
    constructor (int v) {
        k = v
    }
}
struct Outer {
    Inner inner
    constructor (Inner i) {
        inner = i
    }
}
int main() {
    Inner in = Inner(7)
    Outer* o = construct Outer(in)
    output(o->inner.k)
    destruct o
    return 0
}
