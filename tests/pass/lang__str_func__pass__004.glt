// lang__str_func__pass__004.glt
// expect output
// 5 3 5 3 6 17 6 4 6 5 8 23

generics BlockSource<T: int> {
    emit {
        struct BlockStruct {
            T value
        }

        const T block_base = 3
        T block_value

        T block_add(T value) {
            return value + block_base
        }

        BlockStruct operator +(BlockStruct left, BlockStruct right) {
            BlockStruct result = {left.value + right.value}
            return result
        }

        namespace emitted_block {
            T block_namespaced(T value) {
                return value + block_base
            }
        }

        access namespace emitted_block

        T block_use_namespace(T value) {
            return block_namespaced(value)
        }

        emit "T block_nested() {\n"
        emit "    return 17\n"
        emit "}\n"
    }
}

generics StringSource<T: int> {
    emit "struct StringStruct {\n"
    emit "    T value\n"
    emit "}\n"
    emit "const T string_base = 4\n"
    emit "T string_value\n"
    emit "T string_add(T value) {\n"
    emit "    return value + string_base\n"
    emit "}\n"
    emit "StringStruct operator +(StringStruct left, StringStruct right) {\n"
    emit "    StringStruct result = {left.value + right.value}\n"
    emit "    return result\n"
    emit "}\n"
    emit "namespace emitted_string {\n"
    emit "T string_namespaced(T value) {\n"
    emit "    return value + string_base\n"
    emit "}\n"
    emit "}\n"
    emit "access namespace emitted_string\n"
    emit "T string_use_namespace(T value) {\n"
    emit "    return string_namespaced(value)\n"
    emit "}\n"
    emit "T string_nested() {\n"
    emit "    return 23\n"
    emit "}\n"
}

int main() {
    BlockSource<int>
    block_value = 5
    BlockStruct block_left = {1}
    BlockStruct block_right = {2}
    output(block_value, " ", block_base, " ", block_add(2), " ")
    output((block_left + block_right).value, " ", block_use_namespace(3), " ")
    output(block_nested(), " ")

    StringSource<int>
    string_value = 6
    StringStruct string_left = {2}
    StringStruct string_right = {3}
    output(string_value, " ", string_base, " ", string_add(2), " ")
    output((string_left + string_right).value, " ", string_use_namespace(4), " ")
    output(string_nested())
    return 0
}
