// lang__op_overload__pass__014.glt
// expect output
// 0
// 255
// 255
// -241
// 3840
// 15
// 0
// 15
// 0

struct Bits {
    int value
}

Bits operator & (Bits a, Bits b) {
    Bits r
    r.value = a.value & b.value
    return r
}

Bits operator | (Bits a, Bits b) {
    Bits r
    r.value = a.value | b.value
    return r
}

Bits operator ^ (Bits a, Bits b) {
    Bits r
    r.value = a.value ^ b.value
    return r
}

Bits operator ~ (Bits a) {
    Bits r
    r.value = ~a.value
    return r
}

Bits operator << (Bits a, int n) {
    Bits r
    r.value = a.value << n
    return r
}

Bits operator >> (Bits a, int n) {
    Bits r
    r.value = a.value >> n
    return r
}

void operator &= (Bits* a, Bits b) {
    a->value = a->value & b.value
}

void operator >>= (Bits* a, int n) {
    a->value = a->value >> n
}

Bits operator ?: (bool c, Bits a, Bits b) {
    if (c) {
        return a
    }
    return b
}

int main() {
    Bits p = {240}
    Bits q = {15}
    Bits r = p & q
    output(r.value, "\n")
    Bits o = p | q
    output(o.value, "\n")
    Bits x = p ^ q
    output(x.value, "\n")
    Bits n = ~p
    output(n.value, "\n")
    Bits s = p << 4
    output(s.value, "\n")
    Bits t = p >> 4
    output(t.value, "\n")
    p &= q
    output(p.value, "\n")
    Bits u = {240}
    u >>= 4
    output(u.value, "\n")
    Bits chosen = true ? p : q
    output(chosen.value, "\n")
    return 0
}
