// lang__op_overload__pass__014.glt
// expect output
// 9

struct Counter {
    int value
}

void operator *= (Counter* self, int factor) {
    self->value = self->value * factor
}

void operator /= (Counter* self, int divisor) {
    self->value = self->value / divisor
}

int main() {
    Counter counter = {12}
    counter *= 3
    counter /= 4
    output(counter.value)
    return 0
}
