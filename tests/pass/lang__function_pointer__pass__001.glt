// lang__function_pointer__pass__001.glt
// expect output
// 1555

int add(int a, int b) { return a + b }
int sub(int a, int b) { return a - b }
int op(int, int)*
int main() {
    op = &add
    output(op(10, 5))
    op = &sub
    output(op(10, 5))
    int another(int, int)* = &add
    output(another(2, 3))
    return 0
}
