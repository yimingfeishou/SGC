// lang__lifecycle__pass__018.glt
// expect output
// 1 2 2

struct S {
    int x
    int tag

    copy_constructor (S* other) {
        x = other->x
        tag = 1
    }

    move_constructor (S* other) {
        x = other->x
        tag = 2
    }

    destructor () {
        return
    }
}

S make(int v) {
    S r
    r.x = v
    r.tag = 0
    return r
}

int take(S value) {
    return value.tag
}

int main() {
    S a
    a.x = 1
    a.tag = 0
    output(take(a), " ")
    output(take(make(2)), " ")
    output(take(move(a)))
    return 0
}