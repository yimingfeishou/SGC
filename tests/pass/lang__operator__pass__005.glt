// lang__operator__pass__005.glt
// expect output
// 1

struct Picker {
    bool choose_first
    int first
    int second
}

int operator ?: (Picker p, int a, int b) {
    if (p.choose_first) {
        return a
    }
    return b
}

int main() {
    Picker p = {true, 7, 9}
    output(p ? 1 : 2)
    return 0
}
