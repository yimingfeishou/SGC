// lang__switch__pass__014.glt
// expect output
// 2 1

int main() {
    int r = 0
    for (int i = 0; i < 5; i++) {
        switch (i) {
            case (1) {
                continue
            }
            case (3) {
                break
            }
        }
        r = r * 10 + i
    }
    output(r)
    output(" ")
    int k = 0
    while (k < 6) {
        k++
        switch (k) {
            case (2) {
                break
            }
        }
        output(k)
    }
    return 0
}