// sl__array__pass__002.glt
// expect output
// empty_pop=false oob_get=false front=false
// len=1 get0=true
// resize3=false false

guide "generics.glt"
access namespace sl

int main() {
    dynamic_array_generic<bool>
    dynamic_array bools = dynamic_array(0)
    output("empty_pop=", pop(&bools), " oob_get=", get(&bools, 3), " front=", front(&bools), "\n")
    push(&bools, true)
    output("len=", length(&bools), " get0=", get(&bools, 0), "\n")
    resize(&bools, 3)
    output("resize3=", get(&bools, 2), " ", get(&bools, 1), "\n")
    return 0
}
