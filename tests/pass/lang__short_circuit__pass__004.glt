// lang__short_circuit__pass__004.glt
// expect output
// 0 1
// 1 1
// 1 0
// 2 1
// 0 1 1 0

int calls = 0

bool touch() {
    calls = calls + 1
    return true
}

bool or_and(bool a, bool b, bool c, bool d) {
    return a || (b && (c || d))
}

int main() {
    bool short1 = true || touch()
    output(calls, " ", short1 ? 1 : 0, "\n")
    bool short2 = false || touch()
    output(calls, " ", short2 ? 1 : 0, "\n")
    bool short3 = false && touch()
    output(calls, " ", short3 ? 1 : 0, "\n")
    bool short4 = true && touch()
    output(calls, " ", short4 ? 1 : 0, "\n")
    output(or_and(false, true, false, false) ? 1 : 0, " ")
    output(or_and(true, false, false, false) ? 1 : 0, " ")
    output(or_and(false, true, true, false) ? 1 : 0, " ")
    output(or_and(false, false, false, false) ? 1 : 0, "\n")
    return 0
}