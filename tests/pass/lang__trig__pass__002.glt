// lang__trig__pass__002.glt
// expect output
// 25
// 36
// 120
// ababab
// 7

int square(int x) const {
    return x ** 2
}

int factorial(int n) const {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

string repeat(string s, int n) const {
    string r = ""
    for (int i = 0; i < n; i++) {
        r = r + s
    }
    return r
}

string make_getter(string type, string name) const {
    return type + " get_" + name + "() {\n    return " + name + "\n}"
}

generics Emiter<T: int, T N> {
    emit make_getter(T.typename, N)
}

const int result = square(5)
int runtime_value = square(6)

int main() {
    output(result, "\n")
    output(runtime_value, "\n")
    output(factorial(5), "\n")
    output(repeat("ab", 3), "\n")
    output(Emiter<int, 7>.get_7(), "\n")
    return 0
}
