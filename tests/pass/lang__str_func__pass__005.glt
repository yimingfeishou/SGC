int classify(string text, int flag) {
    string copy = text
    if (flag == 0) {
        return 0
    }
    if (flag == 1) {
        return 1
    }
    for (int i = 0; i < 3; i++) {
        string extra = copy + "!"
        if (i == 1) {
            return 2
        }
    }
    return 3
}

int main() {
    string payload = "abc"
    int total = 0
    for (int i = 0; i < 4; i++) {
        total = total + classify(payload, i)
    }
    output(total)
    return 0
}
