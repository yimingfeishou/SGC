// lang__str_func__pass__007.glt
// expect output
// 11
// ALPHA|beta|beta
// true
// true

int main() {
    string path = "tests/work/t30b_string_file.txt"
    file* writer = fileopen(path, "wb")
    if (writer == null) {
        output("open failed\n")
        return 1
    }
    int written = strwritefile(writer, "alpha\n")
    written += strwritefile(writer, "beta\n")
    fileclose(writer)
    output(written, "\n")
    file* reader = fileopen(path, "rb")
    string first = filereadline(reader)
    string second = filereadline(reader)
    fileclose(reader)
    output(strupper(first), "|", strlower("BETA"), "|", second, "\n")
    output(strcompare(first, second) < 0, "\n")
    output(filesize(path) == written, "\n")
    fileremove(path)
    return 0
}
