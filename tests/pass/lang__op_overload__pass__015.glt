// lang__op_overload__pass__015.glt
// expect output
// 2 102

struct Counter {
    int value
}

void operator ++ (Counter* c) {
    c->value = c->value + 1
}

void operator ++ (Counter* c, string placeholder) {
    c->value = c->value + 100
}

int main() {
    Counter c = {1}
    ++c
    output(c.value)
    c++
    output(" ", c.value)
    return 0
}
