// lang__lifecycle__pass__004.glt
// expect output
// 1 2 3 4 5

struct Point {
    int x
    int y

    constructor (int ix, int iy) {
        x = ix
        y = iy
    }
}

struct Tracer {
    int n

    constructor () {
        n = 0
    }

    constructor (int v) {
        n = v
    }
}

Point origin = Point(1, 2)
Point corner = {3, 4}
Tracer counter = Tracer(5)

int main() {
    output(origin.x, " ", origin.y, " ", corner.x, " ", corner.y, " ", counter.n)
    return 0
}
