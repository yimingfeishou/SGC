// lang__operator__pass__007.glt
// expect output
// true
// cd
// n
// 1.0
// 3 4

struct Point {
    int x
    int y
}

int main() {
    int a = 1
    int* p = &a
    int* q = null
    int* r = true ? p : q
    output(r != null, "\n")
    string s1 = "ab"
    string s2 = "cd"
    string s = false ? s1 : s2
    output(s, "\n")
    bool b = false
    output(b ? "y" : "n", "\n")
    double d = 1
    double e = 2.5
    output(true ? d : e, "\n")
    Point origin = {3, 4}
    Point other = {5, 6}
    Point picked = true ? origin : other
    output(picked.x, " ", picked.y, "\n")
    return 0
}
