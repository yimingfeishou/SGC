// lang__generics__pass__049.glt
// expect output
// 4

generics Inner<U, string tag> {
    int probe() { return size(U) }
}

generics Outer<T, string member> {
    int go() {
        return Inner<T, member>.probe()
    }
}

struct S { int x }

int main() {
    Outer<S, "x">
    output(go(), "\n")
    return 0
}
