// lang__op_overload__pass__013.glt
// expect output
// 10
// 0
// 1
// 0
// 2
// 3
// 2
// 5
// 7
// 9
// true
// cd
// 1.0
// 5 6
// 3 4
// 0 0

struct Point {
    int x
    int y
}

int main() {
    output(2 + 3 << 1, "\n")
    output(1 << 2 & 3, "\n")
    output(1 & 3 == 3, "\n")
    output(4 | 1 & 2, "\n")
    output(1 ? 2 : 3 ? 4 : 5, "\n")
    output(0 ? 1 : 0 ? 2 : 3, "\n")
    output(1 + 1 ? 2 : 3, "\n")
    output(1 | 0 ? 5 : 6, "\n")
    output(true && 1 ? 7 : 8, "\n")
    output(1 == 1 || 0 ? 9 : 10, "\n")
    int a = 1
    int* p = &a
    int* q = null
    int* r = true ? p : q
    output(r != null, "\n")
    string s1 = "ab"
    string s2 = "cd"
    output(false ? s1 : s2, "\n")
    double d = 1
    output(true ? d : 2.5, "\n")
    Point first = {3, 4}
    Point second = {5, 6}
    Point picked = false ? first : second
    output(picked.x, " ", picked.y, "\n")
    Point other = true ? first : second
    output(other.x, " ", other.y, "\n")
    int counter = 0
    int lazy = false ? counter = 1 : 0
    output(counter, " ", lazy, "\n")
    return 0
}
