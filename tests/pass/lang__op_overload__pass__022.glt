// lang__op_overload__pass__022.glt
// expect output
// false calls=1
// true calls=2

struct Flag {
    int v
}

int calls = 0

Flag make(int value) {
    calls++
    Flag f = {value}
    return f
}

bool operator && (Flag a, Flag b) {
    return a.v == 1 && b.v == 1
}

bool operator || (Flag a, Flag b) {
    return a.v == 1 || b.v == 1
}

int main() {
    Flag zero = {0}
    Flag one = {1}
    bool r1 = zero && make(1)
    output(r1, " calls=", calls, "\n")
    bool r2 = one || make(0)
    output(r2, " calls=", calls, "\n")
    return 0
}
