// lang__overload__pass__004.glt
// expect output
// 1 3 4
// 100 104

int pick(int value) {
    return 1
}

int pick(int value, int... rest) {
    return 2 + rest.length
}

int count(int... rest) {
    return 100 + rest.length
}

int main() {
    output(pick(1), " ", pick(1, 2), " ", pick(1, 2, 3), "\n")
    output(count(), " ", count(1, 2, 3, 4), "\n")
    return 0
}
