// lang__file__pass__006.glt
// expect output
// true -1 false false
// true 5 7 13 true true
// [Hello Gallt][][] true 13 true 72 true 116 0 true
// 4 88 true true true true true true true

int main() {
    file* missing = fileopen("./no_such_dir_xyz/no_such_file.txt", "r")
    output(missing == null)
    output(" ", filesize("./no_such_dir_xyz/no_such_file.txt"))
    output(" ", fileexists("./no_such_dir_xyz/no_such_file.txt"))
    output(" ", fileremove("./no_such_dir_xyz/no_such_file.txt"))

    file* fp = fileopen("./audit_io.txt", "w")
    output("\n", fp != null)
    output(" ", filewrite(fp, "Hello"), " ", filewriteline(fp, " Gallt"))
    output(" ", filetell(fp))
    output(" ", fileflush(fp), " ", fileclose(fp))

    file* rp = fileopen("./audit_io.txt", "r")
    output("\n[", filereadline(rp), "][", filereadline(rp), "][", filereadline(rp), "]")
    output(" ", fileeof(rp), " ", filetell(rp))
    bool seeked = fileseek(rp, 0, 0)
    output(" ", seeked, " ", filegetc(rp))
    output(" ", fileseek(rp, -3, 2), " ", filegetc(rp), " ", fileerror(rp))
    output(" ", fileclose(rp))

    file* bp = fileopen("./audit_io.bin", "wb")
    char data[4] = {'G', 'a', 'l', 't'}
    output("\n", filewritebytes(bp, data, 4), " ", fileputc(bp, 'X'))
    output(" ", fileclose(bp))
    output(" ", filecopy("./audit_io.bin", "./audit_io2.bin"))
    output(" ", filerename("./audit_io2.bin", "./audit_io3.bin"))
    output(" ", fileexists("./audit_io3.bin"), " ", fileremove("./audit_io3.bin"))
    output(" ", filemkdir("./audit_dir"), " ", fileremovedir("./audit_dir"))
    return 0
}
