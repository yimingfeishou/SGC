// lang__init_order__pass__003.glt
// expect output
// 3440

int order

int record(int value) {
    order = order * 10 + value
    return value
}

int pure_value = 1 + 2
int effect_value = record(4)
int zero_value

int main() {
    output(pure_value)
    output(effect_value)
    output(order)
    output(zero_value)
    return 0
}