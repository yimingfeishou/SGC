// lang__struct__pass__011.glt
// expect output
// 5 0 tag

int main() {
    struct Counter {
        int value

        constructor () {
            value = 0
        }

        constructor (int start) {
            value = start
        }
    }

    struct Named {
        string label
    }

    Counter c = Counter(5)
    Counter d
    Named n = {"tag"}
    output(c.value, " ", d.value, " ", n.label)
    return 0
}
