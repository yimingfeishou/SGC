// lang__lifecycle__pass__006.glt
// expect output
// 5five5five

struct Sample {
    int value
    string label
    copy_constructor (Sample* other) {
        value = other->value
        label = other->label
    }
}
int main() {
    Sample first = {5, "five"}
    Sample second = copy(first)
    output(first.value, first.label, second.value, second.label)
    return 0
}
