// lang__namespace__pass__011.glt
// expect output
// 7 7 5 3 9

namespace shapes {
    int plain() {
        return 3
    }

    generics Box<T> {
        struct Box {
            T value
        }

        T get(Box item) {
            return item.value
        }

        T first(Box item) {
            return get(item)
        }
    }

    struct Holder {
        int slot
    }
}

addition namespace shapes {
    generics Wrap<T> {
        struct Wrap {
            T value
        }

        T pick(Wrap item) {
            return item.value
        }
    }
}

access namespace shapes

int main() {
    Box<int>.Box b = {7}
    Wrap<int>.Wrap w = {5}
    Holder h = {9}
    output(Box<int>.get(b), " ", Box<int>.first(b), " ", Wrap<int>.pick(w), " ", plain(), " ", h.slot)
    return 0
}
