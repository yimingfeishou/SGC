// lang__str_func__pass__002.glt
// expect output
// 5 7 6 5 changed original 7 0

string make(string value) {
    return value
}

int take(string text) {
    return strlen(text)
}

string mutate(string text) {
    text = "changed"
    return text
}

int main() {
    string a = "hello"
    output(take(a), " ")
    output(take("literal"), " ")
    output(take(a + "!"), " ")
    output(take(make("world")), " ")
    string b = "original"
    output(mutate(b), " ")
    output(b, " ")
    string c = "move-me"
    output(take(move(c)), " ")
    output(strlen(c))
    return 0
}
