// integ__multi_file__pass__001.glt
// expect output
// add=5 pair=4/9 sum=13 len=5 text=positive
// hi!

// Importing program for the --gallt-abi / -GA test. The extern declarations
// below use the native Gallt ABI of the provider library: string parameters
// are passed as gallt_string pointers and struct returns use the same sret
// convention as the exported definitions.

clib("gallt_abi_provider.lib")

struct Pair {
    int first
    int second
}

extern int add from gallt_abi_provider (int a, int b)
extern Pair make_pair from gallt_abi_provider (int a, int b)
extern int pair_sum from gallt_abi_provider (Pair pair)
extern int text_len from gallt_abi_provider (string text)
extern void shout from gallt_abi_provider (string text)
extern string make_text from gallt_abi_provider (int n)

int main() {
    Pair pair = make_pair(4, 9)
    string message = "hello"
    output("add=", add(2, 3), " pair=", pair.first, "/", pair.second, " sum=", pair_sum(pair), " len=", text_len(message), " text=", make_text(1), "\n")
    shout("hi")
    return 0
}
