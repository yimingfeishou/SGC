// lang__nested__pass__009.glt
// expect output
// 1 1 0
// 10
// 11

int deep(bool a, bool b, bool c, bool d) {
    if (a || (b && (c || d))) {
        return 1
    }
    int total = 0
    while (b && (a || c)) {
        total = total + 1
        break
    }
    for (int i = 0; i < 3 && (a || d); i++) {
        total = total + 10
        if (i == 0) {
            break
        }
    }
    return total
}

bool pick(bool a, bool b) {
    return a ? (b || a) : (a && b)
}

bool nested_call(bool a, bool b) {
    return pick(a || b, a && b)
}

int main() {
    output(deep(true, false, false, false), " ", deep(false, true, false, true), " ", deep(false, false, false, false), "\n")
    output(pick(true, false) ? 1 : 0, pick(false, true) ? 1 : 0, "\n")
    output(nested_call(true, false) ? 1 : 0, nested_call(false, true) ? 1 : 0, "\n")
    return 0
}