// sl__generics__pass__003.glt
// expect output
// false false true true 123 true 21 false 0 0 true 0 0 0 0 false false false false true 0 2 true 2 20 10 20 0 0 false true 3 11 true false 2 11 false true 4 0 false true 0 true true

guide "generics.glt"
access namespace sl

int compare_int(int a, int b) {
    if (a < b) {
        return -1
    }
    if (a > b) {
        return 1
    }
    return 0
}

int main() {
    int data[3] = {3, 1, 2}
    sort_generic<int>
    output(sort(null, 3, &compare_int), " ")
    output(sort(data, 0, null), " ")
    output(sort(data, 0, &compare_int), " ")
    output(sort(data, 3, &compare_int), " ")
    output(data[0], data[1], data[2], " ")

    swap_generic<int>
    int a = 1
    int b = 2
    output(swap(&a, &b), " ", a, b, " ")
    output(swap(null, &b), " ")

    dynamic_array_generic<int>
    dynamic_array* missing = null
    output(length(missing), " ", get_capacity(missing), " ", empty(missing), " ")
    output(get(missing, 0), " ", front(missing), " ", back(missing), " ", pop(missing), " ")
    output(insert(missing, 0, 1), " ", erase(missing, 0), " ", resize(missing, 1), " ")
    output(reserve(missing, 4), " ", data_ptr(missing) == null, " ")

    dynamic_array arr = dynamic_array(2)
    output(length(&arr), " ", get_capacity(&arr), " ", empty(&arr), " ")
    push(&arr, 10)
    push(&arr, 20)
    output(length(&arr), " ", get(&arr, 1), " ", front(&arr), " ", back(&arr), " ")
    output(get(&arr, -1), " ", get(&arr, 5), " ")
    output(insert(&arr, 3, 5), " ", insert(&arr, 1, 11), " ", length(&arr), " ", get(&arr, 1), " ")
    output(erase(&arr, 0), " ", erase(&arr, 9), " ", length(&arr), " ", front(&arr), " ")
    output(resize(&arr, -1), " ", resize(&arr, 4), " ", length(&arr), " ", get(&arr, 3), " ")
    output(reserve(&arr, 1073741824), " ", reserve(&arr, 1), " ")
    clear(&arr)
    output(length(&arr), " ", empty(&arr), " ", get_capacity(&arr) >= 2)
    return 0
}
