// lang__struct__pass__013.glt
// expect output
// n=2
// 1,2
// 3,4
// n=0
// 2:alpha
// 0:

struct Point {
    int x
    int y
}

void show(Point... pts) {
    output("n=", pts.length, "\n")
    for (int i = 0; i < pts.length; i++) {
        output(pts[i].x, ",", pts[i].y, "\n")
    }
}

void verbose(string... words) {
    output(words.length, ":", words.first, "\n")
}

int main() {
    Point p1 = {1, 2}
    Point p2 = {3, 4}
    show(p1, p2)
    show()
    verbose("alpha", "beta")
    verbose()
    return 0
}
