// lang__struct__pass__003.glt
// expect output
// 34677

struct Point {
    int x
    int y
}

generics Single<T> {
    T value
}

generics ArraySingle<T, int N> {
    T value[N]
}

generics FixedSingle<T> {
    const T value = 1
}

int point_form() {
    Single<Point> point = {3, 4}
    output(Single<Point>.value.x)
    output(Single<Point>.value.y)
    return 0
}

int array_form() {
    ArraySingle<int, 3> values = {5, 6, 7}
    output(ArraySingle<int, 3>.value[1])
    output(ArraySingle<int, 3>.value[2])
    return 0
}

int const_form() {
    FixedSingle<int> value = 7
    output(FixedSingle<int>.value)
    return 0
}

int main() {
    point_form()
    array_form()
    const_form()
    return 0
}
