// lang__switch__pass__001.glt
// expect output
// value is 2

int main() {
    int x = 2
    switch (x) {
        case (1) {
            output("value is 1\n")
        } case (2) {
            output("value is 2\n")
        } case (3) {
            output("value is 3\n")
        }
        output("unknown value\n")
    }
    return 0
}
