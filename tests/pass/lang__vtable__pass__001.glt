// lang__vtable__pass__001.glt
// expect output
// Dog [Hello] says: Woof!I am a DogCat [Hi] says: Meow~I am a CatCat [Goodnight] says: Meow~

struct AnimalVTable {
    void speak(string)*
    string get_name()*
}

struct Animal {
    AnimalVTable* vtable
    string name
}

void dog_speak(string msg) {
    output("Dog [", msg, "] says: Woof!")
}

string dog_get_name() {
    return "Dog"
}

void cat_speak(string msg) {
    output("Cat [", msg, "] says: Meow~")
}

string cat_get_name() {
    return "Cat"
}

AnimalVTable dog_vtable = {&dog_speak, &dog_get_name}
AnimalVTable cat_vtable = {&cat_speak, &cat_get_name}

Animal create_dog(string name) {
    Animal dog
    dog.vtable = &dog_vtable
    dog.name = name
    return dog
}

Animal create_cat(string name) {
    Animal cat
    cat.vtable = &cat_vtable
    cat.name = name
    return cat
}

void make_animal_speak(Animal* animal, string msg) {
    animal->vtable->speak(msg)
    string name = animal->vtable->get_name()
    output("I am a ", name)
}

int main() {
    Animal dog = create_dog("Buddy")
    Animal cat = create_cat("Kitty")

    make_animal_speak(&dog, "Hello")
    make_animal_speak(&cat, "Hi")

    cat.vtable->speak("Goodnight")

    return 0
}
