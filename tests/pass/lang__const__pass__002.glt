// lang__const__pass__002.glt
// expect output
// 72 65 65 65 260

const char hex_char = '\x48'
const char oct_char = '\101'
const int hex_value = '\x41'
const int oct_value = '\101'
int table[hex_value]

int main() {
    output(cast<int>(hex_char), " ", cast<int>(oct_char), " ", hex_value, " ", oct_value, " ", size(table))
    return 0
}
