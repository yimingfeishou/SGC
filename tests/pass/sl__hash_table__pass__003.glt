// sl__hash_table__pass__003.glt
// expect output
// total 285 len 10 cap 16 | after erase 9 contains5 false | cleared true

guide "generics.glt"
access namespace sl

int main() {
    hash_table_generic<int, int>
    hash_table counts = hash_table(4)
    for (int i = 0; i < 10; i++) {
        set(&counts, i, i * i)
    }
    int total = 0
    int number = 0
    for (int i = 0; i < 10; i++) {
        if (get(&counts, i, &number)) {
            total = total + number
        }
    }
    output("total ", total, " len ", length(&counts), " cap ", get_capacity(&counts), " | ")
    erase(&counts, 5)
    output("after erase ", length(&counts), " contains5 ", contains(&counts, 5), " | ")
    clear(&counts)
    output("cleared ", empty(&counts))
    return 0
}
