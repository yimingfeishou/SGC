// lang__generics__pass__026.glt
// expect output
// 7 0
// 4 5 6

generics First<int... Ns> {
    int first() {
        const if (Ns.empty) {
            return 0
        }
        return Ns.first
    }

    int at(int index) {
        if (index == 0) {
            return Ns[0]
        }
        if (index == 1) {
            return Ns.get(1)
        }
        return Ns.get(2)
    }
}

int main() {
    output(First<7, 8, 9>.first(), " ", First<>.first(), "\n")
    output(First<4, 5, 6>.at(0), " ", First<4, 5, 6>.at(1), " ", First<4, 5, 6>.at(9), "\n")
    return 0
}
