// lang__generics__pass__031.glt
// expect output
// int
// int
// double
// int
// 2
// 2

generics Inner<A> {
    string tag() {
        return A.typename
    }
}

generics Project<T...> {
    string head() {
        return T[0].typename
    }

    string first_name() {
        return T.first.typename
    }

    string last_name() {
        return T.last.typename
    }

    string inner_head() {
        return Inner<T[0]>.tag()
    }

    emit {
        int emit_size() {
            return T.length
        }
    }

    emit "int emit_named_" + T[0].typename + "() {\n"
    emit "    return " + T.length + "\n"
    emit "}\n"
}

int main() {
    output(Project<int, double>.head(), "\n")
    output(Project<int, double>.first_name(), "\n")
    output(Project<int, double>.last_name(), "\n")
    output(Project<int, double>.inner_head(), "\n")
    output(Project<int, double>.emit_size(), "\n")
    Project<int, double>
    output(emit_named_int(), "\n")
    return 0
}
