// lang__str_split__pass__001.glt
// expect output
// idx 0=[a]
// idx 1=[b]
// idx 2=[c]
// idx 3=[]
// sep2 idx 0=[x]
// sep2 idx 1=[y]
// sep2 idx 2=[z]
// sep2 idx 3=[]
// single=[abc][]
// emptysep=[abc][]

int main() {
    string s = "a,b,c"
    for (int i = 0; i < 4; i++) {
        output("idx ", i, "=[", strsplitget(s, ",", i), "]\n")
    }
    string t = "x--y--z"
    for (int j = 0; j < 4; j++) {
        output("sep2 idx ", j, "=[", strsplitget(t, "--", j), "]\n")
    }
    output("single=[", strsplitget("abc", ",", 0), "][", strsplitget("abc", ",", 1), "]\n")
    output("emptysep=[", strsplitget("abc", "", 0), "][", strsplitget("abc", "", 1), "]\n")
    return 0
}