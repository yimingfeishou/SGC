// lang__str_func__pass__011.glt
// expect output
// abab xxx abababab abababab abab

int main() {
    string s = "ab"
    s = s + s
    output(s)
    string t = "x"
    t = t + t + t
    output(" ", t)
    output(" ", strconcat(s, s))
    string u = strcopy(s)
    u = strconcat(u, u)
    output(" ", u, " ", s)
    return 0
}
