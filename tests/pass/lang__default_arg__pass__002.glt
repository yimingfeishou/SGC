// lang__default_arg__pass__002.glt
// expect output
// hello Alice hello Bob 111 103 6

string greeting(string name = "Alice") {
    return "hello " + name
}

int add(int a, int b = 10, int c = 100) {
    return a + b + c
}

int main() {
    output(greeting(), " ", greeting("Bob"))
    output(" ", add(1), " ", add(1, 2), " ", add(1, 2, 3))
    return 0
}
