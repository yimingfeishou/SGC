// sl__generics__pass__008.glt
// expect output
// true true

guide "generics.glt"
access namespace sl

int main() {
    dynamic_array_generic<string>
    dynamic_array names = dynamic_array(2)
    push(&names, "alpha")
    output(contains(&names, "alpha"), " ")

    dynamic_array_generic<int>.dynamic_array nums = dynamic_array_generic<int>.dynamic_array(2)
    dynamic_array_generic<int>.push(&nums, 3)
    output(dynamic_array_generic<int>.contains(&nums, 3))
    return 0
}
