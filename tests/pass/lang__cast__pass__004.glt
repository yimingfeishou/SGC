// lang__cast__pass__004.glt
// expect output
// true true true

int main() {
    int value = 7
    int* handle = &value
    int narrow = bitcopy<int>(handle)
    lint wide = bitcopy<lint>(handle)
    uint narrow_unsigned = bitcopy<uint>(handle)
    luint wide_unsigned = bitcopy<luint>(handle)
    output(wide != 0, " ", wide_unsigned != 0, " ", cast<uint>(narrow) == narrow_unsigned)
    return 0
}
