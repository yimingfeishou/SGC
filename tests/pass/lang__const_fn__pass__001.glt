// lang__const_fn__pass__001.glt
// expect output
// -4
// 268435455
// 48

int arith_shift(int value, int count) const {
    return value >> count
}

int logical_shift(uint value, int count) const {
    return value >> count
}

int left_shift(int value, int count) const {
    return value << count
}

const int neg_right = arith_shift(-16, 2)
const uint unsigned_right = logical_shift(4294967280u, 4)
const int left_value = left_shift(3, 4)

int main() {
    output(neg_right, "\n")
    output(unsigned_right, "\n")
    output(left_value, "\n")
    return 0
}
