// lang__const__pass__039.glt
// expect output
// 1

bool flag(int x) const {
    return x > 0
}
generics G<T: int> {
    const if (flag(1)) {
        emit {
            int positive() {
                return 1
            }
        }
    } const else {
        emit {
            int positive() {
                return 0
            }
        }
    }
}
int main() {
    output(G<int>.positive(), "\n")
    return 0
}
