// lang__function__pass__050.glt
// expect output
// out

void error_pack(int... values) {
    erroutput(values..., "\n")
}

int main() {
    output("out")
    erroutput("mixed:", 7, " ", 2.5, " ", true, "\n")
    erroutput("types:", 7, " ", 8u, " ", 9l, " ", 10lu, " ", 11s, " ", 12su, " ", 2.5f, " ", 3.5, " ", 'Z', " ", true, "\n")
    error_pack(1, 2, 3)
    void write_address(string)* = &erroutput
    void write_value(string)* = erroutput
    write_address("address\n")
    write_value("value\n")
    return 0
}
