struct example1 {
    float f
    double d
}
struct example2 {
    double d
    float f
}
struct example3 {
    bool b
    double d
    char c
}
int main() {
    example1 a
    example2 b
    example3 c
    output(size(a), align(a))
    output(size(b), align(b))
    output(size(c), align(c))
    return 0
}
