// lang__const__pass__030.glt
// expect output
// 34 34

generics Inner<U, int N> {
    int value() { return N * 10 + size(U) }
}

generics Outer<T, int count> {
    int go() {
        return Inner<T, count>.value()
    }
}

struct S { int x }

int main() {
    Outer<S, 3>
    Inner<S, 3>
    output(go(), " ", value(), "\n")
    return 0
}
