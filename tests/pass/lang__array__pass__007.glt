// lang__array__pass__007.glt
// expect output
// 1 2

generics Grid<T, U> {
    struct Grid {
        int marker
    }
    int tag() {
        return 0
    }
}

generics Grid<int[], U> {
    struct Grid {
        int marker
    }
    int tag() {
        return 2
    }
}

generics Grid<int[3], int> {
    struct Grid {
        int marker
    }
    int tag() {
        return 1
    }
}

int main() {
    Grid<int[3], int>.Grid g
    Grid<int[4], double>.Grid h
    output(Grid<int[3], int>.tag(), " ", Grid<int[4], double>.tag())
    return 0
}
