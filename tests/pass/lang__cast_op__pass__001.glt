// lang__cast_op__pass__001.glt
// expect output
// 1007

namespace ns {
    struct S {
        int v
    }

    struct W {
        int v
    }

    operator W (S s) {
        W w = {s.v + 1000}
        return w
    }
}

int main() {
    ns::S s = {7}
    ns::W w = cast<ns::W>(s)
    output(w.v)
    return 0
}