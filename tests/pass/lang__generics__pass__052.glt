// lang__generics__pass__052.glt
// expect output
// 9
// 9

int square(int x) const {
    return x * x
}
int plus(int a, int b) const {
    return a + b
}
generics G<T: int, T N> {
    int value() {
        return N
    }
}
int main() {
    output(G<int, plus(square(2), 5)>.value(), "\n")
    output(G<int, square(2) + 5>.value(), "\n")
    return 0
}
