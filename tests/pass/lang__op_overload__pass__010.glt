// lang__op_overload__pass__010.glt
// expect output
// 101111110

struct Counter {
    int v
}

void operator ++ (Counter* c) {
    c->v += 1
}

void operator ++ (Counter* c, int) {
    c->v += 10
}

void operator -- (Counter* c) {
    c->v -= 1
}

int main() {
    Counter c = {100}
    ++c
    output(c.v)
    c++
    output(c.v)
    --c
    output(c.v)
    return 0
}
