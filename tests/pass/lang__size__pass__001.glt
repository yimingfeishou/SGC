// lang__size__pass__001.glt
// expect output
// true true 123

int main() {
    int* invalid = heap(int, -5)
    output(invalid == null)
    int* zero = heap(int, 0)
    output(" ", zero != null)
    free(invalid)
    free(zero)
    int* valid = heap(int, 3)
    valid[0] = 1
    valid[1] = 2
    valid[2] = 3
    output(" ", valid[0], valid[1], valid[2])
    free(valid)
    return 0
}
