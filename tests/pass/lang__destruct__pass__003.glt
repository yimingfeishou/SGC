// lang__destruct__pass__003.glt
// expect output
// destroyed 73

struct Tracked {
    int value

    destructor () {
        output("destroyed ", value)
        value = 0
    }
}

int main() {
    Tracked* item = heap(Tracked)
    item->value = 73
    destruct item

    Tracked* empty = null
    destruct empty

    return 0
}
