// lang__op_overload__pass__012.glt
// expect output
// 8 14 6 -13
// 24 6
// 16
// 4
// 2
// 10
// 11
// 1099511627776
// 2
// -4
// 15
// true
// true

int main() {
    int a = 12
    int b = 10
    output(a & b, " ", a | b, " ", a ^ b, " ", ~a, "\n")
    output(a << 1, " ", a >> 1, "\n")
    int c = 1
    c <<= 4
    output(c, "\n")
    c >>= 2
    output(c, "\n")
    int d = 6
    d &= 3
    output(d, "\n")
    d |= 8
    output(d, "\n")
    d ^= 1
    output(d, "\n")
    lint wide = 1
    wide <<= 40
    output(wide, "\n")
    luint unsigned_wide = 8
    unsigned_wide >>= 2
    output(unsigned_wide, "\n")
    int negative = -8
    negative >>= 1
    output(negative, "\n")
    luint logical = 0
    logical = logical - 1
    logical >>= 60
    output(logical, "\n")
    uchar bits = 255
    bits &= 15
    output(bits == 15, "\n")
    bool flags = true
    output(flags | false, "\n")
    return 0
}
