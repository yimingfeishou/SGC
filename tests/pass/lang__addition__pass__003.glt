// lang__addition__pass__003.glt
// expect output
// 1 5 3

namespace ns {
    int pick(int x) {
        return 1
    }
}

addition namespace ns {
    int pick(int x, int y) {
        return x + y
    }
}

addition namespace ns {
    int pick(char x) {
        return 3
    }
}

int main() {
    output(ns::pick(5), " ", ns::pick(2, 3), " ", ns::pick('a'))
    return 0
}
