// sl__str_parse__pass__001.glt
// expect output
// stdlib_char_ptr_string: ok (27 checks)

guide "common.glt"
access namespace sl

int checks = 0
int failures = 0

void check(bool condition, string label) {
    if (condition) {
        checks = checks + 1
        return
    }
    output("FAIL: ", label, "\n")
    failures = failures + 1
}

int main() {
    check(string_equals(char_ptr_to_string(null), ""), "char_ptr_to_string null")

    char* raw = heap(char, 6)
    raw[0] = 'G'
    raw[1] = 'a'
    raw[2] = 'l'
    raw[3] = 'l'
    raw[4] = 't'
    raw[5] = '\0'
    check(string_equals(char_ptr_to_string(raw), "Gallt"), "char_ptr_to_string content")
    free(raw)

    char* empty_raw = heap(char, 1)
    empty_raw[0] = '\0'
    check(string_equals(char_ptr_to_string(empty_raw), ""), "char_ptr_to_string empty")
    free(empty_raw)

    string text = "hello"
    char* ptr = string_to_char_ptr(text)
    check(ptr != null, "string_to_char_ptr allocated")
    check(ptr[0] == 'h' && ptr[4] == 'o', "string_to_char_ptr bytes")
    check(ptr[5] == '\0', "string_to_char_ptr terminator")
    check(string_equals(char_ptr_to_string(ptr), text), "string_to_char_ptr round trip")
    free(ptr)

    char* empty_ptr = string_to_char_ptr("")
    check(empty_ptr != null, "string_to_char_ptr empty allocated")
    check(empty_ptr[0] == '\0', "string_to_char_ptr empty terminator")
    free(empty_ptr)

    char buffer[8] = {'z', 'z', 'z', 'z', 'z', 'z', 'z', 'z'}
    check(string_to_char_buffer("abc", buffer, 8), "char buffer success")
    check(buffer[0] == 'a' && buffer[1] == 'b' && buffer[2] == 'c', "char buffer bytes")
    check(buffer[3] == '\0' && buffer[4] == 'z', "char buffer terminator and tail untouched")
    check(string_equals(char_ptr_to_string(buffer), "abc"), "char buffer round trip")

    char exact[4] = {'z', 'z', 'z', 'z'}
    check(string_to_char_buffer("abc", exact, 4), "char buffer exact capacity")
    check(exact[3] == '\0', "char buffer exact terminator")

    char small[3] = {'z', 'z', 'z'}
    check(string_to_char_buffer("abc", small, 3) == false, "char buffer too small")
    check(small[0] == 'z' && small[1] == 'z' && small[2] == 'z', "char buffer untouched on failure")
    check(string_to_char_buffer("abc", small, 0) == false, "char buffer zero capacity")
    check(string_to_char_buffer("abc", small, -5) == false, "char buffer negative capacity")
    check(string_to_char_buffer("abc", null, 8) == false, "char buffer null pointer")
    check(string_to_char_buffer("", small, 3), "char buffer empty into spare capacity")

    char single[1] = {'z'}
    check(string_to_char_buffer("", single, 1), "char buffer empty fits")
    check(single[0] == '\0', "char buffer empty terminator")
    char none[1] = {'z'}
    check(string_to_char_buffer("", none, 0) == false, "char buffer empty needs one byte")
    check(none[0] == 'z', "char buffer empty untouched")

    char long_source[9] = {'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', '\0'}
    char long_buffer[9]
    check(string_to_char_buffer(char_ptr_to_string(long_source), long_buffer, 9), "char buffer eight bytes")
    check(long_buffer[8] == '\0', "char buffer eight byte terminator")

    if (failures == 0) {
        output("stdlib_char_ptr_string: ok (", checks, " checks)\n")
    }
    return failures
}
