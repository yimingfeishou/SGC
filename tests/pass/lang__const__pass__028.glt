// lang__const__pass__028.glt
// expect output
// 1011

generics Box<T, int N> {
    struct Box {
        T value
    }
    int tag() {
        return 0
    }
}

generics Box<T, 0> {
    struct Box {
        T value
    }
    int tag() {
        return 10
    }
}

generics Box<T, 1> {
    struct Box {
        T value
    }
    int tag() {
        return 11
    }
}

int main() {
    Box<int, 0>.Box a
    Box<int, 1>.Box b
    output(Box<int, 0>.tag())
    output(Box<int, 1>.tag())
    return 0
}
