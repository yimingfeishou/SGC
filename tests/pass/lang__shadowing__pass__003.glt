// lang__shadowing__pass__003.glt
// expect output
// 4 4 4 4 3

struct example {
    float f
    double d
}

int main() {
    int example = 3
    const int L = size(example)
    int R = size(example)
    const int LA = align(example)
    int RA = align(example)
    output(L, " ", R, " ", LA, " ", RA, " ", example)
    return 0
}
