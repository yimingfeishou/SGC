// lang__op_overload__pass__001.glt
// expect output
// 203

namespace math {
    struct Value {
        int x
    }

    int operator + (Value left, Value right) {
        return left.x + right.x + 100
    }

    namespace inner {
        int operator + (Value left, Value right) {
            return left.x + right.x + 200
        }

        int use(Value left, Value right) {
            return left + right
        }
    }
}

int main() {
    math::Value left = {1}
    math::Value right = {2}
    output(math::inner::use(left, right))
    return 0
}
