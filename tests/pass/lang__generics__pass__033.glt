// lang__generics__pass__033.glt
// expect output
// 7

namespace shapes {
    generics Box<T> {
        struct Box {
            T value
        }

        T get(Box item) {
            return item.value
        }
    }
}

access namespace shapes

int main() {
    Box<int>.Box b = {7}
    output(Box<int>.get(b))
    return 0
}