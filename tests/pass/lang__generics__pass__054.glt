// lang__generics__pass__054.glt
// expect output
// 11 22 0 B ownedfirst

generics Pick<T> {
    T choose(T value) {
        switch (value) {
            case (1) {
                return 11
            }
            case (2) {
                return 22
            }
        }
        return 0
    }
}

int main() {
    output(Pick<int>::choose(1))
    output(" ")
    output(Pick<int>::choose(2))
    output(" ")
    output(Pick<int>::choose(5))
    output(" ")
    char c = 'b'
    switch (c) {
        case ('a') {
            output("A")
        }
        case ('b') {
            output("B")
        }
        case ('c') {
            output("C")
        }
    }
    output(" ")
    string s = "first"
    switch (1) {
        case (1) {
            string local = "owned"
            output(local)
            fallthrough
        }
        output(s)
    }
    output("\n")
    return 0
}
