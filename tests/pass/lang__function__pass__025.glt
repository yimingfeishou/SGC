// lang__function__pass__025.glt
// expect output
// 10
// 0
// 1
// 0
// 2
// 3
// 2
// 5
// 7
// 9
// 1099511627776
// 2
// -4
// 15

int main() {
    output(2 + 3 << 1, "\n")
    output(1 << 2 & 3, "\n")
    output(1 & 3 == 3, "\n")
    output(4 | 1 & 2, "\n")
    output(1 ? 2 : 3 ? 4 : 5, "\n")
    output(0 ? 1 : 0 ? 2 : 3, "\n")
    output(1 + 1 ? 2 : 3, "\n")
    output(1 | 0 ? 5 : 6, "\n")
    output(true && 1 ? 7 : 8, "\n")
    output(1 == 1 || 0 ? 9 : 10, "\n")
    lint big = 1
    big <<= 40
    output(big, "\n")
    luint u = 8
    u >>= 2
    output(u, "\n")
    int neg = -8
    neg >>= 1
    output(neg, "\n")
    luint uneg = 0
    uneg = uneg - 1
    uneg >>= 60
    output(uneg, "\n")
    return 0
}
