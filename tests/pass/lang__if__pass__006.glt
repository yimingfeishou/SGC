// lang__if__pass__006.glt
// expect output
// 7 0
// -1 100 2

generics First<int... Ns> {
    int first() {
        const if (Ns.empty) {
            return 0
        }
        return Ns.first
    }
}

generics Size<T...> {
    int count() {
        const if (T.empty) {
            return -1
        }
        const if (T.length == 1) {
            return 100
        }
        return T.length
    }
}

int main() {
    output(First<7, 8, 9>.first(), " ", First<>.first(), "\n")
    output(Size<>.count(), " ", Size<int>.count(), " ", Size<int, float>.count(), "\n")
    return 0
}
