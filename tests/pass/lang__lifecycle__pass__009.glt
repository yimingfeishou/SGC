// lang__lifecycle__pass__009.glt
// expect output
// 777itemitem

struct Item {
    string name = "item"
    int count = 7
}
int main() {
    Item first
    Item second = copy(first)
    Item third = move(first)
    first = second
    third = move(second)
    output(first.count, second.count, third.count)
    output(first.name, third.name)
    return 0
}
