// integ__file__pass__001.glt
// expect exit 0

// io_focus.glt
// Focused runtime benchmark: file I/O (T25 of tests/benchmark.glt) split into
// its two cost centers: the write/read line loop and the eof probe loop.

extern luint GetTickCount64 from kernel32 ()
extern int printf from libucrt (string format, luint value)

int main() {
    // write + read line loop
    {
        luint t0 = GetTickCount64()
        string path = "io_focus_tmp.txt"
        int outer = 0
        while (outer < 20) {
            file* wf = fileopen(path, "w")
            if (wf != null) {
                int i = 0
                while (i < 2000) {
                    filewriteline(wf, "line content")
                    i++
                }
                fileflush(wf)
                fileclose(wf)
            }
            file* rf = fileopen(path, "r")
            if (rf != null) {
                int total = 0
                while (!fileeof(rf)) {
                    string line = filereadline(rf)
                    total = total + strlen(line)
                }
                fileclose(rf)
            }
            outer++
        }
        fileremove(path)
        printf("IO write+read+eof      : %llu ms\n", GetTickCount64() - t0)
    }

    // eof probe only
    {
        luint t0 = GetTickCount64()
        string path = "io_focus_tmp2.txt"
        file* wf = fileopen(path, "w")
        if (wf != null) {
            int i = 0
            while (i < 2000) {
                filewriteline(wf, "line content")
                i++
            }
            fileclose(wf)
        }
        int hits = 0
        int outer = 0
        while (outer < 20) {
            file* rf = fileopen(path, "r")
            if (rf != null) {
                int i = 0
                while (i < 2000) {
                    bool e = fileeof(rf)
                    if (e) { hits = hits + 1 }
                    i++
                }
                fileclose(rf)
            }
            outer++
        }
        fileremove(path)
        printf("IO eof probe x40000    : %llu ms\n", GetTickCount64() - t0)
        if (hits > 0) { printf("IO eof hits %d\n", 0lu) }
    }

    // metadata operations
    {
        luint t0 = GetTickCount64()
        string path = "io_focus_tmp3.txt"
        int outer = 0
        while (outer < 200) {
            file* wf = fileopen(path, "w")
            if (wf != null) {
                filewriteline(wf, "line content")
                fileclose(wf)
            }
            bool exists = fileexists(path)
            int sz = filesize(path)
            string path2 = "io_focus_copy.txt"
            bool copied = filecopy(path, path2)
            bool renamed = filerename(path2, "io_focus_renamed.txt")
            bool removed = fileremove("io_focus_renamed.txt")
            bool removed2 = fileremove(path)
            if (!exists || sz < 0 || !copied || !renamed || !removed || !removed2) {
                printf("IO meta fail\n", 0lu)
            }
            outer++
        }
        printf("IO metadata x200       : %llu ms\n", GetTickCount64() - t0)
    }
    return 0
}
