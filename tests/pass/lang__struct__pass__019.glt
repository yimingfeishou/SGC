// lang__struct__pass__019.glt
// expect output
// John 1990-5-15 5000.0 Bob 1985

struct Date {
    int year
    int month
    int day
}

struct Employee {
    string name
    Date birth_date
    float salary
}

int main() {
    Employee e1 = {"John", {1990, 5, 15}, 5000.0}
    output(e1.name, " ", e1.birth_date.year, "-", e1.birth_date.month, "-", e1.birth_date.day, " ", e1.salary)
    Date d = {1985, 10, 20}
    Employee e3 = {"Bob", d, 5500.0}
    output(" ", e3.name, " ", e3.birth_date.year)
    return 0
}
