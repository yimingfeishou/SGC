// integ__platform__pass__001.glt
// expect output
// win

@if (is_defined("WINDOWS_PLATFORM")) {
    @cond X = 1
} @else {
    @if (is_defined("LINUX_PLATFORM")) {
        @cond Y = 1
    } @else {
        @cond Z = 1
    }
}
int main() {
    @if (is_defined("X")) {
        output("win\n")
    } @else {
        output("other\n")
    }
    return 0
}
