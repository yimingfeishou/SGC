// sl__namespace__pass__001.glt
// expect output
// true abc true 18446744073709551615 -9223372036854775807 3 4294967295 5 9 

guide "common.glt"
access namespace sl

int main() {
    char z = '\0'
    output(z == '\0', " ")

    string s = "abc"
    char* p = heap(char, 4)
    p[0] = strcharat(s, 0)
    p[1] = strcharat(s, 1)
    p[2] = strcharat(s, 2)
    p[3] = '\0'
    output(p[0], p[1], p[2], " ", p[3] == '\0', " ")

    luint big = 18446744073709551615lu
    output(big, " ")

    lint neg = -9223372036854775807l
    output(neg, " ")

    double d = 3.75
    lint li = cast<lint>(d)
    output(li, " ")

    uint u = 4294967295u
    output(u, " ")

    luint m = 0lu - cast<luint>(-5l)
    output(m, " ")

    luint div = 123456789lu % 10lu
    output(div, " ")

    free(p)
    return 0
}
