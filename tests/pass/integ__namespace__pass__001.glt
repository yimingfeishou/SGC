// integ__namespace__pass__001.glt
// expect output
// 7 9 2 -2

generics BlockExternal<T: int> {
    emit {
        access namespace block_external

        namespace block_external {
            extern T abs from ucrtbase (T value)
        }

        T block_distance(T value) {
            return abs(value)
        }
    }
}

generics StringExternal<T: lint> {
    emit "access namespace string_external\n"
    emit "namespace string_external {\n"
    emit "    extern T _abs64 from ucrtbase (T value)\n"
    emit "}\n"
    emit "T string_distance(T value) {\n"
    emit "    return _abs64(value)\n"
    emit "}\n"
}

generics BlockDirect<T: double> {
    emit {
        extern T fabs from ucrtbase (T value)

        int block_absolute(T value) {
            return cast<int>(fabs(value))
        }
    }
}

generics StringDirect<T: double> {
    emit "extern T floor from ucrtbase (T value)\n"
    emit "int string_floor(T value) {\n"
    emit "    return cast<int>(floor(value))\n"
    emit "}\n"
}

int main() {
    output(BlockExternal<int>::block_distance(-7), " ")
    output(StringExternal<lint>::string_distance(-9), " ")
    output(BlockDirect<double>::block_absolute(-2.5), " ")
    output(StringDirect<double>::string_floor(-1.5))
    return 0
}
