// lang__overload__pass__003.glt
// expect output
// 1223345

int rank(char v) {
    return 1
}

int rank(int v) {
    return 2
}

int rank(double v) {
    return 3
}

int mixed(int a, double b) {
    return 4
}

int mixed(double a, int b) {
    return 5
}

int main() {
    char c = 'A'
    uchar u = 200
    uint ui = 7
    luint ul = 9lu
    float f = 1.5f
    output(rank(c))
    output(rank(u))
    output(rank(ui))
    output(rank(ul))
    output(rank(f))
    output(mixed(1, 2.0))
    output(mixed(2.0, 1))
    return 0
}
