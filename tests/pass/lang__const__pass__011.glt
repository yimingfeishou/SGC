// lang__const__pass__011.glt
// expect output
// 10 11

generics Box<T, int N> {
    struct Box {
        T value
    }
    int tag() {
        return 0
    }
}

generics Box<T, 0> {
    struct Box {
        T value
    }
    int tag() {
        return 10
    }
}

generics Box<T, 1> {
    struct Box {
        T value
    }
    int tag() {
        return 11
    }
}

int main() {
    Box<int, 0>.Box zero
    Box<int, 1>.Box one
    output(Box<int, 0>.tag(), " ", Box<int, 1>.tag())
    return 0
}
