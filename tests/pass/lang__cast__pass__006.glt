// lang__cast__pass__006.glt
// expect output
// false false

struct Point {
    int x
}

int add(int a, int b) {
    return a + b
}

int main() {
    Point point = {5}
    Point* handle = &point
    file stream = cast<file>(handle)
    int(int, int)* callback = cast<int(int, int)*>(handle)
    output(stream == null, " ", callback == null)
    return 0
}
