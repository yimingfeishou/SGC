// integ__export__pass__001.glt
// expect output
// 1 1

struct S {
    int x
    int tag

    copy_constructor (S* other) {
        x = other->x
        tag = other->tag + 1
    }

    move_constructor (S* other) {
        x = other->x
        tag = other->tag + 10
    }

    destructor () {
        return
    }
}

export int take_direct(S value) {
    return value.tag
}

int main() {
    S a
    a.x = 1
    a.tag = 0
    output(take_direct(a), " ")
    int(S)* f = &take_direct
    output(f(a))
    return 0
}
