// lang__function__pass__024.glt
// expect output
// 8 14 6 -13
// 16
// 4
// 2
// 10
// 11
// 20
// 5
// 100
// yes

int main() {
    int a = 12
    int b = 10
    output(a & b, " ", a | b, " ", a ^ b, " ", ~a, "\n")
    int c = 1
    c <<= 4
    output(c, "\n")
    c >>= 2
    output(c, "\n")
    int d = 6
    d &= 3
    output(d, "\n")
    d |= 8
    output(d, "\n")
    d ^= 1
    output(d, "\n")
    int e = 5 << 2
    output(e, "\n")
    int f = 20 >> 2
    output(f, "\n")
    int g = 1
    int h = g ? 100 : 200
    output(h, "\n")
    output((a > b) ? "yes" : "no", "\n")
    return 0
}
