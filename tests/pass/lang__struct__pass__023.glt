// lang__struct__pass__023.glt
// expect output
// 10 2 11 12 13 made
// 2 12 made
// 99 42 y
// 175
// 99 42
// 4 1
// [][made] 10 13
// 2 77

struct Pair {
    int a = 1
    int b = 2
}

struct Box {
    Pair pair
    int arr[3]
    string name
}

Box make_box(int base) {
    Box box
    box.pair.a = base
    box.arr[0] = base + 1
    box.arr[1] = base + 2
    box.arr[2] = base + 3
    box.name = "made"
    return box
}

int sum_box(Box box) {
    int total = box.pair.a + box.pair.b
    for (int i = 0; i < 3; i++) {
        total += box.arr[i]
    }
    return total
}

int main() {
    Box x = make_box(10)
    output(x.pair.a, " ", x.pair.b, " ", x.arr[0], " ", x.arr[1], " ", x.arr[2], " ", x.name, "\n")

    Box y = x
    y.pair.b = 99
    y.arr[1] = 42
    y.name = "y"
    output(x.pair.b, " ", x.arr[1], " ", x.name, "\n")
    output(y.pair.b, " ", y.arr[1], " ", y.name, "\n")

    output(sum_box(y), "\n")
    output(y.pair.b, " ", y.arr[1], "\n")

    Pair list[2] = {{1, 2}, {3, 4}}
    output(list[1].b, " ", list[0].a, "\n")

    Box z = move(x)
    output("[", x.name, "][", z.name, "]", " ", z.pair.a, " ", z.arr[2], "\n")

    Pair p = list[0]
    p.b = 77
    output(list[0].b, " ", p.b, "\n")
    return 0
}
