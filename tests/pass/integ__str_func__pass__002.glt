// integ__str_func__pass__002.glt
// expect exit 0

// string_focus.glt
// Focused runtime benchmark: the string group (T16..T20) of tests/benchmark.glt,
// each case timed separately so the hot cases can be identified.
// Run: sgc --compile --input tests/perf_cases/string_focus.glt --output out.exe -OL n

guide "common.glt"

extern luint GetTickCount64 from kernel32 ()
extern int printf from libucrt (string format, luint value)

int main() {
    luint t_all = GetTickCount64()

    // T16 compare / search
    {
        luint t0 = GetTickCount64()
        string a = "hello world"
        string b = "hello"
        string c = "world"
        int i = 0
        int sum = 0
        while (i < 500000) {
            if (sl::string_equals(a, a)) { sum = sum + 1 }
            if (sl::string_starts_with(a, b)) { sum = sum + 1 }
            if (sl::string_ends_with(a, c)) { sum = sum + 1 }
            if (sl::string_contains_char(a, 'o')) { sum = sum + 1 }
            if (!sl::string_is_empty(a)) { sum = sum + 1 }
            sum = sum + sl::string_index_of_char(a, 'w')
            sum = sum + sl::string_last_index_of_char(a, 'l')
            sum = sum + sl::string_count_char(a, 'l')
            i++
        }
        printf("T16 compare/search     : %llu ms\n", GetTickCount64() - t0)
        if (sum == -1) { printf("T16 fail\n", 0lu) }
    }

    // T17 repeat / reverse / pad / trim
    {
        luint t0 = GetTickCount64()
        int i = 0
        int sum = 0
        while (i < 20000) {
            string r = sl::string_repeat("ab", 50)
            string rev = sl::string_reverse(r)
            string pl = sl::string_pad_left("x", 100, '0')
            string pr = sl::string_pad_right("x", 100, '0')
            string tl = sl::string_trim_left("   hello")
            string tr = sl::string_trim_right("hello   ")
            sum = sum + strlen(r) + strlen(rev) + strlen(pl)
            sum = sum + strlen(pr) + strlen(tl) + strlen(tr)
            i++
        }
        printf("T17 repeat/pad/trim    : %llu ms\n", GetTickCount64() - t0)
        if (sum == -1) { printf("T17 fail\n", 0lu) }
    }

    // T18 split / join
    {
        luint t0 = GetTickCount64()
        string s = "a,b,c,d,e,f,g,h,i,j"
        int i = 0
        int sum = 0
        while (i < 100000) {
            int count = sl::string_split_count(s, ",")
            string p0 = sl::string_split(s, ",", 0)
            string p5 = sl::string_split(s, ",", 5)
            string p9 = sl::string_split(s, ",", 9)
            string j = sl::string_join(p0, p5, "-")
            sum = sum + count + strlen(p0) + strlen(p5) + strlen(p9) + strlen(j)
            i++
        }
        printf("T18 split/join         : %llu ms\n", GetTickCount64() - t0)
        if (sum == -1) { printf("T18 fail\n", 0lu) }
    }

    // T19 string +
    {
        luint t0 = GetTickCount64()
        int i = 0
        int sum = 0
        while (i < 500000) {
            string a = "hello"
            string b = " world"
            string c = a + b
            sum = sum + strlen(c)
            i++
        }
        printf("T19 string +           : %llu ms\n", GetTickCount64() - t0)
        if (sum == -1) { printf("T19 fail\n", 0lu) }
    }

    // T20 runtime string API
    {
        luint t0 = GetTickCount64()
        int i = 0
        int sum = 0
        while (i < 200000) {
            string a = "Hello World"
            string b = "hello world"
            int cmp = strcompare(a, b)
            int idx = strfind(a, "World")
            bool has = strcontains(a, "lo")
            string sub = strsubstr(a, 0, 5)
            string up = strupper(a)
            string lo = strlower(a)
            string tr = strtrim("  x  ")
            char at = strcharat(a, 0)
            int cnt = strsplitcount("a;b;c", ";")
            string sp = strsplitget("a;b;c", ";", 1)
            int has_i = has ? 1 : 0
            sum = sum + cmp + idx + has_i + strlen(sub) + strlen(up)
            sum = sum + strlen(lo) + strlen(tr) + cast<int>(at) + cnt + strlen(sp)
            i++
        }
        printf("T20 runtime string API : %llu ms\n", GetTickCount64() - t0)
        if (sum == -1) { printf("T20 fail\n", 0lu) }
    }

    printf("TOTAL                  : %llu ms\n", GetTickCount64() - t_all)
    return 0
}
