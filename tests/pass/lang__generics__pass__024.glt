// lang__generics__pass__024.glt
// expect output
// 7 10.0 9

generics Box<T> {
    struct Box {
        T value
    }

    Box operator + (Box a, Box b) {
        Box r
        r.value = a.value + b.value
        return r
    }
}

generics IntArray<T> {
    struct IntArray {
        T* data
    }

    T* operator [] (IntArray* self, int i) {
        return self->data + i
    }
}

Box<double> operator * (Box<double> a, Box<double> b) {
    Box<double> r
    r.value = a.value * b.value
    return r
}

int main() {
    Box<int> x = {3}
    Box<int> y = {4}
    Box<int> z = x + y
    output(z.value)
    Box<double> p = {2.5}
    Box<double> q = {4.0}
    Box<double> w = p * q
    output(" ", w.value)
    int values[3] = {7, 8, 9}
    IntArray<int> arr = {values}
    output(" ", *arr[2])
    return 0
}
