// lang__generics__pass__024.glt
// expect output
// 7 10.0 9

generics BoxGeneric<T> {
    struct Box {
        T value
    }

    Box operator + (Box a, Box b) {
        Box r
        r.value = a.value + b.value
        return r
    }
}

generics IntArrayGeneric<T> {
    struct IntArray {
        T* data
    }

    T* operator [] (IntArray* self, int i) {
        return self->data + i
    }
}

BoxGeneric<double> operator * (BoxGeneric<double> a, BoxGeneric<double> b) {
    BoxGeneric<double> r
    r.value = a.value * b.value
    return r
}

int main() {
    BoxGeneric<int> x = {3}
    BoxGeneric<int> y = {4}
    BoxGeneric<int> z = x + y
    output(z.value)
    BoxGeneric<double> p = {2.5}
    BoxGeneric<double> q = {4.0}
    BoxGeneric<double> w = p * q
    output(" ", w.value)
    int values[3] = {7, 8, 9}
    IntArrayGeneric<int> arr = {values}
    output(" ", *arr[2])
    return 0
}
