// lang__operator__pass__006.glt
// expect output
// 1

struct A {
    int v
}

struct B {
    int v
}

struct Box {
    int x
}

bool is_open(A a) { return a.v != 0 }
bool is_open(B b) { return b.v != 0 }
int operator << (Box lhs, int rhs) { return lhs.x + rhs }

int main() {
    A a = {1}
    B b = {0}
    bool r = is_open(a) && !is_open(b)
    output(r ? 1 : 0)
    return 0
}