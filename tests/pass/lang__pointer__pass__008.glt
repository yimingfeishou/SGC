// lang__pointer__pass__008.glt
// expect output
// 6 3 3

struct Node {
    int value
    Node* next
}

int main() {
    Node tail = {1, null}
    Node middle = {2, &tail}
    Node head = {3, &middle}
    Node* cursor = &head
    Node** slot = &cursor
    int total = 0
    int first = (*slot)->value
    while (cursor != null) {
        total += cursor->value
        cursor = cursor->next
    }
    *slot = &head
    output(total, " ", first, " ", (*slot)->value)
    return 0
}
