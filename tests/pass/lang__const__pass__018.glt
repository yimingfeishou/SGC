// lang__const__pass__018.glt
// expect output
// 42
// value

const string make_getter(string type, string name) {
    return type + " get_" + name + "() {\n    return " + name + "\n}"
}

generics Emiter<T: int, T N> {
    emit make_getter(T.typename, N)
}

const string make_literal_getter(string type, string name) {
    return type + " get_" + name + "() {\n    return \"" + name + "\"\n}"
}

generics LiteralEmiter<T: string, T N> {
    emit make_literal_getter(T.typename, N)
}

int main() {
    output(Emiter<int, 42>.get_42(), "\n")
    output(LiteralEmiter<string, "value">.get_value(), "\n")
    return 0
}
