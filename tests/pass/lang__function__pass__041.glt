// lang__function__pass__041.glt
// expect output
// 00000000
// 00100101
// 00100000
// 10101111
// 10100010
// 11101111
// 11100111
// 11111111

bool or_and(bool a, bool b, bool c) {
    return a || (b && c)
}

bool and_or(bool a, bool b, bool c) {
    return a && (b || c)
}

bool or_or(bool a, bool b, bool c) {
    return a || (b || c)
}

bool and_and(bool a, bool b, bool c) {
    return a && (b && c)
}

bool mix_left(bool a, bool b, bool c) {
    return (a || b) && c
}

bool mix_left2(bool a, bool b, bool c) {
    return (a && b) || c
}

bool plain_or_and(bool a, bool b, bool c) {
    return a || b && c
}

bool plain_and_or(bool a, bool b, bool c) {
    return a && b || c
}

int main() {
    for (int i = 0; i < 8; i++) {
        bool a = (i / 4) % 2 == 1
        bool b = (i / 2) % 2 == 1
        bool c = i % 2 == 1
        int oa = or_and(a, b, c) ? 1 : 0
        int ao = and_or(a, b, c) ? 1 : 0
        int oo = or_or(a, b, c) ? 1 : 0
        int aa = and_and(a, b, c) ? 1 : 0
        int ml = mix_left(a, b, c) ? 1 : 0
        int ml2 = mix_left2(a, b, c) ? 1 : 0
        int po = plain_or_and(a, b, c) ? 1 : 0
        int pa = plain_and_or(a, b, c) ? 1 : 0
        output(oa, ao, oo, aa, ml, ml2, po, pa, "\n")
    }
    return 0
}