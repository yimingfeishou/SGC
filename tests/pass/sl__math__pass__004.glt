// sl__math__pass__004.glt
// expect output
// pow00=1.0
// pow0neg=0.0
// pow0pos=0.0
// pownegfrac=0.0
// pownegint=-8.0
// pownegintneg=-0.125
// sqrtneg=0.0
// logzero=0.0
// logneg=0.0
// log10zero=0.0
// log2zero=0.0
// asin2=0.0
// acos2=0.0
// fmodzero=0.0
// fmod=1.5
// floor=-3.0 2.0
// ceil=-2.0 3.0
// round=-3.0 3.0 2.0
// trunc=-2.0 2.0
// abs=3.5 3.5
// minmax=2.0 3.0
// clamp=3.0 1.0 2.0
// pi=3.1415926535897931 e=2.7182818284590451 ln2=0.69314718055994529 ln10=2.3025850929940459 sqrt2=1.4142135623730951
// sqrt2=1.4142135623730949 exp0=1.0 exp1=2.7182818284590446
// sin0=0.0 cos0=1.0 tan0=0.0 tanhalfpi=0.0
// atan1=0.78539816339744828 atan2=2.3561944901923448
// sinh0=0.0 cosh0=1.0 tanh100=1.0
// truncbig=1e+20
// range=true
// doublerange=true
// doublerange2=true
// rand_nonneg=true

guide "math.glt"
access namespace sl

int main() {
    output("pow00=", pow(0.0, 0.0), "\n")
    output("pow0neg=", pow(0.0, -1.0), "\n")
    output("pow0pos=", pow(0.0, 2.0), "\n")
    output("pownegfrac=", pow(-2.0, 0.5), "\n")
    output("pownegint=", pow(-2.0, 3.0), "\n")
    output("pownegintneg=", pow(-2.0, -3.0), "\n")
    output("sqrtneg=", sqrt(-1.0), "\n")
    output("logzero=", log(0.0), "\n")
    output("logneg=", log(-1.0), "\n")
    output("log10zero=", log10(0.0), "\n")
    output("log2zero=", log2(0.0), "\n")
    output("asin2=", asin(2.0), "\n")
    output("acos2=", acos(-2.0), "\n")
    output("fmodzero=", fmod(5.0, 0.0), "\n")
    output("fmod=", fmod(5.5, 2.0), "\n")
    output("floor=", floor(-2.5), " ", floor(2.5), "\n")
    output("ceil=", ceil(-2.5), " ", ceil(2.5), "\n")
    output("round=", round(-2.5), " ", round(2.5), " ", round(2.4), "\n")
    output("trunc=", trunc(-2.5), " ", trunc(2.5), "\n")
    output("abs=", abs(-3.5), " ", fabs(-3.5), "\n")
    output("minmax=", min(2.0, 3.0), " ", max(2.0, 3.0), "\n")
    output("clamp=", clamp(5.0, 1.0, 3.0), " ", clamp(-5.0, 1.0, 3.0), " ", clamp(2.0, 1.0, 3.0), "\n")
    output("pi=", pi, " e=", e, " ln2=", ln2, " ln10=", ln10, " sqrt2=", sqrt2, "\n")
    output("sqrt2=", sqrt(2.0), " exp0=", exp(0.0), " exp1=", exp(1.0), "\n")
    output("sin0=", sin(0.0), " cos0=", cos(0.0), " tan0=", tan(0.0), " tanhalfpi=", tan(pi / 2.0), "\n")
    output("atan1=", atan(1.0), " atan2=", atan2(1.0, -1.0), "\n")
    output("sinh0=", sinh(0.0), " cosh0=", cosh(0.0), " tanh100=", tanh(100.0), "\n")
    output("truncbig=", trunc(100000000000000000000.0), "\n")

    srand(0lu)
    output("range=", random_int(5, 1) >= 1 && random_int(5, 1) <= 5, "\n")
    double d = random_double()
    output("doublerange=", d >= 0.0 && d < 1.0, "\n")
    double dr = random_double_range(2.0, 1.0)
    output("doublerange2=", dr >= 1.0 && dr <= 2.0, "\n")
    output("rand_nonneg=", rand() >= 0, "\n")
    return 0
}
