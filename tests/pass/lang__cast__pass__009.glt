// lang__cast__pass__009.glt
// expect output
// 10.0 3 5 7 42 4 2

generics Sized<T, int N> {
    int length() {
        return cast<int>(N)
    }

    int tag() {
        return N
    }
}

generics Box<T> {
    struct Inner {
        T k
    }
}

namespace ns {
    struct Point {
        int x
    }
}

struct MyInt {
    int v
}

operator int (MyInt m) {
    return m.v
}

int main() {
    int i = 10
    double d = cast<double>(i)

    int v = 3
    void* raw = cast<void*>(&v)
    int* back = cast<int*>(raw)

    ns::Point pt = {5}
    void* point_raw = cast<void*>(&pt)
    ns::Point* point_back = cast<ns::Point*>(point_raw)

    Box<int>.Inner inner = {7}
    void* inner_raw = cast<void*>(&inner)
    Box<int>.Inner* inner_back = cast<Box<int>.Inner*>(inner_raw)

    MyInt m = {42}
    int converted = cast<int>(m)

    output(d, " ", *back, " ", point_back->x, " ", inner_back->k, " ", converted, " ", Sized<int, 4>.length(), " ", Sized<int, cast<int>(2)>.tag())
    return 0
}
