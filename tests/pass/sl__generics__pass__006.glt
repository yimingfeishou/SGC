// sl__generics__pass__006.glt
// expect output
// true true 

guide "generics.glt"
access namespace sl

generics probe2<T: int | string> {
    bool probe(T a, T b) {
        const if (T.is_string == true) {
            return strcompare(a, b) == 0
        } const else {
            return a == b
        }
    }
}

int main() {
    output(probe2<int>.probe(1, 1), " ")
    output(probe2<string>.probe("a", "a"), " ")
    return 0
}
