// lang__loop__pass__001.glt
// expect output
// 25

int main() {
    int sum = 0
    for (int i = 0; i < 10; i++) {
        if (i == 5) {
            break
        }
        sum = sum + i
    }
    int count = 1
    while (count <= 5) {
        sum = sum + count
        count = count + 1
    }
    output(sum)
    return 0
}
