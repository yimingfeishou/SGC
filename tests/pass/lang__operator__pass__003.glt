// lang__operator__pass__003.glt
// expect output
// 4 3 [a]

int main() {
    file* text = fileopen("./sgc_mode_text.txt", "w")
    if (text == null) {
        return 3
    }
    filewrite(text, "a\nb")
    fileclose(text)
    int text_size = filesize("./sgc_mode_text.txt")

    file* binary = fileopen("./sgc_mode_bin.txt", "wb")
    if (binary == null) {
        return 3
    }
    filewrite(binary, "a\nb")
    fileclose(binary)
    int binary_size = filesize("./sgc_mode_bin.txt")

    output(text_size, " ", binary_size)

    file* reader = fileopen("./sgc_mode_text.txt", "r")
    if (reader == null) {
        return 3
    }
    string first = filereadline(reader)
    fileclose(reader)
    output(" [", first, "]")

    fileremove("./sgc_mode_text.txt")
    fileremove("./sgc_mode_bin.txt")
    return 0
}
