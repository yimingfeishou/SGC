// lang__struct__pass__006.glt
// expect output
// 863

int add(int a, int b) { return a + b }
int sub(int a, int b) { return a - b }
struct Calculator {
    string brand
    int operation(int, int)*
}
int main() {
    Calculator calc1 = {"Basic", &add}
    output(calc1.operation(3, 5))
    Calculator calc2 = {"Pro", null}
    calc2.operation = &sub
    output(calc2.operation(10, 4))
    int op(int, int)* = &add
    Calculator calc3 = {"Advanced", op}
    output(calc3.operation(1, 2))
    return 0
}
