// sl__generics__pass__001.glt
// expect output
// 1 2 3 4 5 

guide "generics.glt"
access namespace sl

int cmp_int(int a, int b) {
    if (a < b) {
        return -1
    }
    if (a > b) {
        return 1
    }
    return 0
}

int main() {
    sort_generic<int>

    int arr[5] = {5, 3, 1, 4, 2}
    bool ok = sort(arr, 5, &cmp_int)

    for (int i = 0; i < 5; i++) {
        output(arr[i], " ")
    }

    return 0
}
