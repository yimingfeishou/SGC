// lang__op_overload__pass__005.glt
// expect output
// 15

struct Counter {
    int v
}

void operator += (Counter* c, int n) {
    c->v += n
}

void operator ++ (Counter* c) {
    c->v += 1
}

void operator ++ (Counter* c, int) {
    c->v += 100
}

int main() {
    Counter c = {10}
    c += 5
    output(c.v)
    return 0
}
