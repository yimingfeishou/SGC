// lang__const__pass__005.glt
// expect output
// 5.010.042.565true141013�

const double K = 2.5
const int N = 3
const float F = 1.5f
const char C = 'A'
const bool B = true
const lint L = 7l
const uint U = 9u
const luint LU = 11lu
const uchar UC = 200

double scale(double x) {
    return x * K
}

int main() {
    double a = 4.0 * K
    int b = N + 1
    float c = F + 1.0f
    int d = cast<int>(C)
    bool e = B
    lint f = L * 2l
    uint g = U + 1u
    luint h = LU + 2lu
    uchar i = UC
    output(scale(2.0), a, b, c, d, e, f, g, h, i)
    return 0
}
