// Provider library for the --no-runtime / -NR import test.
// Build with: sgc --compile --input nr_import_provider.glt --output nr_import_provider.lib -NR
// The library owns a global, a struct type and text helpers, so importing it
// exercises the symbol classes that used to collide with the importing program.

struct Packet {
    int id
    int weight
}

int library_counter = 100

export int add(int a, int b) {
    return a + b
}

export int bump() {
    library_counter = library_counter + 10
    return library_counter
}

export int weight_of(Packet p) {
    return p.weight
}

export int text_len(string* ptext) {
    string text = *ptext
    return strlen(text)
}

export string make_text(int n) {
    if (n > 0) {
        return "positive"
    }
    return "non-positive"
}
