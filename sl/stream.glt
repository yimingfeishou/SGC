// stream.glt
// Gallt Standard Library
// Naming Conventions: snake_case
// All standard library statements are stored in the sl namespace
// All standard libraries except for sl.glt itself, should import sl.glt and addition namespace sl
// Copyright (c) Yimingfeishou

guide "common.glt"

addition namespace sl {

    struct __set_width { int value }
    struct __set_precision { int value }
    struct __set_fill { char value }

    [nocopy] struct stream {
        int write(stream*, string)*
        int read(stream*, string*)*
        bool flush(stream*)*
        bool close(stream*)*
        int error(stream*)*

        file* handle
        string buffer
        int pos
        bool owns_handle
        int kind

        int width
        int precision
        char fill_char
        int flags
        int base

        int state

        string line_buffer
        int line_pos

        constructor () {
            write = null
            read = null
            flush = null
            close = null
            error = null
            handle = null
            buffer = ""
            pos = 0
            owns_handle = false
            kind = 0
            width = 0
            precision = 6
            fill_char = ' '
            flags = 2
            base = 10
            state = 0
            line_buffer = ""
            line_pos = 0
        }

        destructor () {
            if (owns_handle && handle != null) {
                fileclose(handle)
                handle = null
            }
        }
    }

    int __st_stdout_write(stream* s, string text) {
        output(text)
        return strlen(text)
    }
    bool __st_stdout_flush(stream* s) { return true }
    bool __st_stdout_close(stream* s) { return true }
    int __st_stdout_error(stream* s) { return 0 }

    int __st_stdin_read(stream* s, string* out) {
        *out = strread()
        return strlen(*out)
    }

    int __st_file_write(stream* s, string text) {
        if (s->handle == null) {
            s->state = s->state | 4
            return -1
        }
        int n = filewrite(s->handle, text)
        if (n < 0) {
            s->state = s->state | 4
        }
        return n
    }

    int __st_file_read(stream* s, string* out) {
        if (s->handle == null) {
            s->state = s->state | 4
            return -1
        }
        *out = filereadline(s->handle)
        return strlen(*out)
    }

    bool __st_file_flush(stream* s) {
        if (s->handle == null) {
            s->state = s->state | 4
            return false
        }
        return fileflush(s->handle)
    }

    bool __st_file_close(stream* s) {
        if (s->handle == null) {
            return true
        }
        bool ok = fileclose(s->handle)
        s->handle = null
        return ok
    }

    int __st_file_error(stream* s) {
        if (s->handle == null) {
            return 1
        }
        return fileerror(s->handle)
    }

    int __st_string_write(stream* s, string text) {
        s->buffer = strconcat(s->buffer, text)
        return strlen(text)
    }

    int __st_string_read(stream* s, string* out) {
        int n = strlen(s->buffer)
        if (s->pos >= n) {
            *out = ""
            return 0
        }
        int start = s->pos
        int i = start
        while (i < n) {
            if (strcharat(s->buffer, i) == '\n') {
                break
            }
            i = i + 1
        }
        *out = strsubstr(s->buffer, start, i - start)
        if (i < n) {
            s->pos = i + 1
        } else {
            s->pos = n
        }
        return strlen(*out)
    }

    bool __st_string_flush(stream* s) { return true }
    bool __st_string_close(stream* s) { return true }
    int __st_string_error(stream* s) { return 0 }

    stream* make_console_out() {
        stream* s = construct stream()
        s->kind = 0
        s->write = &__st_stdout_write
        s->flush = &__st_stdout_flush
        s->close = &__st_stdout_close
        s->error = &__st_stdout_error
        return s
    }

    stream* make_console_in() {
        stream* s = construct stream()
        s->kind = 1
        s->read = &__st_stdin_read
        s->flush = &__st_stdout_flush
        s->close = &__st_stdout_close
        s->error = &__st_stdout_error
        return s
    }

    stream* make_file(string path, string mode) {
        file* fp = fileopen(path, mode)
        if (fp == null) {
            return null
        }
        stream* s = construct stream()
        s->kind = 2
        s->handle = fp
        s->owns_handle = true
        s->write = &__st_file_write
        s->read = &__st_file_read
        s->flush = &__st_file_flush
        s->close = &__st_file_close
        s->error = &__st_file_error
        return s
    }

    stream* make_string_stream() {
        stream* s = construct stream()
        s->kind = 3
        s->buffer = ""
        s->pos = 0
        s->write = &__st_string_write
        s->read = &__st_string_read
        s->flush = &__st_string_flush
        s->close = &__st_string_close
        s->error = &__st_string_error
        return s
    }

    string strstream_text(stream* s) {
        if (s == null) {
            return ""
        }
        return s->buffer
    }

    void strstream_reset(stream* s) {
        if (s == null) {
            return
        }
        s->buffer = ""
        s->pos = 0
    }

    bool stream_good(stream* s) {
        if (s == null) {
            return false
        }
        return s->state == 0
    }

    bool stream_eof(stream* s) {
        if (s == null) {
            return false
        }
        return (s->state & 1) != 0
    }

    bool stream_fail(stream* s) {
        if (s == null) {
            return true
        }
        return (s->state & (2 | 4)) != 0
    }

    bool stream_bad(stream* s) {
        if (s == null) {
            return true
        }
        return (s->state & 4) != 0
    }

    void stream_clear(stream* s) {
        if (s == null) {
            return
        }
        s->state = 0
    }

    string __st_format_uint(luint value, int base, bool upper_case) {
        if (value == 0lu) {
            return "0"
        }
        string digits = ""
        luint current = value
        while (current > 0lu) {
            int d = cast<int>(current % cast<luint>(base))
            char c = '\0'
            if (d < 10) {
                c = cast<char>(d + 48)
            } else {
                if (upper_case) {
                    c = cast<char>(d - 10 + 65)
                } else {
                    c = cast<char>(d - 10 + 97)
                }
            }
            digits = strconcat(char_to_string(c), digits)
            current = current / cast<luint>(base)
        }
        return digits
    }

    string __st_format_lint(lint value, int base, bool upper_case, bool show_base) {
        bool negative = false
        luint magnitude = 0lu
        if (value < 0l) {
            negative = true
            magnitude = 0lu - cast<luint>(value)
        } else {
            magnitude = cast<luint>(value)
        }
        string digits = __st_format_uint(magnitude, base, upper_case)
        string prefix = ""
        if (show_base) {
            if (base == 16) {
                if (upper_case) {
                    prefix = "0X"
                } else {
                    prefix = "0x"
                }
            } else {
                if (base == 8) {
                    prefix = "0"
                }
            }
        }
        string result = strconcat(prefix, digits)
        if (negative) {
            result = strconcat("-", result)
        }
        return result
    }

    string __st_format_luint(luint value, int base, bool upper_case, bool show_base) {
        string digits = __st_format_uint(value, base, upper_case)
        string prefix = ""
        if (show_base) {
            if (base == 16) {
                if (upper_case) {
                    prefix = "0X"
                } else {
                    prefix = "0x"
                }
            } else {
                if (base == 8) {
                    prefix = "0"
                }
            }
        }
        return strconcat(prefix, digits)
    }

    string __st_format_exponent(int exponent, bool upper) {
        string result = ""
        if (upper) {
            result = "E"
        } else {
            result = "e"
        }
        int abs_exp = exponent
        if (exponent >= 0) {
            result = strconcat(result, "+")
        } else {
            result = strconcat(result, "-")
            abs_exp = 0 - exponent
        }
        if (abs_exp < 10) {
            result = strconcat(result, "0")
        }
        result = strconcat(result, __st_format_uint(cast<luint>(abs_exp), 10, false))
        return result
    }

    string __st_strip_trailing_zeros(string text) {
        int dot = strfind(text, ".")
        if (dot < 0) {
            return text
        }
        int n = strlen(text)
        int end = n
        while (end > dot + 1 && strcharat(text, end - 1) == '0') {
            end = end - 1
        }
        if (end == dot + 1) {
            end = dot
        }
        return strsubstr(text, 0, end)
    }

    string __st_format_double_fixed(double value, int precision, bool upper, bool showpoint) {
        if (precision < 0) {
            precision = 0
        }
        string result = double_to_string(value, precision)
        if (showpoint && strfind(result, ".") < 0) {
            result = strconcat(result, ".")
        }
        if (upper) {
            result = strupper(result)
        }
        return result
    }

    string __st_format_double_scientific(double value, int precision, bool upper, bool showpoint) {
        if (precision < 0) {
            precision = 0
        }
        if (value == 0.0) {
            string text = "0"
            if (precision > 0) {
                text = strconcat(text, ".")
                int i = 0
                while (i < precision) {
                    text = strconcat(text, "0")
                    i = i + 1
                }
            } else {
                if (showpoint) {
                    text = strconcat(text, ".")
                }
            }
            return strconcat(text, __st_format_exponent(0, upper))
        }
        bool negative = value < 0.0
        double abs_val = value
        if (negative) {
            abs_val = 0.0 - value
        }
        int exponent = 0
        while (abs_val >= 10.0) {
            abs_val = abs_val / 10.0
            exponent = exponent + 1
        }
        while (abs_val < 1.0) {
            abs_val = abs_val * 10.0
            exponent = exponent - 1
        }
        string mantissa = double_to_string(abs_val, precision)
        if (showpoint && strfind(mantissa, ".") < 0) {
            mantissa = strconcat(mantissa, ".")
        }
        string result = strconcat(mantissa, __st_format_exponent(exponent, upper))
        if (negative) {
            result = strconcat("-", result)
        }
        return result
    }

    string __st_format_double_default(double value, int precision, bool upper, bool showpoint) {
        if (precision <= 0) {
            precision = 1
        }
        if (value == 0.0) {
            string text = "0"
            if (showpoint) {
                text = strconcat(text, ".")
                int i = 1
                while (i < precision) {
                    text = strconcat(text, "0")
                    i = i + 1
                }
            }
            return text
        }
        bool negative = value < 0.0
        double abs_val = value
        if (negative) {
            abs_val = 0.0 - value
        }
        int exponent = 0
        while (abs_val >= 10.0) {
            abs_val = abs_val / 10.0
            exponent = exponent + 1
        }
        while (abs_val < 1.0) {
            abs_val = abs_val * 10.0
            exponent = exponent - 1
        }
        if (exponent >= -4 && exponent < precision) {
            int frac_digits = precision - 1 - exponent
            if (frac_digits < 0) {
                frac_digits = 0
            }
            string result = double_to_string(value, frac_digits)
            if (showpoint) {
                if (strfind(result, ".") < 0) {
                    result = strconcat(result, ".")
                }
            } else {
                result = __st_strip_trailing_zeros(result)
            }
            if (upper) {
                result = strupper(result)
            }
            return result
        }
        int frac_digits = precision - 1
        if (frac_digits < 0) {
            frac_digits = 0
        }
        string mantissa = double_to_string(abs_val, frac_digits)
        if (showpoint) {
            if (strfind(mantissa, ".") < 0) {
                mantissa = strconcat(mantissa, ".")
            }
        } else {
            mantissa = __st_strip_trailing_zeros(mantissa)
        }
        string result = strconcat(mantissa, __st_format_exponent(exponent, upper))
        if (negative) {
            result = strconcat("-", result)
        }
        return result
    }

    string __st_format_double(double value, int precision, int flags) {
        bool upper = (flags & 32) != 0
        bool showpoint = (flags & 16) != 0
        bool scientific = (flags & 64) != 0
        bool fixed = (flags & 128) != 0
        if (scientific && !fixed) {
            return __st_format_double_scientific(value, precision, upper, showpoint)
        }
        if (fixed && !scientific) {
            return __st_format_double_fixed(value, precision, upper, showpoint)
        }
        return __st_format_double_default(value, precision, upper, showpoint)
    }

    string __st_apply_width(string text, int width, char fill_char, int flags) {
        int n = strlen(text)
        if (width <= n) {
            return text
        }
        int pad = width - n
        int align = flags & (1 | 2 | 4)
        if (align == 0) {
            align = 2
        }
        if (align == 1) {
            string pad_str = string_repeat(char_to_string(fill_char), pad)
            return strconcat(text, pad_str)
        }
        if (align == 4) {
            int prefix_end = 0
            if (n > 0) {
                char c0 = strcharat(text, 0)
                if (c0 == '-' || c0 == '+') {
                    prefix_end = 1
                }
                if (prefix_end + 1 < n) {
                    char c1 = strcharat(text, prefix_end)
                    if (c1 == '0') {
                        char c2 = strcharat(text, prefix_end + 1)
                        if (c2 == 'x' || c2 == 'X') {
                            prefix_end = prefix_end + 2
                        }
                    }
                }
            }
            string pad_str = string_repeat(char_to_string(fill_char), pad)
            string head = strsubstr(text, 0, prefix_end)
            string tail = strsubstr(text, prefix_end, n - prefix_end)
            return strconcat(head, strconcat(pad_str, tail))
        }
        string pad_str = string_repeat(char_to_string(fill_char), pad)
        return strconcat(pad_str, text)
    }

    int __st_read_token(stream* s, string* out) {
        while (true) {
            int n = strlen(s->line_buffer)
            while (s->line_pos < n) {
                char c = strcharat(s->line_buffer, s->line_pos)
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                    s->line_pos = s->line_pos + 1
                } else {
                    break
                }
            }
            if (s->line_pos < n) {
                break
            }
            string line = ""
            int got = s->read(s, &line)
            if (got < 0) {
                *out = ""
                return -1
            }
            if (got == 0 && strlen(line) == 0) {
                *out = ""
                return 0
            }
            s->line_buffer = line
            s->line_pos = 0
        }
        int n = strlen(s->line_buffer)
        int start = s->line_pos
        while (s->line_pos < n) {
            char c = strcharat(s->line_buffer, s->line_pos)
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                break
            }
            s->line_pos = s->line_pos + 1
        }
        *out = strsubstr(s->line_buffer, start, s->line_pos - start)
        return strlen(*out)
    }

    int __st_char_to_digit(char c, int base) {
        int d = -1
        if (c >= '0' && c <= '9') {
            d = cast<int>(c - '0')
        } else {
            if (c >= 'a' && c <= 'z') {
                d = cast<int>(c - 'a') + 10
            } else {
                if (c >= 'A' && c <= 'Z') {
                    d = cast<int>(c - 'A') + 10
                }
            }
        }
        if (d >= base) {
            return -1
        }
        return d
    }

    bool __st_parse_luint_base(string token, luint* out, int base) {
        if (strlen(token) == 0) {
            return false
        }
        int i = 0
        int n = strlen(token)
        if (strcharat(token, 0) == '+') {
            i = 1
        }
        if (i >= n) {
            return false
        }
        if (base == 16 && i + 1 < n) {
            char c0 = strcharat(token, i)
            char c1 = strcharat(token, i + 1)
            if (c0 == '0' && (c1 == 'x' || c1 == 'X')) {
                i = i + 2
            }
        }
        if (i >= n) {
            return false
        }
        luint result = 0lu
        while (i < n) {
            char c = strcharat(token, i)
            int d = __st_char_to_digit(c, base)
            if (d < 0) {
                return false
            }
            result = result * cast<luint>(base) + cast<luint>(d)
            i = i + 1
        }
        *out = result
        return true
    }

    bool __st_parse_lint_base(string token, lint* out, int base) {
        if (strlen(token) == 0) {
            return false
        }
        int i = 0
        int n = strlen(token)
        bool negative = false
        if (strcharat(token, 0) == '-') {
            negative = true
            i = 1
        } else {
            if (strcharat(token, 0) == '+') {
                i = 1
            }
        }
        if (i >= n) {
            return false
        }
        if (base == 16 && i + 1 < n) {
            char c0 = strcharat(token, i)
            char c1 = strcharat(token, i + 1)
            if (c0 == '0' && (c1 == 'x' || c1 == 'X')) {
                i = i + 2
            }
        }
        if (i >= n) {
            return false
        }
        luint magnitude = 0lu
        while (i < n) {
            char c = strcharat(token, i)
            int d = __st_char_to_digit(c, base)
            if (d < 0) {
                return false
            }
            magnitude = magnitude * cast<luint>(base) + cast<luint>(d)
            i = i + 1
        }
        if (negative) {
            *out = 0l - cast<lint>(magnitude)
        } else {
            *out = cast<lint>(magnitude)
        }
        return true
    }

    bool __st_parse_int_base(string token, int* out, int base) {
        lint tmp = 0l
        if (!__st_parse_lint_base(token, &tmp, base)) {
            return false
        }
        *out = cast<int>(tmp)
        return true
    }

    bool __st_parse_uint_base(string token, uint* out, int base) {
        luint tmp = 0lu
        if (!__st_parse_luint_base(token, &tmp, base)) {
            return false
        }
        *out = cast<uint>(tmp)
        return true
    }

    void end_line(stream* s) {
        if (s == null) {
            return
        }
        s->write(s, "\n")
        s->flush(s)
    }

    void stream_flush(stream* s) {
        if (s == null) {
            return
        }
        s->flush(s)
    }

    void dec(stream* s) {
        if (s == null) { return; }
        s->base = 10
    }

    void hex(stream* s) {
        if (s == null) { return; }
        s->base = 16
    }

    void oct(stream* s) {
        if (s == null) { return; }
        s->base = 8
    }

    void bool_alpha(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags | 256
    }

    void no_bool_alpha(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 256)
    }

    void show_base(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags | 8
    }

    void no_show_base(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 8)
    }

    void show_pos(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags | 512
    }

    void no_show_pos(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 512)
    }

    void left(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - (2 | 4))
        s->flags = s->flags | 1
    }

    void right(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - (1 | 4))
        s->flags = s->flags | 2
    }

    void internal(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - (1 | 2))
        s->flags = s->flags | 4
    }

    void upper_case(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags | 32
    }

    void no_upper_case(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 32)
    }

    void show_point(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags | 16
    }

    void no_show_point(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 16)
    }

    void scientific(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 128)
        s->flags = s->flags | 64
    }

    void fixed(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - 64)
        s->flags = s->flags | 128
    }

    void default_float_format(stream* s) {
        if (s == null) { return; }
        s->flags = s->flags & (0 - 1 - (64 | 128))
    }

    __set_width set_width(int n) {
        __set_width m = {n}
        return m
    }

    __set_precision set_precision(int n) {
        __set_precision m = {n}
        return m
    }

    __set_fill set_fill(char c) {
        __set_fill m = {c}
        return m
    }

    stream* console_out = null
    stream* console_in = null

    struct __stream_init_guard {
        constructor () {
            console_out = make_console_out()
            console_in = make_console_in()
        }
        destructor () {
            if (console_out != null) {
                destruct console_out
                console_out = null
            }
            if (console_in != null) {
                destruct console_in
                console_in = null
            }
        }
    }

    __stream_init_guard __stream_init

    void init_streams() {
        if (console_out == null) {
            console_out = make_console_out()
        }
        if (console_in == null) {
            console_in = make_console_in()
        }
    }

    stream* operator << (stream* s, string value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        string text = value
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, int value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        bool upper_case = (s->flags & 32) != 0
        bool show_base = (s->flags & 8) != 0
        bool show_pos = (s->flags & 512) != 0
        string text = __st_format_lint(cast<lint>(value), s->base, upper_case, show_base)
        if (show_pos && value >= 0) {
            text = strconcat("+", text)
        }
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, lint value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        bool upper_case = (s->flags & 32) != 0
        bool show_base = (s->flags & 8) != 0
        bool show_pos = (s->flags & 512) != 0
        string text = __st_format_lint(value, s->base, upper_case, show_base)
        if (show_pos && value >= 0l) {
            text = strconcat("+", text)
        }
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, uint value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        bool upper_case = (s->flags & 32) != 0
        bool show_base = (s->flags & 8) != 0
        bool show_pos = (s->flags & 512) != 0
        string text = __st_format_luint(cast<luint>(value), s->base, upper_case, show_base)
        if (show_pos) {
            text = strconcat("+", text)
        }
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, luint value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        bool upper_case = (s->flags & 32) != 0
        bool show_base = (s->flags & 8) != 0
        bool show_pos = (s->flags & 512) != 0
        string text = __st_format_luint(value, s->base, upper_case, show_base)
        if (show_pos) {
            text = strconcat("+", text)
        }
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, double value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        string text = __st_format_double(value, s->precision, s->flags)
        if ((s->flags & 512) != 0) {
            if (value >= 0.0) {
                text = strconcat("+", text)
            }
        }
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, float value) {
        return s << cast<double>(value)
    }

    stream* operator << (stream* s, char value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        string text = char_to_string(value)
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, uchar value) {
        return s << cast<char>(value)
    }

    stream* operator << (stream* s, bool value) {
        if (s == null) { return s }
        if (s->state != 0) { return s }
        string text = ""
        if ((s->flags & 256) != 0) {
            text = bool_to_string(value)
        } else {
            if (value) {
                text = "1"
            } else {
                text = "0"
            }
        }
        if (s->width > 0) {
            text = __st_apply_width(text, s->width, s->fill_char, s->flags)
            s->width = 0
        }
        s->write(s, text)
        return s
    }

    stream* operator << (stream* s, void manip(stream*)*) {
        if (s != null && manip != null) {
            manip(s)
        }
        return s
    }

    stream* operator << (stream* s, __set_width m) {
        if (s != null) {
            s->width = m.value
        }
        return s
    }

    stream* operator << (stream* s, __set_precision m) {
        if (s != null) {
            s->precision = m.value
        }
        return s
    }

    stream* operator << (stream* s, __set_fill m) {
        if (s != null) {
            s->fill_char = m.value
        }
        return s
    }

    stream* operator >> (stream* s, int* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        if (!__st_parse_int_base(token, value, s->base)) {
            s->state = s->state | 2
        }
        return s
    }

    stream* operator >> (stream* s, lint* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        if (!__st_parse_lint_base(token, value, s->base)) {
            s->state = s->state | 2
        }
        return s
    }

    stream* operator >> (stream* s, uint* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        if (!__st_parse_uint_base(token, value, s->base)) {
            s->state = s->state | 2
        }
        return s
    }

    stream* operator >> (stream* s, luint* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        if (!__st_parse_luint_base(token, value, s->base)) {
            s->state = s->state | 2
        }
        return s
    }

    stream* operator >> (stream* s, double* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        if (!parse_double(token, value)) {
            s->state = s->state | 2
        }
        return s
    }

    stream* operator >> (stream* s, float* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        double tmp = 0.0
        if (!parse_double(token, &tmp)) {
            s->state = s->state | 2
        } else {
            *value = cast<float>(tmp)
        }
        return s
    }

    stream* operator >> (stream* s, char* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        *value = strcharat(token, 0)
        return s
    }

    stream* operator >> (stream* s, bool* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        string token = ""
        int n = __st_read_token(s, &token)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
            return s
        }
        if (strcompare(token, "true") == 0 || strcompare(token, "1") == 0) {
            *value = true
        } else {
            if (strcompare(token, "false") == 0 || strcompare(token, "0") == 0) {
                *value = false
            } else {
                s->state = s->state | 2
            }
        }
        return s
    }

    stream* operator >> (stream* s, string* value) {
        if (s == null || value == null) { return s }
        if (s->state != 0) { return s }
        int n = __st_read_token(s, value)
        if (n < 0) {
            s->state = s->state | 4
            return s
        }
        if (n == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
        }
        return s
    }

    stream* get_line(stream* s, string* value) {
        if (s == null || value == null) { return s }
        if (s->line_pos < strlen(s->line_buffer)) {
            int n = strlen(s->line_buffer)
            int start = s->line_pos
            int i = start
            while (i < n) {
                if (strcharat(s->line_buffer, i) == '\n') {
                    break
                }
                i = i + 1
            }
            *value = strsubstr(s->line_buffer, start, i - start)
            s->line_pos = i + 1
            if (s->line_pos >= n) {
                s->line_buffer = ""
                s->line_pos = 0
            }
            return s
        }
        string line = ""
        int got = s->read(s, &line)
        if (got < 0) {
            s->state = s->state | 4
            return s
        }
        if (got == 0 && strlen(line) == 0) {
            s->state = s->state | 1
            s->state = s->state | 2
        }
        *value = line
        s->line_buffer = ""
        s->line_pos = 0
        return s
    }

} // namespace sl
