guide "sl.glt"

addition namespace sl {

    generics dynamic_array_generic<T: int | lint | uint | luint | float | double | char | uchar | bool | string> {
        struct dynamic_array {
            T* data
            int size
            int capacity

            constructor () {
                data = null
                size = 0
                capacity = 0
            }

            constructor (int cap) {
                if (cap <= 0) {
                    data = null
                    size = 0
                    capacity = 0
                    return
                }

                T* p = heap(T, cap)
                if (p == null) {
                    data = null
                    size = 0
                    capacity = 0
                    return
                }

                data = p
                size = 0
                capacity = cap
            }

            destructor () {
                if (data != null) {
                    for (int i = 0; i < size; i++) {
                        T discarded = move(data[i])
                    }
                    free(data)
                    data = null
                }
                size = 0
                capacity = 0
            }

            copy_constructor (dynamic_array* other) {
                data = null
                size = 0
                capacity = 0

                if (other == null) {
                    return
                }

                if (other->capacity <= 0 || other->data == null) {
                    return
                }

                if (other->size < 0 || other->size > other->capacity) {
                    return
                }

                T* p = heap(T, other->capacity)
                if (p == null) {
                    return
                }

                for (int i = 0; i < other->size; i++) {
                    p[i] = other->data[i]
                }

                data = p
                size = other->size
                capacity = other->capacity
            }

            move_constructor (dynamic_array* other) {
                data = null
                size = 0
                capacity = 0

                if (other == null) {
                    return
                }

                if (other->data == null || other->size < 0 || other->size > other->capacity) {
                    other->data = null
                    other->size = 0
                    other->capacity = 0
                    return
                }

                data = other->data
                size = other->size
                capacity = other->capacity

                other->data = null
                other->size = 0
                other->capacity = 0
            }

            copy_assignment (dynamic_array* other) {
                if (other == null) {
                    return
                }

                if (other->data == data) {
                    size = other->size
                    capacity = other->capacity
                    return
                }

                if (other->capacity <= 0 || other->data == null || other->size < 0 || other->size > other->capacity) {
                    if (data != null) {
                        for (int i = 0; i < size; i++) {
                            T discarded = move(data[i])
                        }
                        free(data)
                        data = null
                    }
                    size = 0
                    capacity = 0
                    return
                }

                T* p = heap(T, other->capacity)
                if (p == null) {
                    return
                }

                for (int i = 0; i < other->size; i++) {
                    p[i] = other->data[i]
                }

                if (data != null) {
                    for (int i = 0; i < size; i++) {
                        T discarded = move(data[i])
                    }
                    free(data)
                }

                data = p
                size = other->size
                capacity = other->capacity
            }

            move_assignment (dynamic_array* other) {
                if (other == null) {
                    return
                }

                if (other->data == data) {
                    return
                }

                if (other->data == null || other->size < 0 || other->size > other->capacity) {
                    if (data != null) {
                        for (int i = 0; i < size; i++) {
                            T discarded = move(data[i])
                        }
                        free(data)
                        data = null
                    }
                    size = 0
                    capacity = 0

                    other->data = null
                    other->size = 0
                    other->capacity = 0
                    return
                }

                if (data != null) {
                    for (int i = 0; i < size; i++) {
                        T discarded = move(data[i])
                    }
                    free(data)
                    data = null
                }

                data = other->data
                size = other->size
                capacity = other->capacity

                other->data = null
                other->size = 0
                other->capacity = 0
            }
        }

        T zero_value() {
            T dummy
            const if (T.is_string == true) {
                dummy = ""
            } const else {
                const if (T.is_bool == true) {
                    dummy = false
                } const else {
                    dummy = 0
                }
            }
            return dummy
        }

        int length(dynamic_array* arr) {
            if (arr == null) {
                return 0
            }
            return arr->size
        }

        int get_capacity(dynamic_array* arr) {
            if (arr == null) {
                return 0
            }
            return arr->capacity
        }

        bool empty(dynamic_array* arr) {
            if (arr == null) {
                return true
            }
            return arr->size == 0
        }

        void clear(dynamic_array* arr) {
            if (arr == null) {
                return
            }
            for (int i = 0; i < arr->size; i++) {
                arr->data[i] = zero_value()
            }
            arr->size = 0
        }

        T get(dynamic_array* arr, int index) {
            if (arr == null || index < 0 || index >= arr->size) {
                return zero_value()
            }
            return arr->data[index]
        }

        void set(dynamic_array* arr, int index, T value) {
            if (arr == null || index < 0 || index >= arr->size) {
                return
            }
            arr->data[index] = value
        }

        T front(dynamic_array* arr) {
            if (arr == null || arr->size == 0) {
                return zero_value()
            }
            return arr->data[0]
        }

        T back(dynamic_array* arr) {
            if (arr == null || arr->size == 0) {
                return zero_value()
            }
            return arr->data[arr->size - 1]
        }

        T* data_ptr(dynamic_array* arr) {
            if (arr == null) {
                return null
            }
            return arr->data
        }

        bool reserve(dynamic_array* arr, int new_capacity) {
            if (arr == null) {
                return false
            }

            if (new_capacity < 0) {
                return false
            }

            if (new_capacity <= arr->capacity) {
                return true
            }

            if (new_capacity > 1073741823) {
                return false
            }

            T* new_data = heap(T, new_capacity)
            if (new_data == null) {
                return false
            }

            for (int i = 0; i < arr->size; i++) {
                new_data[i] = arr->data[i]
            }

            if (arr->data != null) {
                for (int i = 0; i < arr->size; i++) {
                    arr->data[i] = zero_value()
                }
                free(arr->data)
            }

            arr->data = new_data
            arr->capacity = new_capacity
            return true
        }

        void push(dynamic_array* arr, T value) {
            if (arr == null) {
                return
            }

            if (arr->size >= arr->capacity) {
                if (arr->capacity > 1073741823 / 2) {
                    return
                }

                int new_capacity = 1
                if (arr->capacity > 0) {
                    new_capacity = arr->capacity * 2
                }

                if (!reserve(arr, new_capacity)) {
                    return
                }
            }

            arr->data[arr->size] = value
            arr->size = arr->size + 1
        }

        T pop(dynamic_array* arr) {
            if (arr == null || arr->size == 0) {
                return zero_value()
            }

            arr->size = arr->size - 1
            T result = arr->data[arr->size]
            arr->data[arr->size] = zero_value()
            return result
        }

        bool insert(dynamic_array* arr, int index, T value) {
            if (arr == null) {
                return false
            }
            if (index < 0 || index > arr->size) {
                return false
            }

            if (arr->size >= arr->capacity) {
                if (arr->capacity > 1073741823 / 2) {
                    return false
                }

                int new_capacity = 1
                if (arr->capacity > 0) {
                    new_capacity = arr->capacity * 2
                }

                if (!reserve(arr, new_capacity)) {
                    return false
                }
            }

            for (int i = arr->size; i > index; i--) {
                arr->data[i] = arr->data[i - 1]
            }

            arr->data[index] = value
            arr->size = arr->size + 1
            return true
        }

        bool erase(dynamic_array* arr, int index) {
            if (arr == null) {
                return false
            }
            if (index < 0 || index >= arr->size) {
                return false
            }

            for (int i = index; i < arr->size - 1; i++) {
                arr->data[i] = arr->data[i + 1]
            }

            arr->size = arr->size - 1
            arr->data[arr->size] = zero_value()
            return true
        }

        bool resize(dynamic_array* arr, int new_size) {
            if (arr == null) {
                return false
            }
            if (new_size < 0) {
                return false
            }
            if (new_size == arr->size) {
                return true
            }

            if (new_size > arr->capacity) {
                if (!reserve(arr, new_size)) {
                    return false
                }
            }

            if (new_size > arr->size) {
                for (int i = arr->size; i < new_size; i++) {
                    arr->data[i] = zero_value()
                }
            } else {
                for (int i = new_size; i < arr->size; i++) {
                    arr->data[i] = zero_value()
                }
            }

            arr->size = new_size
            return true
        }

        bool __value_equals(T a, T b) {
            const if (T.is_string == true) {
                return strcompare(a, b) == 0
            } const else {
                return a == b
            }
        }

        int index_of(dynamic_array* arr, T value) {
            if (arr == null) {
                return -1
            }
            for (int i = 0; i < arr->size; i++) {
                if (__value_equals(arr->data[i], value)) {
                    return i
                }
            }
            return -1
        }

        bool contains(dynamic_array* arr, T value) {
            int index = index_of(arr, value)
            if (index >= 0) {
                return true
            }
            return false
        }

        void reverse(dynamic_array* arr) {
            if (arr == null) {
                return
            }
            if (arr->size < 2) {
                return
            }
            int left = 0
            int right = arr->size - 1
            while (left < right) {
                T temp = arr->data[left]
                arr->data[left] = arr->data[right]
                arr->data[right] = temp
                left = left + 1
                right = right - 1
            }
        }

        void fill(dynamic_array* arr, T value) {
            if (arr == null) {
                return
            }
            for (int i = 0; i < arr->size; i++) {
                arr->data[i] = value
            }
        }

        bool append_array(dynamic_array* arr, dynamic_array* other) {
            if (arr == null || other == null) {
                return false
            }
            int incoming = other->size
            if (incoming == 0) {
                return true
            }
            if (arr->size > 1073741823 - incoming) {
                return false
            }
            int needed = arr->size + incoming
            if (!reserve(arr, needed)) {
                return false
            }
            for (int i = 0; i < incoming; i++) {
                if (arr->size >= arr->capacity) {
                    return false
                }
                arr->data[arr->size] = other->data[i]
                arr->size = arr->size + 1
            }
            return true
        }

        bool copy_to(dynamic_array* dst, dynamic_array* src) {
            if (dst == null || src == null) {
                return false
            }
            if (dst == src) {
                return true
            }
            if (!resize(dst, src->size)) {
                return false
            }
            for (int i = 0; i < src->size; i++) {
                dst->data[i] = src->data[i]
            }
            return true
        }
    }

    generics hash_table_generic<K: int | lint | uint | luint | char | uchar | bool | string, V: int | lint | uint | luint | float | double | char | uchar | bool | string> {
        struct hash_table {
            K* keys
            V* values
            int* states
            int capacity
            int count
            int used

            constructor () {
                keys = null
                values = null
                states = null
                capacity = 0
                count = 0
                used = 0
            }

            constructor (int cap) {
                keys = null
                values = null
                states = null
                capacity = 0
                count = 0
                used = 0

                if (cap > 0 && cap <= 1073741823) {
                    K* new_keys = heap(K, cap)
                    V* new_values = heap(V, cap)
                    int* new_states = heap(int, cap)
                    if (new_keys != null && new_values != null && new_states != null) {
                        keys = new_keys
                        values = new_values
                        states = new_states
                        capacity = cap
                    } else {
                        free(new_keys)
                        free(new_values)
                        free(new_states)
                    }
                }
            }

            destructor () {
                if (values != null) {
                    for (int i = 0; i < capacity; i++) {
                        if (states[i] == 1) {
                            V discarded = move(values[i])
                        }
                    }
                }
                if (keys != null) {
                    if (states != null) {
                        for (int i = 0; i < capacity; i++) {
                            if (states[i] == 1) {
                                K discarded_key = move(keys[i])
                            }
                        }
                    }
                    free(keys)
                    keys = null
                }
                if (values != null) {
                    free(values)
                    values = null
                }
                if (states != null) {
                    free(states)
                    states = null
                }
                capacity = 0
                count = 0
                used = 0
            }

            copy_constructor (hash_table* other) {
                keys = null
                values = null
                states = null
                capacity = 0
                count = 0
                used = 0

                if (other == null) {
                    return
                }

                if (other->capacity <= 0 || other->keys == null || other->values == null || other->states == null) {
                    return
                }

                K* new_keys = heap(K, other->capacity)
                V* new_values = heap(V, other->capacity)
                int* new_states = heap(int, other->capacity)
                if (new_keys == null || new_values == null || new_states == null) {
                    free(new_keys)
                    free(new_values)
                    free(new_states)
                    return
                }

                for (int i = 0; i < other->capacity; i++) {
                    new_states[i] = other->states[i]
                    if (other->states[i] == 1) {
                        new_keys[i] = other->keys[i]
                        new_values[i] = other->values[i]
                    }
                }

                keys = new_keys
                values = new_values
                states = new_states
                capacity = other->capacity
                count = other->count
                used = other->used
            }

            move_constructor (hash_table* other) {
                keys = null
                values = null
                states = null
                capacity = 0
                count = 0
                used = 0

                if (other == null) {
                    return
                }

                keys = other->keys
                values = other->values
                states = other->states
                capacity = other->capacity
                count = other->count
                used = other->used

                other->keys = null
                other->values = null
                other->states = null
                other->capacity = 0
                other->count = 0
                other->used = 0
            }

            copy_assignment (hash_table* other) {
                if (other == null) {
                    return
                }

                if (other->keys == keys && other->values == values && other->states == states) {
                    capacity = other->capacity
                    count = other->count
                    used = other->used
                    return
                }

                if (other->capacity <= 0 || other->keys == null || other->values == null || other->states == null) {
                    if (values != null) {
                        for (int i = 0; i < capacity; i++) {
                            if (states[i] == 1) {
                                V discarded = move(values[i])
                            }
                        }
                        free(values)
                        values = null
                    }
                    if (keys != null) {
                        if (states != null) {
                            for (int i = 0; i < capacity; i++) {
                                if (states[i] == 1) {
                                    K discarded_key = move(keys[i])
                                }
                            }
                        }
                        free(keys)
                        keys = null
                    }
                    if (states != null) {
                        free(states)
                        states = null
                    }
                    capacity = 0
                    count = 0
                    used = 0
                    return
                }

                K* new_keys = heap(K, other->capacity)
                V* new_values = heap(V, other->capacity)
                int* new_states = heap(int, other->capacity)
                if (new_keys == null || new_values == null || new_states == null) {
                    free(new_keys)
                    free(new_values)
                    free(new_states)
                    return
                }

                for (int i = 0; i < other->capacity; i++) {
                    new_states[i] = other->states[i]
                    if (other->states[i] == 1) {
                        new_keys[i] = other->keys[i]
                        new_values[i] = other->values[i]
                    }
                }

                if (values != null) {
                    for (int i = 0; i < capacity; i++) {
                        if (states[i] == 1) {
                            V discarded = move(values[i])
                        }
                    }
                    free(values)
                }
                if (keys != null) {
                    if (states != null) {
                        for (int i = 0; i < capacity; i++) {
                            if (states[i] == 1) {
                                K discarded_key = move(keys[i])
                            }
                        }
                    }
                    free(keys)
                }
                if (states != null) {
                    free(states)
                }

                keys = new_keys
                values = new_values
                states = new_states
                capacity = other->capacity
                count = other->count
                used = other->used
            }

            move_assignment (hash_table* other) {
                if (other == null) {
                    return
                }

                if (other->keys == keys && other->values == values && other->states == states) {
                    return
                }

                if (values != null) {
                    for (int i = 0; i < capacity; i++) {
                        if (states[i] == 1) {
                            V discarded = move(values[i])
                        }
                    }
                    free(values)
                    values = null
                }
                if (keys != null) {
                    if (states != null) {
                        for (int i = 0; i < capacity; i++) {
                            if (states[i] == 1) {
                                K discarded_key = move(keys[i])
                            }
                        }
                    }
                    free(keys)
                    keys = null
                }
                if (states != null) {
                    free(states)
                    states = null
                }
                capacity = 0
                count = 0
                used = 0

                keys = other->keys
                values = other->values
                states = other->states
                capacity = other->capacity
                count = other->count
                used = other->used

                other->keys = null
                other->values = null
                other->states = null
                other->capacity = 0
                other->count = 0
                other->used = 0
            }
        }

        bool __key_equals(K a, K b) {
            const if (K.is_string == true) {
                return strcompare(a, b) == 0
            } const else {
                return a == b
            }
        }

        const if (V.is_string == true) {
            emit {
                V zero_value() {
                    string empty_value = ""
                    return empty_value
                }
            }
        } const else {
            const if (V.is_bool == true) {
                emit {
                    V zero_value() {
                        return false
                    }
                }
            } const else {
                emit {
                    V zero_value() {
                        return 0
                    }
                }
            }
        }

        luint __hash_value(K key) {
            luint mixed = 0lu

            const if (K.is_string == true) {
                mixed = 2166136261lu
                int n = strlen(key)
                for (int i = 0; i < n; i++) {
                    luint code = cast<luint>(cast<uchar>(strcharat(key, i)))
                    mixed = mixed ^ code
                    mixed = mixed * 1099511628211lu
                }
            } const else {
                mixed = cast<luint>(key)
                mixed = mixed * 1099511628211lu
            }

            mixed = mixed % 4294967291lu
            return mixed
        }

        int __hash_slot(hash_table* table, K key) {
            if (table == null || table->capacity <= 0) {
                return 0
            }
            return cast<int>(__hash_value(key) % cast<luint>(table->capacity))
        }

        int __locate(hash_table* table, K key) {
            int found = -1
            if (table != null && table->capacity > 0 && table->states != null) {
                int start = __hash_slot(table, key)
                int i = 0
                bool stop = false
                while (i < table->capacity && stop == false) {
                    int index = start + i
                    if (index >= table->capacity) {
                        index = index - table->capacity
                    }
                    int state = table->states[index]
                    if (state == 0) {
                        stop = true
                    } else {
                        if (state == 1 && __key_equals(table->keys[index], key)) {
                            found = index
                            stop = true
                        }
                    }
                    i = i + 1
                }
            }
            return found
        }

        int __probe_slot(hash_table* table, K key) {
            int slot = -1
            if (table != null && table->capacity > 0 && table->states != null) {
                int start = __hash_slot(table, key)
                int i = 0
                bool stop = false
                while (i < table->capacity && stop == false) {
                    int index = start + i
                    if (index >= table->capacity) {
                        index = index - table->capacity
                    }
                    int state = table->states[index]
                    if (state == 1) {
                        if (__key_equals(table->keys[index], key)) {
                            slot = index
                            stop = true
                        }
                    } else {
                        if (slot < 0) {
                            slot = index
                        }
                        if (state == 0) {
                            stop = true
                        }
                    }
                    i = i + 1
                }
            }
            return slot
        }

        int length(hash_table* table) {
            if (table == null) {
                return 0
            }
            return table->count
        }

        int get_capacity(hash_table* table) {
            if (table == null) {
                return 0
            }
            return table->capacity
        }

        bool empty(hash_table* table) {
            if (table == null) {
                return true
            }
            return table->count == 0
        }

        void clear(hash_table* table) {
            if (table != null && table->states != null) {
                for (int i = 0; i < table->capacity; i++) {
                    if (table->states[i] == 1) {
                        K discarded_key = move(table->keys[i])
                        table->values[i] = zero_value()
                    }
                    table->states[i] = 0
                }
                table->count = 0
                table->used = 0
            }
        }

        bool contains(hash_table* table, K key) {
            return __locate(table, key) >= 0
        }

        bool get(hash_table* table, K key, V* out) {
            bool found = false
            if (out != null) {
                int index = __locate(table, key)
                if (index >= 0) {
                    *out = table->values[index]
                    found = true
                }
            }
            return found
        }

        bool reserve(hash_table* table, int new_capacity) {
            bool ok = false
            if (table != null && new_capacity > 0 && new_capacity <= 1073741823) {
                if (new_capacity <= table->capacity) {
                    ok = true
                } else {
                    K* new_keys = heap(K, new_capacity)
                    V* new_values = heap(V, new_capacity)
                    int* new_states = heap(int, new_capacity)
                    if (new_keys != null && new_values != null && new_states != null) {
                        for (int i = 0; i < new_capacity; i++) {
                            new_states[i] = 0
                        }

                        ok = true
                        int moved = 0
                        for (int i = 0; i < table->capacity; i++) {
                            if (table->states[i] == 1) {
                                int target = cast<int>(__hash_value(table->keys[i]) % cast<luint>(new_capacity))
                                int guard = 0
                                while (new_states[target] != 0 && guard < new_capacity) {
                                    target = target + 1
                                    if (target >= new_capacity) {
                                        target = 0
                                    }
                                    guard = guard + 1
                                }

                                if (new_states[target] == 0) {
                                    new_keys[target] = move(table->keys[i])
                                    new_values[target] = table->values[i]
                                    new_states[target] = 1
                                    table->values[i] = zero_value()
                                    moved = moved + 1
                                }
                            }
                        }
                        ok = moved == table->count
                    }

                    if (ok) {
                        if (table->keys != null) {
                            free(table->keys)
                        }
                        if (table->values != null) {
                            free(table->values)
                        }
                        if (table->states != null) {
                            free(table->states)
                        }
                        table->keys = new_keys
                        table->values = new_values
                        table->states = new_states
                        table->capacity = new_capacity
                        table->used = table->count
                    } else {
                        free(new_keys)
                        free(new_values)
                        free(new_states)
                    }
                }
            }
            return ok
        }

        bool set(hash_table* table, K key, V value) {
            bool stored = false
            if (table != null && table->capacity > 0 && table->states != null) {
                if ((table->used + 1) * 4 >= table->capacity * 3) {
                    if (table->capacity <= 1073741823 / 2) {
                        reserve(table, table->capacity * 2)
                    }
                }

                if (table->used < table->capacity) {
                    int index = __probe_slot(table, key)
                    if (index >= 0) {
                        int state = table->states[index]
                        table->keys[index] = key
                        table->values[index] = value
                        if (state == 0) {
                            table->used = table->used + 1
                            table->count = table->count + 1
                        } else {
                            if (state == 2) {
                                table->count = table->count + 1
                            }
                        }
                        table->states[index] = 1
                        stored = true
                    }
                }
            }
            return stored
        }

        bool erase(hash_table* table, K key) {
            int index = __locate(table, key)
            if (index >= 0) {
                K discarded_key = move(table->keys[index])
                table->values[index] = zero_value()
                table->states[index] = 2
                table->count = table->count - 1
            }
            return index >= 0
        }

        bool contains_key(hash_table* table, K key) {
            if (table == null) {
                return false
            }
            return __locate(table, key) >= 0
        }

        V get_or_default(hash_table* table, K key, V default_value) {
            V result = default_value
            if (table != null) {
                int index = __locate(table, key)
                if (index >= 0) {
                    result = table->values[index]
                }
            }
            return result
        }

        int keys_to_array(hash_table* table, K* out, int capacity) {
            if (table == null || out == null || capacity <= 0) {
                return 0
            }
            if (table->states == null) {
                return 0
            }
            int copied = 0
            for (int i = 0; i < table->capacity; i++) {
                if (copied >= capacity) {
                    break
                }
                if (table->states[i] == 1) {
                    out[copied] = table->keys[i]
                    copied = copied + 1
                }
            }
            return copied
        }

        int values_to_array(hash_table* table, V* out, int capacity) {
            if (table == null || out == null || capacity <= 0) {
                return 0
            }
            if (table->states == null) {
                return 0
            }
            int copied = 0
            for (int i = 0; i < table->capacity; i++) {
                if (copied >= capacity) {
                    break
                }
                if (table->states[i] == 1) {
                    out[copied] = table->values[i]
                    copied = copied + 1
                }
            }
            return copied
        }
    }

    generics swap_generic<T> {
        bool swap(T* a, T* b) {
            if (a == null || b == null) {
                return false
            }
            if (a == b) {
                return true
            }

            T temp = *a
            *a = *b
            *b = temp
            return true
        }
    }

    generics sort_generic<T> {
        void __insertion_sort_impl(T* data, int left, int right, int compare(T, T)*) {
            for (int i = left + 1; i <= right; i++) {
                T key = data[i]
                int j = i - 1
                while (j >= left && compare(data[j], key) > 0) {
                    data[j + 1] = data[j]
                    j = j - 1
                }
                data[j + 1] = key
            }
        }

        void __heap_sift_down_impl(T* data, int base, int start, int end, int compare(T, T)*) {
            int root = start
            while (root * 2 + 1 <= end) {
                int child = root * 2 + 1
                if (child + 1 <= end && compare(data[base + child], data[base + child + 1]) < 0) {
                    child = child + 1
                }
                if (compare(data[base + root], data[base + child]) < 0) {
                    T temp = data[base + root]
                    data[base + root] = data[base + child]
                    data[base + child] = temp
                    root = child
                } else {
                    return
                }
            }
        }

        void __heap_sort_impl(T* data, int left, int right, int compare(T, T)*) {
            int n = right - left + 1

            for (int i = (n - 2) / 2; i >= 0; i--) {
                __heap_sift_down_impl(data, left, i, n - 1, compare)
            }

            for (int i = n - 1; i > 0; i--) {
                T temp = data[left]
                data[left] = data[left + i]
                data[left + i] = temp
                __heap_sift_down_impl(data, left, 0, i - 1, compare)
            }
        }

        int __median_of_three_impl(T* data, int a, int b, int c, int compare(T, T)*) {
            if (compare(data[a], data[b]) < 0) {
                if (compare(data[b], data[c]) < 0) {
                    return b
                }
                if (compare(data[a], data[c]) < 0) {
                    return c
                }
                return a
            } else {
                if (compare(data[a], data[c]) < 0) {
                    return a
                }
                if (compare(data[b], data[c]) < 0) {
                    return c
                }
                return b
            }
        }

        int __partition_impl(T* data, int left, int right, int compare(T, T)*) {
            int mid = left + (right - left) / 2
            int pivot_index = __median_of_three_impl(data, left, mid, right, compare)

            T temp = data[pivot_index]
            data[pivot_index] = data[right]
            data[right] = temp

            int store = left
            for (int i = left; i < right; i++) {
                if (compare(data[i], data[right]) < 0) {
                    T t = data[i]
                    data[i] = data[store]
                    data[store] = t
                    store = store + 1
                }
            }

            T t = data[store]
            data[store] = data[right]
            data[right] = t
            return store
        }

        void __intro_sort_impl(T* data, int left, int right, int depth_limit, int compare(T, T)*) {
            int n = right - left + 1
            if (n <= 16) {
                __insertion_sort_impl(data, left, right, compare)
                return
            }
            if (depth_limit <= 0) {
                __heap_sort_impl(data, left, right, compare)
                return
            }

            int pivot = __partition_impl(data, left, right, compare)
            __intro_sort_impl(data, left, pivot - 1, depth_limit - 1, compare)
            __intro_sort_impl(data, pivot + 1, right, depth_limit - 1, compare)
        }

        bool sort(T* data, int size, int compare(T, T)*) {
            if (data == null || compare == null) {
                return false
            }
            if (size <= 1) {
                return true
            }
            int depth_limit = 0
            int n = size
            while (n > 1) {
                n = n / 2
                depth_limit = depth_limit + 1
            }
            depth_limit = depth_limit * 2

            __intro_sort_impl(data, 0, size - 1, depth_limit, compare)
            return true
        }
    }

    generics array_length_generic<T, string array_name> {
        emit "luint array_length() {\n"
        emit "    " + T.typename + " first = " + array_name + "[0]\n"
        emit "    return size(" + array_name + ") / size(first)\n"
        emit "}\n"
    }

    generics offset_generic<T: struct, string member> {
        emit "luint offset(" + T.typename + "* ptr) {\n"
        emit "    luint base = cast<luint>(ptr)\n"
        emit "    luint mem = cast<luint>(&ptr->" + member + ")\n"
        emit "    return mem - base\n"
        emit "}\n"
    }

} // namespace sl
