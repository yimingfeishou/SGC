// common.glt
// Gallt Standard Library
// Naming Conventions: snake_case
// All standard library statements are stored in the sl namespace
// All standard libraries except for sl.glt itself, should import sl.glt and addition namespace sl
// Copyright (c) Yimingfeishou

guide "sl.glt"

addition namespace sl {

    extern int system from libucrt (string command)

    bool is_digit(char c) {
        if (c < '0') {
            return false
        }
        if (c > '9') {
            return false
        }
        return true
    }

    bool is_lower(char c) {
        if (c < 'a') {
            return false
        }
        if (c > 'z') {
            return false
        }
        return true
    }

    bool is_upper(char c) {
        if (c < 'A') {
            return false
        }
        if (c > 'Z') {
            return false
        }
        return true
    }

    bool is_alpha(char c) {
        bool lower = is_lower(c)
        if (lower) {
            return true
        }
        bool upper = is_upper(c)
        if (upper) {
            return true
        }
        return false
    }

    bool is_alnum(char c) {
        bool digit = is_digit(c)
        if (digit) {
            return true
        }
        bool alpha = is_alpha(c)
        if (alpha) {
            return true
        }
        return false
    }

    bool is_space(char c) {
        if (c == ' ') {
            return true
        }
        if (c == '\t') {
            return true
        }
        if (c == '\n') {
            return true
        }
        if (c == '\r') {
            return true
        }
        return false
    }

    bool is_hex_digit(char c) {
        bool digit = is_digit(c)
        if (digit) {
            return true
        }
        if (c >= 'a') {
            if (c <= 'f') {
                return true
            }
        }
        if (c >= 'A') {
            if (c <= 'F') {
                return true
            }
        }
        return false
    }

    bool is_octal_digit(char c) {
        if (c < '0') {
            return false
        }
        if (c > '7') {
            return false
        }
        return true
    }

    char to_upper(char c) {
        bool lower = is_lower(c)
        if (lower) {
            int code = int(c)
            int shifted = code - 32
            return char(shifted)
        }
        return c
    }

    char to_lower(char c) {
        bool upper = is_upper(c)
        if (upper) {
            int code = int(c)
            int shifted = code + 32
            return char(shifted)
        }
        return c
    }

    int hex_value(char c) {
        bool digit = is_digit(c)
        if (digit) {
            int code = int(c)
            return code - 48
        }
        if (c >= 'a') {
            if (c <= 'f') {
                int code = int(c)
                return code - 87
            }
        }
        if (c >= 'A') {
            if (c <= 'F') {
                int code = int(c)
                return code - 55
            }
        }
        return -1
    }

    bool string_is_empty(string s) {
        int n = strlen(s)
        if (n == 0) {
            return true
        }
        return false
    }

    bool string_equals(string a, string b) {
        int cmp = strcompare(a, b)
        if (cmp == 0) {
            return true
        }
        return false
    }

    bool string_starts_with(string s, string prefix) {
        int index = strfind(s, prefix)
        if (index == 0) {
            return true
        }
        return false
    }

    bool string_ends_with(string s, string suffix) {
        int n = strlen(s)
        int p = strlen(suffix)
        if (p > n) {
            return false
        }
        if (p == 0) {
            return true
        }
        int start = n - p
        string tail = strsubstr(s, start, p)
        int cmp = strcompare(tail, suffix)
        if (cmp == 0) {
            return true
        }
        return false
    }

    string char_to_string(char c) {
        string result = " "
        strsetchar(result, 0, c)
        return result
    }

    int string_index_of_char(string s, char c) {
        string needle = char_to_string(c)
        int index = strfind(s, needle)
        return index
    }

    bool string_contains_char(string s, char c) {
        int index = string_index_of_char(s, c)
        if (index >= 0) {
            return true
        }
        return false
    }

    int string_last_index_of_char(string s, char c) {
        int n = strlen(s)
        int i = n - 1
        while (i >= 0) {
            char current = strcharat(s, i)
            if (current == c) {
                return i
            }
            i = i - 1
        }
        return -1
    }

    int string_count_char(string s, char c) {
        int n = strlen(s)
        int count = 0
        int i = 0
        while (i < n) {
            char current = strcharat(s, i)
            if (current == c) {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    string string_repeat(string s, int count) {
        if (count <= 0) {
            return ""
        }
        int n = strlen(s)
        if (n == 0) {
            return ""
        }
        int target = n * count
        string result = strcopy(s)
        while (strlen(result) < target) {
            int remaining = target - strlen(result)
            string piece = result
            if (strlen(piece) > remaining) {
                piece = strsubstr(piece, 0, remaining)
            }
            result = strconcat(result, piece)
        }
        if (strlen(result) > target) {
            result = strsubstr(result, 0, target)
        }
        return result
    }

    string string_reverse(string s) {
        int n = strlen(s)
        string result = strcopy(s)
        int half = n / 2
        int i = 0
        while (i < half) {
            int j = n - 1 - i
            char left = strcharat(result, i)
            char right = strcharat(result, j)
            strsetchar(result, i, right)
            strsetchar(result, j, left)
            i = i + 1
        }
        return result
    }

    string string_pad_left(string s, int width, char padding) {
        int n = strlen(s)
        if (n >= width) {
            return strcopy(s)
        }
        int pad_count = width - n
        string one = char_to_string(padding)
        string pad = string_repeat(one, pad_count)
        string result = strconcat(pad, s)
        return result
    }

    string string_pad_right(string s, int width, char padding) {
        int n = strlen(s)
        if (n >= width) {
            return strcopy(s)
        }
        int pad_count = width - n
        string one = char_to_string(padding)
        string pad = string_repeat(one, pad_count)
        string result = strconcat(s, pad)
        return result
    }

    string string_trim_left(string s) {
        int n = strlen(s)
        int i = 0
        while (i < n) {
            char c = strcharat(s, i)
            bool sp = is_space(c)
            if (!sp) {
                break
            }
            i = i + 1
        }
        if (i == 0) {
            return strcopy(s)
        }
        if (i >= n) {
            return ""
        }
        int count = n - i
        string result = strsubstr(s, i, count)
        return result
    }

    string string_trim_right(string s) {
        int n = strlen(s)
        int end = n
        while (end > 0) {
            int index = end - 1
            char c = strcharat(s, index)
            bool sp = is_space(c)
            if (!sp) {
                break
            }
            end = end - 1
        }
        if (end == n) {
            return strcopy(s)
        }
        if (end <= 0) {
            return ""
        }
        string result = strsubstr(s, 0, end)
        return result
    }

    int string_split_count(string s, string sep) {
        int count = strsplitcount(s, sep)
        return count
    }

    string string_split(string s, string sep, int index) {
        string result = strsplitget(s, sep, index)
        return result
    }

    string string_join(string a, string b, string sep) {
        string left = strconcat(a, sep)
        string result = strconcat(left, b)
        return result
    }

} // namespace sl
