// math.glt
// Gallt Standard Library
// Naming Conventions: snake_case
// All standard library statements are stored in the sl namespace
// All standard libraries except for sl.glt itself, should import sl.glt and addition namespace sl
// Copyright (c) Yimingfeishou

guide "sl.glt"

addition namespace sl {

    const double pi = 3.141592653589793
    const double e = 2.718281828459045
    const double ln2 = 0.6931471805599453
    const double ln10 = 2.302585092994046
    const double sqrt2 = 1.4142135623730951

    luint rand_state = 123456789lu

    double abs(double x) {
        if (x < 0.0) {
            return -x
        }
        return x
    }

    double fabs(double x) {
        return abs(x)
    }

    double trunc(double x) {
        if (x != x) {
            return x
        }
        if (x >= 9223372036854775808.0 || x <= -9223372036854775808.0) {
            return x
        }
        return cast<double>(cast<lint>(x))
    }

    double fmod(double x, double y) {
        if (y == 0.0) {
            return 0.0
        }
        double q = trunc(x / y)
        return x - q * y
    }

    double floor(double x) {
        double t = trunc(x)
        if (t > x) {
            return t - 1.0
        }
        return t
    }

    double ceil(double x) {
        double t = trunc(x)
        if (t < x) {
            return t + 1.0
        }
        return t
    }

    double round(double x) {
        if (x >= 0.0) {
            return floor(x + 0.5)
        } else {
            return ceil(x - 0.5)
        }
    }

    double min(double a, double b) {
        if (a < b) {
            return a
        }
        return b
    }

    double max(double a, double b) {
        if (a > b) {
            return a
        }
        return b
    }

    double clamp(double x, double min_val, double max_val) {
        if (x < min_val) {
            return min_val
        }
        if (x > max_val) {
            return max_val
        }
        return x
    }

    int gcd(int a, int b) {
        lint x = cast<lint>(a)
        lint y = cast<lint>(b)
        if (x < 0l) {
            x = 0l - x
        }
        if (y < 0l) {
            y = 0l - y
        }
        while (y != 0l) {
            lint remainder = x % y
            x = y
            y = remainder
        }
        return cast<int>(x)
    }

    int lcm(int a, int b) {
        if (a == 0 || b == 0) {
            return 0
        }
        int divisor = gcd(a, b)
        if (divisor == 0) {
            return 0
        }
        lint left = cast<lint>(a) / cast<lint>(divisor)
        lint right = cast<lint>(b)
        lint product = left * right
        if (product < 0l) {
            product = 0l - product
        }
        return cast<int>(product)
    }

    void srand(luint seed) {
        rand_state = seed % 2147483647lu
        if (rand_state == 0lu) {
            rand_state = 1lu
        }
    }

    int rand() {
        rand_state = (rand_state * 1103515245lu + 12345lu) % 2147483647lu
        return cast<int>(rand_state)
    }

    int random_int(int min_val, int max_val) {
        if (min_val > max_val) {
            int temp = min_val
            min_val = max_val
            max_val = temp
        }
        int range = max_val - min_val + 1
        if (range <= 0) {
            return min_val
        }
        return min_val + rand() % range
    }

    double random_double() {
        return cast<double>(rand()) / 2147483647.0
    }

    double random_double_range(double min_val, double max_val) {
        return min_val + random_double() * (max_val - min_val)
    }

    bool random_bool() {
        return rand() % 2 == 0
    }

    char random_char() {
        return cast<char>(32 + rand() % 95)
    }

    double sqrt(double x) {
        if (x < 0.0) {
            return 0.0
        }
        if (x == 0.0) {
            return 0.0
        }
        if (x != x) {
            return x
        }
        int k = 0
        while (x >= 4.0 && k < 600) {
            x = x / 4.0
            k = k + 1
        }
        while (x < 1.0 && k > -600) {
            x = x * 4.0
            k = k - 1
        }
        double guess = 1.0
        for (int i = 0; i < 64; i = i + 1) {
            double next = (guess + x / guess) / 2.0
            if (next == guess) {
                break
            }
            guess = next
        }
        double result = guess
        for (int i = 0; i < k; i = i + 1) {
            result = result * 2.0
        }
        for (int i = 0; i < -k; i = i + 1) {
            result = result / 2.0
        }
        return result
    }

    double exp(double x) {
        if (x == 0.0) {
            return 1.0
        }
        if (x != x) {
            return x
        }
        bool negative = false
        if (x < 0.0) {
            negative = true
            x = -x
        }
        if (x > 1024.0) {
            x = 1024.0
        }
        int k = cast<int>(x / ln2 + 0.5)
        double r = (x - cast<double>(k) * 0.69314718036912382) - cast<double>(k) * 0.00000000019082149
        double result = 1.0
        double term = 1.0
        for (int i = 1; i < 40; i = i + 1) {
            term = term * r / cast<double>(i)
            result = result + term
            if (abs(term) < 0.000000000000001) {
                break
            }
        }
        for (int i = 0; i < k; i = i + 1) {
            result = result * 2.0
        }
        for (int i = 0; i < -k; i = i + 1) {
            result = result / 2.0
        }
        if (negative) {
            return 1.0 / result
        }
        return result
    }

    double log(double x) {
        if (x <= 0.0) {
            return 0.0
        }
        if (x != x) {
            return x
        }
        int k = 0
        while (x >= 2.0 && k < 1100) {
            x = x / 2.0
            k = k + 1
        }
        while (x < 1.0 && k > -1100) {
            x = x * 2.0
            k = k - 1
        }
        double y = (x - 1.0) / (x + 1.0)
        double y2 = y * y
        double term = y
        double result = 0.0
        for (int i = 1; i < 200; i = i + 2) {
            result = result + term / cast<double>(i)
            term = term * y2
            if (abs(term) < 0.000000000000001) {
                break
            }
        }
        result = result * 2.0
        return result + (cast<double>(k) * 0.69314718036912382 + cast<double>(k) * 0.00000000019082149)
    }

    double log10(double x) {
        return log(x) / ln10
    }

    double log2(double x) {
        return log(x) / ln2
    }

    double pow(double base, double exponent) {
        if (base == 0.0) {
            if (exponent == 0.0) {
                return 1.0
            }
            if (exponent > 0.0) {
                return 0.0
            }
            return 0.0
        }
        if (base > 0.0) {
            return exp(exponent * log(base))
        }
        lint exp_int = cast<lint>(exponent)
        if (cast<double>(exp_int) != exponent) {
            return 0.0
        }
        double result = 1.0
        double b = base
        lint e = exp_int
        bool negative = false
        if (e < 0) {
            negative = true
            e = -e
        }
        while (e > 0l) {
            if (e % 2l == 1l) {
                result = result * b
            }
            b = b * b
            e = e / 2l
        }
        if (negative) {
            return 1.0 / result
        }
        return result
    }

    double sin(double x) {
        if (x != x) {
            return x
        }
        double q = trunc(x / 6.283185307179586)
        if (q > 1048576.0 || q < -1048576.0) {
            x = x - q * 6.283185307179586
        } else {
            x = (x - q * 6.2831853069365025) - q * 0.00000000024308402026024769
        }
        while (x > pi) {
            x = x - 6.283185307179586
        }
        while (x < -pi) {
            x = x + 6.283185307179586
        }
        double term = x
        double result = x
        double x2 = x * x
        for (int i = 3; i < 100; i = i + 2) {
            term = -term * x2 / (cast<double>(i - 1) * cast<double>(i))
            result = result + term
            if (abs(term) < 0.000000000000001) {
                break
            }
        }
        return result
    }

    double cos(double x) {
        if (x != x) {
            return x
        }
        double q = trunc(x / 6.283185307179586)
        if (q > 1048576.0 || q < -1048576.0) {
            x = x - q * 6.283185307179586
        } else {
            x = (x - q * 6.2831853069365025) - q * 0.00000000024308402026024769
        }
        while (x > pi) {
            x = x - 6.283185307179586
        }
        while (x < -pi) {
            x = x + 6.283185307179586
        }
        double term = 1.0
        double result = 1.0
        double x2 = x * x
        for (int i = 2; i < 100; i = i + 2) {
            term = -term * x2 / (cast<double>(i - 1) * cast<double>(i))
            result = result + term
            if (abs(term) < 0.000000000000001) {
                break
            }
        }
        return result
    }

    double tan(double x) {
        double c = cos(x)
        if (abs(c) < 0.000000000000001) {
            return 0.0
        }
        return sin(x) / c
    }

    double atan(double x) {
        if (x > 1.0) {
            return pi / 2.0 - atan(1.0 / x)
        }
        if (x < -1.0) {
            return -pi / 2.0 - atan(1.0 / x)
        }
        if (x > 0.41421356237309503) {
            return 0.7853981633974483 + atan((x - 1.0) / (x + 1.0))
        }
        if (x < -0.41421356237309503) {
            return -0.7853981633974483 + atan((x + 1.0) / (1.0 - x))
        }
        double term = x
        double result = x
        double x2 = x * x
        for (int i = 3; i < 80; i = i + 2) {
            term = -term * x2
            result = result + term / cast<double>(i)
            if (abs(term) < 0.000000000000001) {
                break
            }
        }
        return result
    }

    double asin(double x) {
        if (x > 1.0 || x < -1.0) {
            return 0.0
        }
        if (x == 1.0) {
            return pi / 2.0
        }
        if (x == -1.0) {
            return -pi / 2.0
        }
        return 2.0 * atan(x / (1.0 + sqrt(1.0 - x * x)))
    }

    double acos(double x) {
        if (x > 1.0 || x < -1.0) {
            return 0.0
        }
        if (x == 1.0) {
            return 0.0
        }
        if (x == -1.0) {
            return pi
        }
        return 2.0 * atan(sqrt(1.0 - x * x) / (1.0 + x))
    }

    double atan2(double y, double x) {
        if (x > 0.0) {
            return atan(y / x)
        } else {
            if (x < 0.0) {
                if (y >= 0.0) {
                    return atan(y / x) + pi
                } else {
                    return atan(y / x) - pi
                }
            } else {
                if (y > 0.0) {
                    return pi / 2.0
                }
                if (y < 0.0) {
                    return -pi / 2.0
                }
                return 0.0
            }
        }
    }

    double sinh(double x) {
        if (x == 0.0) {
            return 0.0
        }
        if (abs(x) < 0.5) {
            double x2 = x * x
            double term = 1.0
            double sum = 1.0
            for (int i = 1; i < 20; i = i + 1) {
                term = term * x2 / (cast<double>(2 * i) * cast<double>(2 * i + 1))
                sum = sum + term
                if (abs(term) < 0.000000000000001) {
                    break
                }
            }
            return x * sum
        }
        return (exp(x) - exp(-x)) / 2.0
    }

    double cosh(double x) {
        return (exp(x) + exp(-x)) / 2.0
    }

    double tanh(double x) {
        if (x > 20.0) {
            return 1.0
        }
        if (x < -20.0) {
            return -1.0
        }
        double s = sinh(x)
        double c = cosh(x)
        if (abs(c) < 0.000000000000001) {
            return 0.0
        }
        return s / c
    }

    generics math_ops_generic<T: int | lint | uint | luint | float | double> {
        T __math_zero() {
            T dummy
            const if (T.is_float == true) {
                dummy = 0.0
            } const else {
                const if (T.is_double == true) {
                    dummy = 0.0
                } const else {
                    dummy = 0
                }
            }
            return dummy
        }

        T abs(T x) {
            T zero = __math_zero()
            if (x < zero) {
                return zero - x
            }
            return x
        }

        T min(T a, T b) {
            if (a < b) {
                return a
            }
            return b
        }

        T max(T a, T b) {
            if (a > b) {
                return a
            }
            return b
        }

        T clamp(T x, T min_val, T max_val) {
            if (x < min_val) {
                return min_val
            }
            if (x > max_val) {
                return max_val
            }
            return x
        }
    }

    generics shuffle_generic<T> {
        void shuffle(T* data, int size) {
            if (data == null) {
                return
            }
            if (size <= 1) {
                return
            }
            for (int i = size - 1; i > 0; i--) {
                int j = rand() % (i + 1)
                T temp = data[i]
                data[i] = data[j]
                data[j] = temp
            }
        }
    }

} // namespace sl
